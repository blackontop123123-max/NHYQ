-- ==================== دوال إرسال الأوامر ====================
local function getGvbnpuRemote()
	local remoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
	if remoteEvents then
		local direct = remoteEvents:FindFirstChild("Gvbnpu")
		if direct then
			return direct
		end
	end

	for _, obj in ipairs(game:GetDescendants()) do
		if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and obj.Name:lower():find("gvbnpu", 1, true) then
			return obj
		end
	end

	return nil
end

local function getHDAdminSignals()
	local hdAdmin = ReplicatedStorage:FindFirstChild("HDAdminHDClient") or ReplicatedStorage:FindFirstChild("Remotes")
	if hdAdmin then
		return hdAdmin:FindFirstChild("Signals") or hdAdmin
	end
	return nil
end

local function fireSingleGvbnpu(msg)
	if msg == "" then return false end
	local gvbnpuRemote = getGvbnpuRemote()
	if not gvbnpuRemote then return false end

	local ok = pcall(function()
		if gvbnpuRemote:IsA("RemoteEvent") then
			gvbnpuRemote:FireServer(msg)
		elseif gvbnpuRemote:IsA("RemoteFunction") then
			gvbnpuRemote:InvokeServer(msg)
		end
	end)
	return ok
end

local function fireGvbnpuChat(cmdText)
	if cmdText == "" then return false end

	-- تقسيم الأوامر الطويلة إلى أجزاء صغيرة وتهدئة الإرسال حتى تظهر بالشات بوضوح
	if #cmdText <= 65 then
		local ok = fireSingleGvbnpu(cmdText)
		task.wait(0.22)
		return ok
	end

	local chunks = {}
	local currentChunk = ""
	for part in string.gmatch(cmdText, "%S+") do
		if currentChunk == "" then
			currentChunk = part
		elseif (#currentChunk + #part + 1) <= 65 then
			currentChunk = currentChunk .. " " .. part
		else
			table.insert(chunks, currentChunk)
			currentChunk = part
		end
	end
	if currentChunk ~= "" then
		table.insert(chunks, currentChunk)
	end

	local anySent = false
	for idx, chunk in ipairs(chunks) do
		if fireSingleGvbnpu(chunk) then
			anySent = true
		end
		if idx < #chunks then
			task.wait(0.24)
		else
			task.wait(0.18)
		end
	end
	return anySent
end

local function fireHDAdminCommand(cmdText)
	if cmdText == "" then return false end
	local signals = getHDAdminSignals()
	if signals then
		local requestCommand = signals:FindFirstChild("RequestCommand")
		if requestCommand then
			local ok = pcall(function()
				if requestCommand:IsA("RemoteFunction") then
					requestCommand:InvokeServer(cmdText)
				elseif requestCommand:IsA("RemoteEvent") then
					requestCommand:FireServer(cmdText)
				end
			end)
			if ok then return true end
		end

		local requestMod = signals:FindFirstChild("RequestCommandModification")
		if requestMod then
			local ok = pcall(function()
				if requestMod:IsA("RemoteFunction") then
					requestMod:InvokeServer(cmdText)
				elseif requestMod:IsA("RemoteEvent") then
					requestMod:FireServer(cmdText)
				end
			end)
			if ok then return true end
		end
	end
	return false
end

local function sendRealChat(cmdText)
	if cmdText == "" then return end

	task.spawn(function()
		fireGvbnpuChat(cmdText)
	end)
	task.spawn(function()
		fireHDAdminCommand(cmdText)
	end)
end

local function sendHidden(cmdText)
	if cmdText == "" then return end

	if fireHDAdminCommand(cmdText) then
		return
	end

	task.spawn(function()
		fireGvbnpuChat(cmdText)
	end)
end

local function executeSingleCommand(cmdText)
	if isChatCopy then
		sendRealChat(cmdText)
	elseif isHiddenCopy then
		sendHidden(cmdText)
	end
end

local function addInputPadding(box, leftPad, rightPad)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, leftPad or 8)
	pad.PaddingRight = UDim.new(0, rightPad or 8)
	pad.Parent = box
end

local function addStroke(instance, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or colorPalette.borderSoft
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0.25
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
	return stroke
end

