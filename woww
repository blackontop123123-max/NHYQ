    local delBtn = Instance.new("TextButton")
    delBtn.Size = UDim2.new(0.2, 0, 1, -6)
    delBtn.Position = UDim2.new(0.78, 0, 0, 3)
    delBtn.BackgroundColor3 = colorPalette.danger
    delBtn.Text = "✕"
    delBtn.TextColor3 = Color3.new(1, 1, 1)
    delBtn.Font = Enum.Font.GothamBold
    delBtn.TextSize = 11
    delBtn.Parent = row
    
