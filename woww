-- ==================== حلقة الإرسال المتقدمة وتحديث الهدف التلقائي ====================
local function getActiveTarget()
    local rawText = targetInput.Text
    if rawText == "" then return "" end
    
    if isWahmi then
        local currentTarget = rawText:match("^%s*(.-)%s*$")
        if currentTarget ~= "" and Players:FindFirstChild(currentTarget) then
            return currentTarget
        end
        
        local waitingText = waitingInput.Text
        if waitingText ~= "" then
            local nextTargets = {}
            for name in string.gmatch(waitingText, "[^,]+") do
                table.insert(nextTargets, name:match("^%s*(.-)%s*$"))
            end
            
            if #nextTargets > 0 then
                local newTarget = table.remove(nextTargets, 1)
                targetInput.Text = newTarget
                waitingInput.Text = table.concat(nextTargets, ",")
                return newTarget
            end
        end
        
        targetInput.Text = ""
        return ""
    elseif isGhamid then
        return rawText
    end
    return rawText
end

local function startCopying()
    local targetName = getActiveTarget()
    if targetName == "" then
        startCopyBtn.Text = "اكتب اسم الهدف أولاً!"
        task.wait(1)
        startCopyBtn.Text = "بدأ النسخ"
        return
    end
    
    isRunning = true
    startCopyBtn.Text = "إيقاف النسخ"
    startCopyBtn.BackgroundColor3 = colorPalette.danger
    
    copyTask = task.spawn(function()
        while isRunning do
            local currentTarget = getActiveTarget()
            if currentTarget == "" then
                task.wait(0.5)
                continue
            end
            
            if sendSingleMode then
                for _, item in ipairs(commandItems) do
                    if not isRunning then break end
                    
                    local count = math.min(tonumber(item.box.Text) or 100, 100)
                    local baseCmd = item.command:match("^%s*(.-)%s*$")
                    
                    local payloadTable = {}
                    if isGhamid and string.find(currentTarget, ",") then
                        local unit = baseCmd .. " " .. currentTarget
                        for i = 1, count do table.insert(payloadTable, unit) end
                    else
                        local unit = baseCmd .. " " .. currentTarget
                        for i = 1, count do table.insert(payloadTable, unit) end
                    end
                    
                    local fullPayload = table.concat(payloadTable, " ")
                    if fullPayload ~= "" then executeSingleCommand(fullPayload) end
                end
            elseif sendAllTogetherMode then
                local maxRepeats = 0
                for _, item in ipairs(commandItems) do
                    local val = math.min(tonumber(item.box.Text) or 100, 100)
                    if val > maxRepeats then maxRepeats = val end
                end
                
                local masterPayloadTable = {}
                
                for cycle = 1, maxRepeats do
                    for _, item in ipairs(commandItems) do
                        local count = math.min(tonumber(item.box.Text) or 100, 100)
                        if cycle <= count then
                            local baseCmd = item.command:match("^%s*(.-)%s*$")
                            if isGhamid and string.find(currentTarget, ",") then
                                table.insert(masterPayloadTable, baseCmd .. " " .. currentTarget)
                            else
                                table.insert(masterPayloadTable, baseCmd .. " " .. currentTarget)
                            end
                        end
                    end
                end
                
                masterPayload = table.concat(masterPayloadTable, " ")
                if masterPayload ~= "" then executeSingleCommand(masterPayload) end
            end
            
            task.wait(0.05)
        end
    end)
end

local function stopCopying()
    isRunning = false
    if copyTask then
        task.cancel(copyTask)
        copyTask = nil
    end
    startCopyBtn.Text = "بدأ النسخ"
    startCopyBtn.BackgroundColor3 = colorPalette.accentDark
end

startCopyBtn.MouseButton1Click:Connect(function()
    if isRunning then
        stopCopying()
        scrollToStartButton()
    else
        startCopying()
        scrollToStartButton()
    end
end)

