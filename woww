local function refreshPlayersList()
	for _, c in ipairs(playersScroll:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local count = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -8, 0, 20)
		btn.Position = UDim2.new(0, 4, 0, count * 22 + 3)
		btn.BackgroundColor3 = (plr == LocalPlayer) and colorPalette.accentDark or colorPalette.surfaceHover
		btn.Text = plr.Name .. (plr == LocalPlayer and " (أنت)" or "")
		btn.TextColor3 = colorPalette.text
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 10
		btn.Parent = playersScroll

		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
		addStroke(btn, colorPalette.borderSoft, 1, 0.55)

		btn.MouseButton1Click:Connect(function()
			if isWahmi then
				if targetInput.Text == "" then
					targetInput.Text = plr.Name
				else
					if waitingInput.Text == "" then
						waitingInput.Text = plr.Name
					else
						waitingInput.Text = waitingInput.Text .. "," .. plr.Name
					end
				end
			elseif isGhamid then
				local shortName = string.sub(plr.Name, 1, 3)
				if targetInput.Text == "" then
					targetInput.Text = shortName
				else
					targetInput.Text = targetInput.Text .. "," .. shortName
				end
			end
		end)
		count = count + 1
	end
	playersScroll.CanvasSize = UDim2.new(0, 0, 0, count * 22 + 6)
end

refreshPlayersList()
