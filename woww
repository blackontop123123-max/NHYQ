-- ==================== دوال إرسال الأوامر ====================
local function sendRealChat(cmdText)
    local hdAdmin = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
    if hdAdmin then
        local signals = hdAdmin:FindFirstChild("Signals")
        if signals then
            local requestCommand = signals:FindFirstChild("RequestCommand")
            if requestCommand then
                pcall(function() requestCommand:InvokeServer(cmdText) end)
            end
        end
    end
end

local function sendHidden(cmdText)
    if cmdText == "" then return end
    
    -- البحث السريع عن ريموت HD Admin وتفيذه فورا بشكل صامت (مخفي)
    local hdClient = ReplicatedStorage:FindFirstChild("HDAdminHDClient") or ReplicatedStorage:FindFirstChild("Remotes")
    if hdClient then
        local signals = hdClient:FindFirstChild("Signals") or hdClient
        local requestSilent = signals and signals:FindFirstChild("RequestCommandSilent")
        if requestSilent then
            task.spawn(function()
                requestSilent:InvokeServer(cmdText)
            end)
            return
        end
    end

    -- طريقة احتياطية سريعة عبر الشات المباشر إذا لم يوجد الريموت المخفي
    task.spawn(function()
        local chatMain = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if chatMain then
            local sayMessage = chatMain:FindFirstChild("SayMessageRequest")
            if sayMessage then
                sayMessage:FireServer(cmdText, "All")
            end
        end
    end)
end

local function executeSingleCommand(cmdText)
    if isChatCopy then
        sendRealChat(cmdText)
    elseif isHiddenCopy then
        sendHidden(cmdText)
    end
end

