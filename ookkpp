local function ResolveExpectedKey()
	if KEY_MODE == "STATIC" then
		return STATIC_KEY
	elseif KEY_MODE == "DAILY" then
		local dateTag = os.date("!%Y%m%d")
		return string.format("%s-%s-%s", DAILY_PREFIX, tostring(dateTag), DAILY_SUFFIX)
	elseif KEY_MODE == "PLAYER" then
		return string.format("%s-%d-%s", PLAYER_PREFIX, _L.UserId, PLAYER_SUFFIX)
	elseif KEY_MODE == "REMOTE" and REMOTE_KEY_URL ~= "" then
		local ok, res = pcall(function()
			return game:HttpGet(REMOTE_KEY_URL, true)
		end)
		if ok and type(res) == "string" then
			local cleaned = string.match(res, "^%s*(.-)%s*$") or ""
			if cleaned ~= "" then
				return cleaned
			end
		end
		return STATIC_KEY
	end
	return STATIC_KEY
end

