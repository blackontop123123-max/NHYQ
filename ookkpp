local function shakeWindow()
	local origin = Main.Position
	for i = 1, 5 do
		local offsetX = (i % 2 == 0 and 7 or -7) * (1 - (i - 1) * 0.15)
		Main.Position = origin + UDim2.fromOffset(offsetX, 0)
		task.wait(0.035)
	end
	Main.Position = origin
end

