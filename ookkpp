local function ShakeScreen()
	local duration = 0.14
	local elapsed = 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if elapsed >= duration then
			ShakeHolder.Position = UDim2.fromOffset(0, 0)
			conn:Disconnect()
		else
			local strength = 3.8 * (1 - (elapsed / duration))
			ShakeHolder.Position = UDim2.fromOffset(
				math.round(math.random(-strength, strength)),
				math.round(math.random(-strength, strength))
			)
		end
	end)
end

local function typeLoaderText(label, fullText, delayPerChar, isDoneFn)
	local chars = {}
	for _, code in utf8.codes(fullText) do
		table.insert(chars, utf8.char(code))
	end
	for i = 1, #chars do
		if isDoneFn() then return end
		label.Text = table.concat(chars, "", 1, i) .. "▌"
		task.wait(delayPerChar)
	end
	if not isDoneFn() then
		label.Text = fullText
	end
end

