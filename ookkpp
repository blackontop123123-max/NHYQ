    local function EnsureAnimPlaying(char, r15Id, r6Id, speedMultiplier, existingTrack)
        if not char then return existingTrack end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return existingTrack end

        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = hum
        end

        local desiredId = (hum.RigType == Enum.HumanoidRigType.R15) and ("rbxassetid://" .. tostring(r15Id)) or ("rbxassetid://" .. tostring(r6Id))

        if existingTrack then
            local ok, playing = pcall(function() return existingTrack.IsPlaying end)
            if ok and playing and existingTrack.Animation and existingTrack.Animation.AnimationId == desiredId then
                return existingTrack
            end
            pcall(function() existingTrack:Stop() end)
        end

        local newTrack = nil
        pcall(function()
            local anim = Instance.new("Animation")
            anim.AnimationId = desiredId
            newTrack = animator:LoadAnimation(anim)
            newTrack.Looped = true
            newTrack:Play(0.1, 1, speedMultiplier or 1.5)
        end)
        return newTrack
    end

