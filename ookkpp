local function loadSavedAutoMap()
	local result = {}
	for k, v in pairs(envRoot.HorizonMonolithSavedAuto) do
		if v == true then
			result[k] = true
		end
	end

	if typeof(isfile) == "function" and typeof(readfile) == "function" then
		local ok, exists = pcall(isfile, CONFIG_FILE_NAME)
		if ok and exists then
			local readOk, raw = pcall(readfile, CONFIG_FILE_NAME)
			if readOk and type(raw) == "string" and raw ~= "" then
				local decOk, decoded = pcall(function()
					return _H:JSONDecode(raw)
