        Size = UDim2.new(0, 106, 0, 26),
        Position = UDim2.new(1, -114, 0, 8),
        BackgroundColor3 = RED_SPECTRUM_THEME.ExecIdle,
        AutoButtonColor = false,
        Text = "EXECUTE",
        Font = Enum.Font.GothamBlack,
        TextSize = 10,
        TextColor3 = RED_SPECTRUM_THEME.TextPrimary,
        ZIndex = 3006
    })
    Corner(execBtn, {CornerRadius = UDim.new(0, 8)})
    local execStroke = Create("UIStroke", execBtn, {
        Color = RED_SPECTRUM_THEME.BorderGlow,
        Thickness = 1.1,
        Transparency = 0.25
    })

    local autoExecBtn = Create("TextButton", btnContainer, {
        Size = UDim2.new(0, 106, 0, 22),
        Position = UDim2.new(1, -114, 0, 38),
        BackgroundColor3 = RED_SPECTRUM_THEME.AutoIdle,
        AutoButtonColor = false,
        Text = "AUTO EXECUTE",
        Font = Enum.Font.GothamBold,
        TextSize = 9,
        TextColor3 = RED_SPECTRUM_THEME.TextSecondary,
        ZIndex = 3006
    })
    Corner(autoExecBtn, {CornerRadius = UDim.new(0, 7)})
    local autoStroke = Create("UIStroke", autoExecBtn, {
        Color = RED_SPECTRUM_THEME.BorderSubtle,
        Thickness = 1,
        Transparency = 0.3
    })

    local autoEnabled = (savedAutoMap[buttonText] == true)
    local pulseToken = 0

    local function pulseExecutionFeedback()
        pulseToken += 1
        local currentToken = pulseToken
        execBtn.Text = "EXECUTED"

        TweenService:Create(btnContainer, TweenInfo.new(0.14), {
            BackgroundColor3 = RED_SPECTRUM_THEME.CardPulse
        }):Play()
        TweenService:Create(rStroke, TweenInfo.new(0.14), {
            Color = RED_SPECTRUM_THEME.WhiteSheen,
            Thickness = 1.75,
            Transparency = 0.1
        }):Play()
        TweenService:Create(iconStroke, TweenInfo.new(0.14), {
            Color = RED_SPECTRUM_THEME.WhiteSheen,
            Thickness = 2
        }):Play()
        TweenService:Create(execBtn, TweenInfo.new(0.14), {
            BackgroundColor3 = RED_SPECTRUM_THEME.ExecFlash,
            TextColor3 = RED_SPECTRUM_THEME.TextPrimary
        }):Play()
        TweenService:Create(execStroke, TweenInfo.new(0.14), {
            Color = RED_SPECTRUM_THEME.WhiteSheen
        }):Play()

        task.delay(0.45, function()
            if currentToken ~= pulseToken then return end
            execBtn.Text = "EXECUTE"
            TweenService:Create(btnContainer, TweenInfo.new(0.22), {
                BackgroundColor3 = RED_SPECTRUM_THEME.CardOff
            }):Play()
            TweenService:Create(rStroke, TweenInfo.new(0.22), {
                Color = RED_SPECTRUM_THEME.BorderSubtle,
                Thickness = 1.15,
                Transparency = 0.22
            }):Play()
            TweenService:Create(iconStroke, TweenInfo.new(0.22), {
                Color = RED_SPECTRUM_THEME.BorderSubtle,
                Thickness = 1.35
            }):Play()
            TweenService:Create(execBtn, TweenInfo.new(0.22), {
                BackgroundColor3 = RED_SPECTRUM_THEME.ExecIdle,
                TextColor3 = RED_SPECTRUM_THEME.TextPrimary
            }):Play()
            TweenService:Create(execStroke, TweenInfo.new(0.22), {
                Color = RED_SPECTRUM_THEME.BorderGlow
            }):Play()
        end)
    end

    local function refreshAutoVisuals()
        TweenService:Create(autoExecBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = autoEnabled and RED_SPECTRUM_THEME.AutoActive or RED_SPECTRUM_THEME.AutoIdle,
            TextColor3 = autoEnabled and RED_SPECTRUM_THEME.Void or RED_SPECTRUM_THEME.TextSecondary
        }):Play()
        TweenService:Create(autoStroke, TweenInfo.new(0.2), {
            Color = autoEnabled and RED_SPECTRUM_THEME.GoldAccent or RED_SPECTRUM_THEME.BorderSubtle
        }):Play()
        autoExecBtn.Text = autoEnabled and "AUTO EXEC: ON" or "AUTO EXECUTE"
    end

    local function runModuleOnce()
        ClickSound:Play()
        task.spawn(function()
            pcall(callback)
        end)
        pulseExecutionFeedback()
    end

    BindClick(execBtn, function()
        runModuleOnce()
    end)

    BindClick(autoExecBtn, function()
        ClickSound:Play()
        autoEnabled = not autoEnabled
        savedAutoMap[buttonText] = autoEnabled and true or nil
        saveAutoMap()
        refreshAutoVisuals()
    end)

    refreshAutoVisuals()

    table.insert(startupAutoRunners, function()
        if savedAutoMap[buttonText] == true then
            autoEnabled = true
            refreshAutoVisuals()
            task.spawn(function()
                pcall(callback)
            end)
        end
    end)
end

