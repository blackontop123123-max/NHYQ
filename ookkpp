function VerifyKey()
	if isVerifying then return end

	local raw = KeyInput.Text
	local entered = string.match(raw, "^%s*(.-)%s*$") or ""

	if entered == "" then
		Status.Text = "! PLEASE ENTER A KEY FIRST"
		Status.TextColor3 = Color3.fromRGB(255, 130, 70)
		tween(KeyStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(255, 130, 70) })
		shakeWindow()
		return
	end

	if entered == EXPECTED_KEY then
		isVerifying = true
		LockIcon.Text = "🔓"
		Status.Text = "✓ ACCESS GRANTED  •  LOADING SCRIPT..."
		Status.TextColor3 = Color3.fromRGB(55, 255, 135)
		StrikeText.Text = "VERIFIED"
		StrikeDot.BackgroundColor3 = Color3.fromRGB(55, 255, 135)
		StrikeStroke.Color = Color3.fromRGB(55, 255, 135)

		tween(KeyStroke, TweenInfo.new(0.22), { Color = Color3.fromRGB(55, 255, 135), Thickness = 2 })
		tween(Verify, TweenInfo.new(0.22), { BackgroundColor3 = Color3.fromRGB(24, 175, 85) })
		tween(ProgressFill, TweenInfo.new(0.35), { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(55, 255, 135) })

		task.wait(0.85)

		local fadeOut = tween(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.fromOffset(570, 360),
			Position = UDim2.fromScale(0.5, 0.46)
		})
		tween(Background, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
		fadeOut.Completed:Wait()

		Background:Destroy()

		WelcomeBanner.Position = UDim2.new(0.5, 0, 0, -90)
		TweenService:Create(
			WelcomeBanner,
			TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ Position = UDim2.new(0.5, 0, 0, 25) }
		):Play()

		LoadMainScript()

		task.wait(5)
		TweenService:Create(
			WelcomeBanner,
			TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
			{ Position = UDim2.new(0.5, 0, 0, -90) }
		):Play()
	else
		failedAttempts += 1
		KeyInput.Text = ""

		local remaining = MAX_ATTEMPTS - failedAttempts
		if remaining > 0 then
			Status.Text = "✕ INVALID KEY  •  REMAINING ATTEMPTS: " .. remaining
			Status.TextColor3 = Color3.fromRGB(255, 65, 85)
			StrikeText.Text = "ATTEMPTS: " .. remaining .. " / " .. MAX_ATTEMPTS

			local failRatio = math.clamp(failedAttempts / MAX_ATTEMPTS, 0.15, 0.9)
			tween(ProgressFill, TweenInfo.new(0.25), { Size = UDim2.new(failRatio, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 55, 75) })
			tween(KeyStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(255, 40, 60) })

			shakeWindow()

			task.delay(0.6, function()
				if not isVerifying and KeyStroke and KeyStroke.Parent then
					tween(KeyStroke, TweenInfo.new(0.25), { Color = Color3.fromRGB(220, 30, 45) })
				end
			end)
		else
			triggerBanSequence()
		end
	end
end

