	fpsElapsed += dt
	fpsFrames += 1
	mainGrad.Rotation = 135 + math.sin(os.clock() * 0.75) * 20

	if fpsElapsed >= 0.45 then
		local currentFps = math.round(fpsFrames / fpsElapsed)
		fpsFrames = 0
		fpsElapsed = 0

		local pingStat = Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
		local ping = pingStat and math.round(pingStat:GetValue()) or 0
		statsLabel.Text = string.format("FPS: %d | PING: %dms", currentFps, ping)
		statsLabel.TextColor3 = (ping > 180 or currentFps < 30) and RED_SPECTRUM_THEME.StatusWarn or RED_SPECTRUM_THEME.StatusOk
	end
end)

