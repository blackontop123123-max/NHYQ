        btn.TextSize = 8
        btn.Parent = tabsScrollFrame
        
        local btnCorner = Instance.new("UICorner", btn)
        btnCorner.CornerRadius = UDim.new(0, 5)
        
        local deleteBtn = Instance.new("TextButton")
        deleteBtn.Size = UDim2.new(0, 16, 0, 16)
        deleteBtn.Position = UDim2.new(1, -18, 0, 6)
        deleteBtn.BackgroundColor3 = colorPalette.accentDark
        deleteBtn.Text = "×"
        deleteBtn.TextColor3 = Color3.new(1, 1, 1)
        deleteBtn.Font = Enum.Font.GothamBold
        deleteBtn.TextSize = 10
        deleteBtn.Parent = btn
        
        local delCorner = Instance.new("UICorner", deleteBtn)
        delCorner.CornerRadius = UDim.new(0, 4)
        
        local idx = i
        deleteBtn.MouseButton1Click:Connect(function()
            table.remove(customTabs, idx)
            refreshTabs()
        end)
        
        btn.MouseButton1Click:Connect(function()
            commandsTextBox.Text = tab.commands
            selectedTabIndex = combinedIndex
        end)
        
        table.insert(tabButtons, btn)
    end
end

-- ==================== التنفيذ بأقصى سرعة ====================
local spamTask = nil

local function startCopy()
    cleanSelectedPlayers()
    
    local targetsList = {}
    for name in pairs(selectedPlayers) do
        table.insert(targetsList, name)
    end
    
    if #targetsList == 0 then
        startCopyBtn.Text = "اختر لاعب أولاً!"
        task.wait(1)
        startCopyBtn.Text = "تفعيل النسخ"
        return
    end
    
    local targetText = ""
    if copyType == "normal" then
        targetText = targetsList[1]
    elseif copyType == "gamed" then
        local parts = {}
        for _, name in ipairs(targetsList) do
            table.insert(parts, name:sub(1, math.min(3, #name)))
        end
        targetText = table.concat(parts, ",")
    end
    
    activePlayerLabel.Text = "الهدف: " .. targetText
    
    local commandLines = {}
    for line in commandsTextBox.Text:gmatch("[^\r\n]+") do
        if line ~= "" then
            table.insert(commandLines, line)
        end
    end
    
    isCopyingActive = true
    startCopyBtn.Text = "إيقاف النسخ"
    startCopyBtn.BackgroundColor3 = colorPalette.danger
    
    spamTask = task.spawn(function()
        while isCopyingActive do
            for _, cmd in ipairs(commandLines) do
                if not isCopyingActive then break end
                local finalCmd = cmd:gsub(" sa", " " .. targetText)
                executeCommand(finalCmd)
                task.wait(0) -- سرعة قصوى بدون أي تأخير
            end
        end
    end)
end

local function stopAll()
    isCopyingActive = false
    if spamTask then
        task.cancel(spamTask)
        spamTask = nil
    end
    
    startCopyBtn.Text = "تفعيل النسخ"
    startCopyBtn.BackgroundColor3 = colorPalette.accentDark
    activePlayerLabel.Text = "اللاعب النشط: متوقف"
end

startCopyBtn.MouseButton1Click:Connect(function()
    if isCopyingActive then
        stopAll()
    else
        startCopy()
    end
end)

stopCopyBtn.MouseButton1Click:Connect(function()
    stopAll()
end)

