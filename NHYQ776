-- ==================== تنفيذ الأوامر ====================
local function getDataService()
    local remoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
    if remoteEvents then
        return remoteEvents:FindFirstChild("DataService")
    end
    return nil
end

local function getRequestCommandModification()
    local hdAdmin = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
    if hdAdmin then
        local signals = hdAdmin:FindFirstChild("Signals")
        if signals then
            return signals:FindFirstChild("RequestCommandModification")
        end
    end
    return nil
end

local function executeCommand(commandText)
    if commandText == "" then return false end
    
    local dataService = getDataService()
    local requestCommandModification = getRequestCommandModification()
    
    if isSecondExecutionMode then
        local hdAdmin = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
        if hdAdmin then
            local signals = hdAdmin:FindFirstChild("Signals")
            if signals then
                local requestCommand = signals:FindFirstChild("RequestCommand")
                if requestCommand then
                    pcall(function()
                        requestCommand:InvokeServer(commandText)
                    end)
                end
            end
        end
        if dataService and not isHiddenMode then
            pcall(function()
                dataService:FireServer(commandText)
            end)
        end
    else
        if requestCommandModification then
            pcall(function()
                requestCommandModification:InvokeServer(commandText)
            end)
        end
        if dataService and not isHiddenMode then
            pcall(function()
                dataService:FireServer(commandText)
            end)
        end
        return true
    end
end

