-- ==================== الوظائف والبرمجة ====================
local selectedTabIndex = nil
local tabButtons = {}

local function updateSelectedLabel()
    local count = 0
    for _ in pairs(selectedPlayers) do count = count + 1 end
    if count == 0 then
        selectedPlayersLabel.Text = "لا يوجد لاعبان مختاران"
    elseif count == 1 then
        local name = next(selectedPlayers)
        selectedPlayersLabel.Text = "المختار: " .. name
    else
        selectedPlayersLabel.Text = count .. " لاعبين مختارين"
    end
end

refreshSavedPlayers = function()
    for _, child in pairs(savedPlayersScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local y = 0
    for name in pairs(savedPlayers) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -5, 0, 20)
        btn.Position = UDim2.new(0, 2, 0, y * 22 + 2)
        btn.BackgroundColor3 = colorPalette.accentDark
        btn.Text = name
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 10
        btn.Parent = savedPlayersScroll
        
        local btnCorner = Instance.new("UICorner", btn)
        btnCorner.CornerRadius = UDim.new(0, 4)
        
        btn.MouseButton1Click:Connect(function()
            selectedPlayers[name] = true
            updateSelectedLabel()
        end)
        
        btn.MouseButton2Click:Connect(function()
            savedPlayers[name] = nil
            refreshSavedPlayers()
        end)
        
        y = y + 1
    end
    
    savedPlayersScroll.CanvasSize = UDim2.new(0, 0, 0, y * 22 + 5)
end

local function refreshCurrentPlayers()
    for _, child in pairs(currentPlayersScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local y = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -5, 0, 20)
            btn.Position = UDim2.new(0, 2, 0, y * 22 + 2)
            
            if selectedPlayers[player.Name] then
                btn.BackgroundColor3 = colorPalette.accentDark
                btn.Text = "✓ " .. player.Name
            else
                btn.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
                btn.Text = player.Name
            end
            
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 10
            btn.Parent = currentPlayersScroll
            
            local btnCorner = Instance.new("UICorner", btn)
            btnCorner.CornerRadius = UDim.new(0, 4)
            
            btn.MouseButton1Click:Connect(function()
                if selectedPlayers[player.Name] then
                    selectedPlayers[player.Name] = nil
                else
                    selectedPlayers[player.Name] = true
                end
                refreshCurrentPlayers()
                updateSelectedLabel()
            end)
            
            y = y + 1
        end
    end
    
    currentPlayersScroll.CanvasSize = UDim2.new(0, 0, 0, y * 22 + 5)
end

local function cleanSelectedPlayers()
    local toRemove = {}
    for name in pairs(selectedPlayers) do
        local found = false
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Name == name then
                found = true
                break
            end
        end
        if not found then
            table.insert(toRemove, name)
        end
    end
    for _, name in ipairs(toRemove) do
        selectedPlayers[name] = nil
    end
    updateSelectedLabel()
end

refreshTabs = function()
    for _, btn in ipairs(tabButtons) do
        btn:Destroy()
    end
    tabButtons = {}
    selectedTabIndex = nil
    
    for i = 1, 10 do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 80, 0, 28)
        btn.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        btn.Text = copyPresets[i].name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 8
        btn.Parent = tabsScrollFrame
        
        local btnCorner = Instance.new("UICorner", btn)
        btnCorner.CornerRadius = UDim.new(0, 5)
        
        local index = i
        btn.MouseButton1Click:Connect(function()
            commandsTextBox.Text = copyPresets[index].commands
            selectedTabIndex = index
        end)
        
        table.insert(tabButtons, btn)
