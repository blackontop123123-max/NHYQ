local function updateCopySettingsUi()
    if copyType == "normal" then
        normalCopyBtn.BackgroundColor3 = colorPalette.accentDark
        normalCopyBtn.TextColor3 = Color3.new(1, 1, 1)
        gamedCopyBtn.BackgroundColor3 = Color3.fromRGB(40, 20, 20)
        gamedCopyBtn.TextColor3 = colorPalette.text
        isGamedMode = false
    elseif copyType == "gamed" then
        gamedCopyBtn.BackgroundColor3 = colorPalette.accentDark
        gamedCopyBtn.TextColor3 = Color3.new(1, 1, 1)
        normalCopyBtn.BackgroundColor3 = Color3.fromRGB(40, 20, 20)
        normalCopyBtn.TextColor3 = colorPalette.text
        isGamedMode = true
    end
    
    hiddenModeBtn.BackgroundColor3 = isHiddenMode and colorPalette.accentDark or Color3.fromRGB(40, 20, 20)
    hiddenModeBtn.Text = isHiddenMode and "الوضع المخفي: مفعل" or "الوضع المخفي: معطل"
    hiddenModeBtn.TextColor3 = isHiddenMode and Color3.new(1, 1, 1) or colorPalette.text
    
    secondExecBtn.BackgroundColor3 = isSecondExecutionMode and colorPalette.accentDark or Color3.fromRGB(40, 20, 20)
    secondExecBtn.Text = isSecondExecutionMode and "التنفيذ الثاني: مفعل" or "التنفيذ الثاني: معطل"
    secondExecBtn.TextColor3 = isSecondExecutionMode and Color3.new(1, 1, 1) or colorPalette.text
    
    infiniteCopyBtn.BackgroundColor3 = isInfiniteCopy and colorPalette.accentDark or Color3.fromRGB(40, 20, 20)
    infiniteCopyBtn.Text = isInfiniteCopy and "النسخ اللانهائي: مفعل" or "النسخ اللانهائي: معطل"
    infiniteCopyBtn.TextColor3 = isInfiniteCopy and Color3.new(1, 1, 1) or colorPalette.text
end

normalCopyBtn.MouseButton1Click:Connect(function() copyType = "normal"; updateCopySettingsUi() end)
gamedCopyBtn.MouseButton1Click:Connect(function() copyType = "gamed"; updateCopySettingsUi() end)
hiddenModeBtn.MouseButton1Click:Connect(function() isHiddenMode = not isHiddenMode; updateCopySettingsUi() end)
secondExecBtn.MouseButton1Click:Connect(function() isSecondExecutionMode = not isSecondExecutionMode; updateCopySettingsUi() end)
infiniteCopyBtn.MouseButton1Click:Connect(function() isInfiniteCopy = not isInfiniteCopy; updateCopySettingsUi() end)

