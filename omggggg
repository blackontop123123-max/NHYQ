-- ==================== نظام الإرسال بأقصى سرعة ممكنة ====================
local isRunning = false
local spamThread = nil

local function startSpamming()
    isRunning = true
    actionButton.Text = "إيقاف الارسال"
    actionButton.BackgroundColor3 = colorPalette.danger
    
    spamThread = task.spawn(function()
        while isRunning do
            local textToSend = commandsTextBox.Text
            
            if textToSend ~= "" then
                local lines = {}
                for line in textToSend:gmatch("[^\r\n]+") do
                    table.insert(lines, line)
                end
                
                -- إرسال الأوامر بتكرارات مكثفة بأقصى سرعة فورية
                for _, cmd in ipairs(lines) do
                    if not isRunning then break end
                    for i = 1, 30 do
                        if not isRunning then break end
                        executeRealChatCommand(cmd)
                    end
                end
            end
            
            task.wait()
        end
    end)
end

local function stopSpamming()
    isRunning = false
    if spamThread then
        task.cancel(spamThread)
        spamThread = nil
    end
    actionButton.Text = "بدء الارسال"
    actionButton.BackgroundColor3 = colorPalette.accentDark
end

actionButton.MouseButton1Click:Connect(function()
    if isRunning then
        stopSpamming()
    else
        startSpamming()
    end
end)

