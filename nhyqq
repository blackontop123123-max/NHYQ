    for name, _ in pairs(v2) do
      if players:FindFirstChild(name) then
        if #name <= 3 then
          return name
        else
          return name:sub(1, 3)
        end
      else
        if v2[name] then
          v2[name] = nil
          showTopNotification("⚠️ خرج المهان: " .. name)
        end
      end
    end
    return nil
  end
end

