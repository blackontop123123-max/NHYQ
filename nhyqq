local function updatePlayersList()
  for _, child in ipairs(playersScrollingFrame:GetChildren()) do
    if child:IsA("TextButton") then
      child:Destroy()
    end
  end

  local count = 0
  for _, p in ipairs(players:GetPlayers()) do
    if p ~= localPlayer then
      local pBtn = Instance.new("TextButton")
      pBtn.Size = UDim2.new(1, -4, 0, 26)
      pBtn.Position = UDim2.new(0, 2, 0, count * 28 + 2)
      pBtn.Font = Enum.Font.Gotham
      pBtn.TextSize = 11

      if v2[p.Name] then
        pBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
        pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        pBtn.Text = "✓ " .. p.Name
      else
        pBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        pBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        pBtn.Text = p.Name
      end

      Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 5)
      pBtn.Parent = playersScrollingFrame

      pBtn.MouseButton1Click:Connect(function()
        if v2[p.Name] then
          v2[p.Name] = nil
        else
          v2[p.Name] = true
        end
        updatePlayersList()
      end)

      count = count + 1
    end
  end
  playersScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, count * 28 + 4)
end

