local function sendChatMessage(msg)
  task.spawn(function()
    if textChatService.ChatVersion == Enum.ChatVersion.TextChatService then
      local textChannels = textChatService:FindFirstChild("TextChannels")
      if textChannels then
        local generalChannel = textChannels:FindFirstChild("RBXGeneral")
        if generalChannel then
          generalChannel:SendAsync(msg)
        end
      end
    else
      local sayMessageRequest = replicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") 
        and replicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
      if sayMessageRequest then
        sayMessageRequest:FireServer(msg, "All")
      end
    end

    if localPlayer.Character and localPlayer.Character:FindFirstChild("Head") then
      pcall(function()
        chatService:Chat(localPlayer.Character.Head, msg, Enum.ChatColor.White)
      end)
    end
  end)
end

local function f1(p1)
  return (pcall(function()
    local dataService = replicatedStorage:FindFirstChild("RemoteEvents")
      and replicatedStorage.RemoteEvents:FindFirstChild("DataService")

    if dataService and dataService:IsA("RemoteEvent") then
      dataService:FireServer(unpack({ [1] = p1 }))
    end
  end))
end

local hdAdminHDClient = replicatedStorage:FindFirstChild("HDAdminHDClient")
  or replicatedStorage:FindFirstChild("Remotes")

local requestCommandSilent

if hdAdminHDClient then
  local signals = hdAdminHDClient:FindFirstChild("Signals") or hdAdminHDClient

  if signals then
    requestCommandSilent = signals:FindFirstChild("RequestCommandSilent")
  end
end

local function f2(p2)
  if not requestCommandSilent then
    return false
  end

  return (pcall(function() requestCommandSilent:InvokeServer(p2) end))
end

local function f3(p3)
  sendChatMessage(p3)
  local v1 = f2(p3)

  task.spawn(function()
    f1(p3)
  end)

  return v1
end

