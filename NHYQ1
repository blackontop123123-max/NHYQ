local function LooksLikeKavo(gui)
    if not gui or gui == ScreenGui then
        return false
    end
    if gui.Name == "KavoUI" then
        return true
    end
    local name = string.lower(gui.Name)
    if string.find(name, "kavo") then
        return true
    end
    local foundTitle = false
    pcall(function()
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("TextLabel")
                or obj:IsA("TextButton")
                or obj:IsA("TextBox") then
                local txt = tostring(obj.Text or "")
                if string.find(txt, "سكربت كلان NHYQ")
                    or string.find(string.lower(txt), "kavo") then
                    foundTitle = true
                    break
                end
            end
        end
    end)
    return foundTitle
end

local function FindKavoGui()
    for _, gui in ipairs(KavoCreatedGuis) do
        if gui and gui.Parent then
            return gui
        end
    end
    for _, gui in ipairs(CoreGui:GetChildren()) do
        if gui:IsA("ScreenGui") and LooksLikeKavo(gui) then
            return gui
        end
    end
    local PlayerGui = Player:FindFirstChildOfClass("PlayerGui")
    if PlayerGui then
        for _, gui in ipairs(PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and LooksLikeKavo(gui) then
                return gui
            end
        end
    end
    return nil
end

local function SetKavoVisibility(state)
    if not KavoGui or not KavoGui.Parent then
        KavoGui = FindKavoGui()
    end
    if not KavoGui then
        return false
    end
    KavoVisible = state
    if KavoGui:IsA("ScreenGui") then
        KavoGui.Enabled = state
        return true
    elseif KavoGui:IsA("GuiObject") then
        KavoGui.Visible = state
        return true
    end
    return false
end

ToggleBtn.Activated:Connect(function()
    if moved then
        moved = false
        return
    end
    if not KavoGui or not KavoGui.Parent then
        KavoGui = FindKavoGui()
    end
    if not KavoGui then
        return
    end
    SetKavoVisibility(not KavoVisible)
end)

local function MakeKavoDraggable(gui)
    if not gui then
        return
    end
    local MainFrame = nil
    local largestArea = 0
    pcall(function()
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("Frame") and obj.Visible then
                local size = obj.AbsoluteSize
                local area = size.X * size.Y
                if area > largestArea
                    and size.X > 200
                    and size.Y > 100 then
                    largestArea = area
                    MainFrame = obj
                end
            end
        end
    end)
    if not MainFrame then
        return
    end
    if MainFrame:GetAttribute("NHYQ_Draggable") then
        return
    end
    MainFrame:SetAttribute("NHYQ_Draggable", true)
    local Dragging = false
    local DragStart
    local StartPosition
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = input.Position
            StartPosition = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not Dragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local Delta = input.Position - DragStart
            MainFrame.Position = UDim2.new(
                StartPosition.X.Scale,
                StartPosition.X.Offset + Delta.X,
                StartPosition.Y.Scale,
                StartPosition.Y.Offset + Delta.Y
            )
        end
    end)
end

