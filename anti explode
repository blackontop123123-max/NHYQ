-- نظام حفظ مكان الموت والوقوف لإرجاعك إليه بالظبط عند الريسبون
local deathSpawnCFrame = nil

local function setupCharacter(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    
    if humanoid and hrp then
        -- حفظ آخر مكان يقف فيه اللاعب قبل موته
        humanoid.Died:Connect(function()
            if isEnabled and hrp then
                deathSpawnCFrame = hrp.CFrame
            end
        end)
    end
end

if LocalPlayer.Character then
    setupCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(newChar)
    setupCharacter(newChar)
    if isEnabled and deathSpawnCFrame then
        local hrp = newChar:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            task.wait(0.15)
            hrp.CFrame = deathSpawnCFrame
        end
    end
end)

-- 2. دالة التثبيت التام لكل أجزاء الجسم والرأس (نفس الكود الأصلي تماماً)
local function lockFullBodyPermanently()
    local char = LocalPlayer.Character
    if not char then return end
    
    -- إيقاف أي مفاصل قديمة تسبب التطشير
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Motor6D") then
            v:Destroy()
        end
    end

    -- حفظ المواقع الأصلية لكل أجزاء الجسم لحظة الانفجار
    local partsCFrames = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            partsCFrames[part] = part.CFrame
        end
    end
    
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not isEnabled or not char or not char.Parent then
            if connection then connection:Disconnect() end
            return
        end
        
        -- قفل جميع أجزاء الجسم في مكانها بدقة تامة وبشكل مستمر
        for part, originalCFrame in pairs(partsCFrames) do
            if part and part.Parent then
                part.Anchored = true
                part.CFrame = originalCFrame
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end

        -- إيقاف المراقبة لو مات اللاعب
        if not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
            connection:Disconnect()
        end
    end)
end

-- 3. مراقبة الانفجارات وإلغاؤها (نفس الكود الأصلي تماماً)
local function handleExplosion(descendant)
    if not isEnabled then return end
    if descendant:IsA("Explosion") then
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        
        local hrp = char.HumanoidRootPart
        if (descendant.Position - hrp.Position).Magnitude <= (descendant.BlastRadius + 25) then
            pcall(function()
                descendant.BlastPressure = 0
                descendant.BlastRadius = 0
                descendant.DestroyJointRadiusPercent = 0
            end)

            lockFullBodyPermanently()
        end
        
        task.defer(function()
            descendant:Destroy()
        end)
    end
end

for _, descendant in ipairs(Workspace:GetDescendants()) do
    if descendant:IsA("Explosion") then descendant:Destroy() end
end

Workspace.DescendantAdded:Connect(handleExplosion)
