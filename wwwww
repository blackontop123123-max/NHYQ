local function stopIntroAudio()
	local s = loadSound
	loadSound = nil
	if s then
		local tw = TweenService:Create(s, TweenInfo.new(1), { Volume = 0 })
		tw.Completed:Connect(function() pcall(function() s:Destroy() end) end)
		tw:Play()
	end
end

task.spawn(function()
	local soundIdToPlay = nil

	if INTRO_SOUND_ID and INTRO_SOUND_ID ~= "" then
		soundIdToPlay = INTRO_SOUND_ID
	elseif INTRO_AUDIO_URL and INTRO_AUDIO_URL ~= "" then
