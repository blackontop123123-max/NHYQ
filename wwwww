local function fadeOutIntro()
	local info = TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	for _, o in ipairs(introGui:GetDescendants()) do
		local goal = {}
		if o:IsA("GuiObject") then
			goal.BackgroundTransparency = 1
		end
		if o:IsA("ImageLabel") then
			goal.ImageTransparency = 1
		end
		if o:IsA("TextLabel") or o:IsA("TextButton") then
			goal.TextTransparency = 1
		end
		if o:IsA("UIStroke") then
			goal.Transparency = 1
		end
		if next(goal) then
			TweenService:Create(o, info, goal):Play()
		end
	end
	task.delay(1.6, function()
		if introGui and introGui.Parent then
			introGui:Destroy()
		end
		introFinished = true
	end)
end

