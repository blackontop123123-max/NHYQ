		window.Visible = true
		TweenService:Create(windowScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = currentScale,
		}):Play()
	else
		local tween = TweenService:Create(windowScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Scale = 0.01,
		})
		tween.Completed:Connect(function()
