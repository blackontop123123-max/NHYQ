		elapsed = elapsed + dt
		if elapsed >= duration then
			ShakeHolder.Position = UDim2.new(0, 0, 0, 0)
			connection:Disconnect()
		else
			local offsetX = math.random(-3, 3)
			local offsetY = math.random(-3, 3)
			ShakeHolder.Position = UDim2.new(0, offsetX, 0, offsetY)
		end
	end)
end

