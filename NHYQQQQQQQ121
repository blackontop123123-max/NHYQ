    end
end

local function AddLabel(text, height)
    return Create("TextLabel", {
        Size = UDim2.new(1, -4, 0, height or 38),
        BackgroundColor3 = DARK,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = WHITE,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextWrapped = true
    }, Content)
end

local function AddButton(text, callback)
    local button = Create("TextButton", {
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = DARK,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = WHITE,
        TextSize = 14,
        Font = Enum.Font.GothamSemibold,
        AutoButtonColor = true
    }, Content)

    Corner(button, 7)
    Stroke(button, RED, 1)

    button.MouseButton1Click:Connect(function()
        if callback then
            local success, err = pcall(callback)

            if not success then
                warn("[NHYQ] Button error:", err)
            end
        end
    end)

    return button
end

local function AddTab(name, renderFunction)
    local button = Create("TextButton", {
        Size = UDim2.fromOffset(112, 36),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
        Text = name,
        TextColor3 = WHITE,
        TextSize = 13,
        Font = Enum.Font.GothamBold
    }, TabBar)

    Corner(button, 7)
    Stroke(button, RED, 1)

    Tabs[name] = {
        Button = button,
        Render = renderFunction
    }

    button.MouseButton1Click:Connect(function()
        CurrentTab = name
        ClearContent()

        for tabName, data in pairs(Tabs) do
            data.Button.BackgroundColor3 =
                tabName == name and RED or PANEL
        end

        renderFunction()
        Content.CanvasPosition = Vector2.zero
    end)

    return button
end

