local cardsTable = {}

-- دالة بناء البطاقات للسكربتات
for _, data in ipairs(ScriptsList) do
    local ScriptCard = Create("Frame", ScriptsContainer, {
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundColor3 = Configs_HUB.Cor_Options,
        BackgroundTransparency = 0.2,
        ZIndex = 4
    })
    Corner(ScriptCard, {CornerRadius = UDim.new(0, 8)})
    
    Create("UIStroke", ScriptCard, {
        Color = data.color or Configs_HUB.Cor_Stroke,
        Thickness = 1.5
    })
    
    Create("TextLabel", ScriptCard, {
        Size = UDim2.new(1, -110, 0, 22),
        Position = UDim2.new(0, 10, 0, 5),
        BackgroundTransparency = 1,
        Text = "NHYQ | " .. data.name,
        Font = Configs_HUB.Text_Font,
        TextSize = 12,
        TextColor3 = Configs_HUB.Cor_Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 5
    })
    
    Create("TextLabel", ScriptCard, {
        Size = UDim2.new(1, -110, 0, 20),
        Position = UDim2.new(0, 10, 0, 26),
        BackgroundTransparency = 1,
        Text = data.desc,
        Font = Configs_HUB.Text_Font,
        TextSize = 10,
        TextColor3 = Color3.fromRGB(200, 200, 200),
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 5
    })
    
    local ExecButton = Create("TextButton", ScriptCard, {
        Size = UDim2.new(0, 90, 0, 34),
        Position = UDim2.new(1, -10, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = Color3.fromRGB(40, 40, 40),
        Text = "تشغيل ⚡",
        Font = Configs_HUB.Text_Font,
        TextSize = 11,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        ZIndex = 5,
        Active = true
    })
    Corner(ExecButton, {CornerRadius = UDim.new(0, 6)})
    
    Create("UIStroke", ExecButton, {
        Color = data.color or Configs_HUB.Cor_Stroke,
        Thickness = 1
    })
    
    BindClick(ExecButton, function()
        ClickSound:Play()
        SendNotification("جاري تشغيل: " .. data.name .. " 🚀")
        pcall(function()
            loadstring(data.code)()
        end)
    end)
    
    table.insert(cardsTable, {card = ScriptCard, name = data.name:lower(), desc = data.desc:lower()})
end

-- تفعيل نظام البحث الفوري
SearchBarBox:GetPropertyChangedSignal("Text"):Connect(function()
    (function()
        local query = SearchBarBox.Text:lower()
        for _, item in ipairs(cardsTable) do
            if query == "" or string.find(item.name, query, 1, true) or string.find(item.desc, query, 1, true) then
                item.card.Visible = true
            else
                item.card.Visible = false
            end
        end
    end)()
end)
