-- TAB 1: PLAYER INFORMATION
-- المعلومات تُعرض محلياً داخل القائمة فقط
-- ============================================================

local function RenderInformation()
    AddLabel("PLAYER INFORMATION", 38)

    AddLabel("Username: " .. LocalPlayer.Name)
    AddLabel("Display Name: " .. LocalPlayer.DisplayName)
    AddLabel("User ID: " .. tostring(LocalPlayer.UserId))
    AddLabel("Account Age: " .. tostring(LocalPlayer.AccountAge) .. " days")

    local function UpdateCharacterInfo()
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            AddLabel("Health: " .. math.floor(humanoid.Health) ..
                " / " .. math.floor(humanoid.MaxHealth))
        else
            AddLabel("Health: Character unavailable")
        end
    end

    UpdateCharacterInfo()

    AddButton("Refresh Information", function()
        if CurrentTab == "Information" then
            ClearContent()
            RenderInformation()
        end
    end)

    AddLabel("Webhook: Removed", 32)
    AddLabel("Player data is displayed locally only.", 42)
end

-- ============================================================
-- TAB 2: PLAYERS
-- ============================================================

local function RenderPlayers()
    AddLabel("PLAYERS IN SERVER", 38)

    local function RefreshPlayers()
        if CurrentTab ~= "Players" then
            return
        end

        ClearContent()
        AddLabel("PLAYERS IN SERVER", 38)

        for _, player in ipairs(Players:GetPlayers()) do
            AddLabel(
                player.DisplayName .. "  (@" .. player.Name .. ")",
                38
            )
        end

        AddButton("Refresh Players", RefreshPlayers)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        AddLabel(
            player.DisplayName .. "  (@" .. player.Name .. ")",
            38
        )
    end

    AddButton("Refresh Players", RefreshPlayers)
end

Players.PlayerAdded:Connect(function()
    if CurrentTab == "Players" then
        ClearContent()
        RenderPlayers()
    end
end)

Players.PlayerRemoving:Connect(function()
    if CurrentTab == "Players" then
        ClearContent()
        RenderPlayers()
    end
end)

-- ============================================================
-- TAB 3: BAN SYSTEM
-- محلي داخل الواجهة فقط، ولا يرسل بيانات للخارج
-- ============================================================

local LocalBanList = {}

local function RenderBan()
    AddLabel("BAN MANAGEMENT", 38)
    AddLabel("Local list only — this does not ban players from Roblox.")

    local selectedPlayer = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            AddButton(player.Name .. "  |  Select Player", function()
                selectedPlayer = player
                AddLabel("Selected: " .. player.Name)
            end)
        end
    end

    AddButton("Add Selected Player To Local List", function()
        if not selectedPlayer then
            AddLabel("Select a player first.", 36)
            return
        end

        LocalBanList[selectedPlayer.UserId] = {
            Name = selectedPlayer.Name,
            UserId = selectedPlayer.UserId
        }

        AddLabel("Added locally: " .. selectedPlayer.Name)
    end)

    AddButton("View Local Ban List", function()
        AddLabel("LOCAL BAN LIST", 36)

        local found = false

        for userId, info in pairs(LocalBanList) do
            found = true
            AddLabel(info.Name .. " | ID: " .. tostring(userId))
        end

        if not found then
            AddLabel("The local list is empty.")
        end
    end)

    AddButton("Clear Local Ban List", function()
        table.clear(LocalBanList)
        ClearContent()
        RenderBan()
    end)
end

