-- المتغيرات الأساسية للحماية
local antiREActive = false
local dummyChar = nil
local killBrick = nil
local savedPosition = nil
local savedCameraCFrame = nil
local cameraConnection = nil
local loopLockConnection = nil

-- إخفاء أجزاء الشخصية الحقيقية في الهواء
local function setCharacterTransparency(char, transparency)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Decal") then
            part.Transparency = transparency
        end
    end
end

-- إنشاء المنطقة القاتلة العالية في السماء
local function createKillBrick()
    if killBrick then killBrick:Destroy() end
    killBrick = Instance.new("Part")
    killBrick.Name = "NHYQ_KillZone"
    killBrick.Size = Vector3.new(1500, 15, 1500)
    killBrick.Position = Vector3.new(0, 99995, 0)
    killBrick.Anchored = true
    killBrick.Transparency = 1
    killBrick.CanCollide = true
    killBrick.Parent = workspace

    killBrick.Touched:Connect(function(hit)
        local enemyChar = hit.Parent
        local humanoid = enemyChar:FindFirstChildOfClass("Humanoid")
        local player = Players:GetPlayerFromCharacter(enemyChar)
        if humanoid and player and player ~= localPlayer then
            humanoid.Health = 0
        end
    end)
end

-- إنشاء الشخصية الوهمية الثابتة بالمكان الأصلي
local function spawnDummy(pos)
    if dummyChar and dummyChar.Parent then return end
    
    local realChar = localPlayer.Character
    if realChar then
        realChar.Archivable = true
        dummyChar = realChar:Clone()
        dummyChar.Name = "NHYQ_Dummy"
        
        for _, v in ipairs(dummyChar:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") then
                v:Destroy()
            end
        end
        
        dummyChar.Parent = workspace
        
        local dRoot = dummyChar:FindFirstChild("HumanoidRootPart")
        if dRoot then
            dRoot.CFrame = pos
            dRoot.Anchored = true
        end
    end
end

-- قفل الكاميرا بقوة تامة في مكانها الأصلي
local function startCameraLock()
    if cameraConnection then cameraConnection:Disconnect() end
    camera.CameraType = Enum.CameraType.Scriptable
    
    cameraConnection = RunService.RenderStepped:Connect(function()
        if antiREActive and savedCameraCFrame then
            camera.CameraType = Enum.CameraType.Scriptable
            camera.CFrame = savedCameraCFrame
        end
    end)
end

-- حلقة قوية لمنع الرجوع للبداية وإبقاء الشخصية معلقة في الهواء دائماً حتى بعد الانفجار
local function startAirLockLoop()
    if loopLockConnection then loopLockConnection:Disconnect() end
    
    loopLockConnection = RunService.Stepped:Connect(function()
        if antiREActive and localPlayer.Character then
            local rPart = localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if rPart then
                rPart.CFrame = CFrame.new(0, 99999, 0)
                rPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
    end)
end

-- تطبيق الحماية
local function applyProtection()
    local char = localPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    
    if rootPart then
        if not savedPosition then
            savedPosition = rootPart.CFrame
            savedCameraCFrame = camera.CFrame
            startCameraLock()
        else
            startCameraLock()
        end
        
        createKillBrick()
        spawnDummy(savedPosition)
        startAirLockLoop()
        
        setCharacterTransparency(char, 1)
    end
end

-- زر التشغيل والإيقاف اليدوي
ToggleAntiREBtn.MouseButton1Click:Connect(function()
    antiREActive = not antiREActive
    local char = localPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")

    if antiREActive then
        -- [تفعيل الحماية]
        ToggleAntiREBtn.Text = "Anti-RE: ON"
        ToggleAntiREBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        ToggleAntiREBtn.BackgroundColor3 = Color3.fromRGB(60, 0, 0)

        savedPosition = nil
        savedCameraCFrame = nil
        applyProtection()
    else
        -- [إيقاف الحماية والرجوع للطبيعي]
        ToggleAntiREBtn.Text = "Anti-RE: OFF"
        ToggleAntiREBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        ToggleAntiREBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)

        if loopLockConnection then
            loopLockConnection:Disconnect()
            loopLockConnection = nil
        end

        if cameraConnection then
            cameraConnection:Disconnect()
            cameraConnection = nil
        end
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = char and char:FindFirstChild("Humanoid")

        if killBrick then
            killBrick:Destroy()
            killBrick = nil
        end

        if dummyChar then
            dummyChar:Destroy()
            dummyChar = nil
        end

        -- إرجاع الشخصية الحقيقية لمكان الوهمي عند الإطفاء
        local currentRealChar = localPlayer.Character
        local currentRoot = currentRealChar and currentRealChar:FindFirstChild("HumanoidRootPart")
        if currentRoot and savedPosition then
            setCharacterTransparency(currentRealChar, 0)
            currentRoot.CFrame = savedPosition + Vector3.new(0, 3, 0)
        end
        
        savedPosition = nil
        savedCameraCFrame = nil
    end
end)

-- الاستجابة الفورية للانفجار أو الموت لضمان عدم الذهاب للبداية
local function onCharacterAdded(newChar)
    local humanoid = newChar:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    humanoid.Died:Connect(function()
        if antiREActive then
            task.delay(0.02, function()
                applyProtection()
            end)
        end
    end)
    
    humanoid.HealthChanged:Connect(function(health)
        if antiREActive and health <= 0 then
            task.delay(0.02, function()
                applyProtection()
            end)
        end
    end)
end

if localPlayer.Character then
    onCharacterAdded(localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(onCharacterAdded)
