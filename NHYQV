-- ================= أدوات التخزين =================
local function SaveData(key, value)
    pcall(function()
        if writefile then
            local json = HttpService:JSONEncode(value)
            writefile("VEXHUB_ULTIMATE_" .. LocalPlayer.UserId .. "_" .. key .. ".txt", json)
        end
    end)
end

local function LoadData(key, defaultValue)
    local success, result = pcall(function()
        if isfile and readfile then
            local fileName = "VEXHUB_ULTIMATE_" .. LocalPlayer.UserId .. "_" .. key .. ".txt"
            if isfile(fileName) then
                local data = readfile(fileName)
                if data ~= "" then
                    return HttpService:JSONDecode(data)
                end
            end
        end
        return nil
    end)
    if success and result ~= nil then
        return result
    end
    return defaultValue
end

-- ================= أدوات مساعدة =================
local function PlaySound(id)
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://" .. id
        s.Volume = 0.2
        s.Parent = SoundService
        s:Play()
        s.Ended:Once(function() s:Destroy() end)
    end)
end

local function ExecuteScript(url)
    local success = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    return success
end

local function CreateUICorner(obj, radius)
    local corner = Instance.new("UICorner", obj)
    corner.CornerRadius = UDim.new(0, radius)
    return corner
end

local function CreateUIStroke(obj, color, thickness, transparency)
    local stroke = Instance.new("UIStroke", obj)
    stroke.Color = color
    stroke.Thickness = thickness or 1.5
    stroke.Transparency = transparency or 0
    return stroke
end

local function CreateShadow(obj, size, transparency)
    local shadow = Instance.new("ImageLabel", obj)
    shadow.Size = UDim2.new(1, size*2, 1, size*2)
    shadow.Position = UDim2.new(-size/obj.AbsoluteSize.X, 0, -size/obj.AbsoluteSize.Y, 0)
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://1316045739"
    shadow.ImageColor3 = Colors.Shadow
    shadow.ImageTransparency = transparency or 0.6
    shadow.ZIndex = -1
    return shadow
end

