    label.Size = UDim2.new(0, 80, 0, 18)
    label.Position = UDim2.new(0.5, -40, 1, 6)
    label.BackgroundTransparency = 1
    label.Text = "VEX HUB"
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextColor3 = Color3.fromRGB(200, 30, 30)
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.new(0, 0, 0)

    local isDragging = false
    local dragStartMouse, dragStartPos

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            dragStartMouse = input.Position
            dragStartPos = btn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    isDragging = false
                    SaveData("BPos", btn.Position)
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStartMouse
            btn.Position = UDim2.new(
                dragStartPos.X.Scale,
                dragStartPos.X.Offset + delta.X,
                dragStartPos.Y.Scale,
                dragStartPos.Y.Offset + delta.Y
            )
        end
    end)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {Size = UDim2.new(0, 64, 0, 64)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Thickness = 4, Transparency = 0.05}):Play()
        TweenService:Create(glow, TweenInfo.new(0.2), {ImageTransparency = 0.4}):Play()
        label.TextColor3 = Color3.fromRGB(255, 80, 80)
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {Size = UDim2.new(0, 58, 0, 58)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Thickness = 3, Transparency = 0.2}):Play()
        TweenService:Create(glow, TweenInfo.new(0.2), {ImageTransparency = 0.7}):Play()
        label.TextColor3 = Color3.fromRGB(200, 30, 30)
    end)

    task.spawn(function()
        while btn and btn.Parent do
            local pulse = (math.sin(tick() * 2) + 1) / 2
            stroke.Transparency = 0.1 + pulse * 0.25
            glow.ImageTransparency = 0.5 + pulse * 0.3
            label.TextColor3 = Color3.fromRGB(200, 30, 30):lerp(Color3.fromRGB(255, 100, 100), pulse * 0.5)
            task.wait(0.04)
        end
    end)

    local mainFrame = nil
    local isOpen = false

    btn.MouseButton1Click:Connect(function()
        if isDragging then return end
        PlaySound(12221967)

        if not mainFrame then
            mainFrame = CreateMainUI(btn)
        end

        if isOpen then
            TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                BackgroundTransparency = 1
            }):Play()
            isOpen = false
        else
            mainFrame.Visible = true
            mainFrame.Size = UDim2.new(0, 0, 0, 0)
            mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
            mainFrame.BackgroundTransparency = 1
            TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 440, 0, 540),
                Position = LoadData("Pos", UDim2.new(0.5, -220, 0.5, -260)),
                BackgroundTransparency = 0
            }):Play()
            isOpen = true
        end
    end)

    return btn
end

