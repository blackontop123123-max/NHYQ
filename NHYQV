--              عداد FPS صغير في اليمين
-- =============================================================
local function CreateFPSDisplay()
    -- ننظف أي عدادات قديمة
    for _, child in ipairs(PlayerGui:GetChildren()) do
        if child.Name == "VEX_FPS_COUNTER" then
            child:Destroy()
        end
    end

    local gui = Instance.new("ScreenGui", PlayerGui)
    gui.Name = "VEX_FPS_COUNTER"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 9999

    -- الإطار الصغير
    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(0, 70, 0, 24)
    frame.Position = UDim2.new(1, -80, 0, 8)  -- في الزاوية اليمنى العليا
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.4
    frame.ZIndex = 1
    CreateUICorner(frame, 6)
    CreateUIStroke(frame, Colors.Accent, 1, 0.3)

    -- نص FPS
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "FPS: 0"
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextColor3 = Colors.Accent
    label.TextXAlignment = "Center"
    label.TextYAlignment = "Center"
    label.ZIndex = 2

    -- تحديث FPS كل 0.3 ثانية
    local lastUpdate = 0
    local fps = 0
    local frameCount = 0

    RunService.Heartbeat:Connect(function(deltaTime)
        frameCount = frameCount + 1
        lastUpdate = lastUpdate + deltaTime
        if lastUpdate >= 0.5 then
            fps = math.floor(frameCount / lastUpdate)
            frameCount = 0
            lastUpdate = 0
            label.Text = "FPS: " .. fps
        end
    end)

    -- تأثير نبض بسيط
    task.spawn(function()
        while gui and gui.Parent do
            local pulse = (math.sin(tick() * 2) + 1) / 2
            local trans = 0.25 + pulse * 0.2
            frame.BackgroundTransparency = trans
            label.TextColor3 = Colors.Accent:lerp(Colors.AccentGlow, pulse * 0.3)
            task.wait(0.05)
        end
    end)

    -- جعل الإطار قابلاً للسحب (اختياري)
    local isDragging = false
    local dragStartPos, dragStartMouse

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            dragStartPos = frame.Position
            dragStartMouse = input.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStartMouse
            frame.Position = UDim2.new(
                dragStartPos.X.Scale,
                dragStartPos.X.Offset + delta.X,
                dragStartPos.Y.Scale,
                dragStartPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = false
        end
    end)

    return gui
end

