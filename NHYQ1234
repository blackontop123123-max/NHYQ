local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- إزالة أي واجهة قديمة لنفس السكريبت
if CoreGui:FindFirstChild("NHYQ_NinjaHub") then
    CoreGui.NHYQ_NinjaHub:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "NHYQ_NinjaHub"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

-- 1. زر الفتح والإغلاق العائم (متحرك وقابل للسحب)
local ToggleButton = Instance.new("TextButton")
ToggleButton.Size = UDim2.new(0, 50, 0, 50)
ToggleButton.Position = UDim2.new(0, 20, 0, 100)
ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 10, 10)
ToggleButton.TextColor3 = Color3.fromRGB(255, 80, 80)
ToggleButton.TextSize = 13
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.Text = "NHYQ"
ToggleButton.Active = true
ToggleButton.Draggable = true -- زر قابل للسحب والحركة في أي مكان
ToggleButton.Parent = ScreenGui

local ToggleStroke = Instance.new("UIStroke", ToggleButton)
ToggleStroke.Color = Color3.fromRGB(200, 20, 20)
ToggleStroke.Thickness = 1.5

local ToggleCorner = Instance.new("UICorner", ToggleButton)
ToggleCorner.CornerRadius = UDim.new(1, 0) -- زر دائري شكل أنيق

-- 2. القائمة الرئيسية (تفتح وتغلق عند الضغط على الزر)
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 220, 0, 110)
MainFrame.Position = UDim2.new(0.5, -110, 0.5, -55)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 10, 10)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Visible = false -- تبدأ مخفية
MainFrame.Parent = ScreenGui

local MainStroke = Instance.new("UIStroke", MainFrame)
MainStroke.Color = Color3.fromRGB(200, 20, 20)
MainStroke.Thickness = 2

local MainCorner = Instance.new("UICorner", MainFrame)
MainCorner.CornerRadius = UDim.new(0, 10)

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(35, 12, 12)
Title.TextColor3 = Color3.fromRGB(255, 80, 80)
Title.TextSize = 13
Title.Font = Enum.Font.SourceSansBold
Title.Text = "⚡ NHYQ - Ninja Jitter"
Title.Parent = MainFrame

local TitleCorner = Instance.new("UICorner", Title)
TitleCorner.CornerRadius = UDim.new(0, 10)

local ActionBtn = Instance.new("TextButton")
ActionBtn.Size = UDim2.new(0, 200, 0, 45)
ActionBtn.Position = UDim2.new(0, 10, 0, 45)
ActionBtn.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
ActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ActionBtn.TextSize = 13
ActionBtn.Font = Enum.Font.SourceSansBold
ActionBtn.Text = "Ninja Movement: OFF"
ActionBtn.Parent = MainFrame

local ActionCorner = Instance.new("UICorner", ActionBtn)
ActionCorner.CornerRadius = UDim.new(0, 8)

-- ربط زر الفتح والإغلاق العائم بإظهار وإخفاء القائمة
ToggleButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- 3. منطق الحركة السريعة (Ninja Jitter)
local active = false
local connection

ActionBtn.MouseButton1Click:Connect(function()
    active = not active
    if active then
        ActionBtn.Text = "Ninja Movement: ON"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
        
        connection = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local rootPart = char.HumanoidRootPart
                -- حركات عشوائية سريعة تظهر للجميع
                local offsetX = math.random(-3, 3)
                local offsetY = math.random(-3, 3)
                local offsetZ = math.random(-3, 3)
                
                rootPart.CFrame = rootPart.CFrame + Vector3.new(offsetX, offsetY, offsetZ)
            end
        end)
    else
        ActionBtn.Text = "Ninja Movement: OFF"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        if connection then
            connection:Disconnect()
            connection = nil
        end
    end
end)

print("🔥 NHYQ Draggable Ninja Hub loaded successfully!")
