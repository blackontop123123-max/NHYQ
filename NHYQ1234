local function applyLineMultiplication(targetCount)
  local currentText = InputBox.Text
  if currentText == "" then return end
  
  local lines = {}
  for line in currentText:gmatch("[^\r\n]+") do
    table.insert(lines, line)
  end
  
  if #lines == 0 then return end
  local baseCommand = lines[1]
  
  local repeatedLines = {}
  for i = 1, targetCount do
    table.insert(repeatedLines, baseCommand)
  end
  
  InputBox.Text = table.concat(repeatedLines, "\n")
end

