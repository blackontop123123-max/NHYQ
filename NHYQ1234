local function copyToClipboard(textToCopy)
  pcall(function()
    setclipboard(textToCopy)
  end)
end

StartBtn.MouseButton1Click:Connect(function()
  f9()
  local text = InputBox.Text
  local customPrefix = PrefixBox.Text ~= "" and PrefixBox.Text or "/"
  local targetPlayer = f10()
  
  if targetPlayer == "" then
    TargetStatus.Text = "يرجى تحديد لاعب أولاً!"
    return
  end

  local linesToProcess = {}
  for line in text:gmatch("[^\r\n]+") do
    table.insert(linesToProcess, line)
  end

  local allFormattedLines = {}

  for _, lineText in ipairs(linesToProcess) do
    local formattedCommands = {}
    for word in lineText:gmatch("%S+") do
      if word:lower() == "sa" then
        if #formattedCommands > 0 then
          formattedCommands[#formattedCommands] = formattedCommands[#formattedCommands] .. " " .. targetPlayer
        end
      else
        local cleanCmd = word:gsub("^[%/%!%.#%?]+", "")
        table.insert(formattedCommands, customPrefix .. cleanCmd)
      end
    end
    if #formattedCommands > 0 then
      table.insert(allFormattedLines, table.concat(formattedCommands, " "))
    end
  end

  if #allFormattedLines > 0 then
    local finalString = table.concat(allFormattedLines, "\n")
    copyToClipboard(finalString)
    TargetStatus.Text = "تم النسخ بنجاح ✓"
    task.spawn(function()
      task.wait(1.5)
      TargetStatus.Text = "الحالة: جاهز للنسخ"
    end)
  end
end)

