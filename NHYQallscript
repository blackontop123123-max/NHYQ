local function UpdateSearchFilter()
    local query = SearchBox.Text:lower()
    local targetList = (CurrentActiveTab == "EVENTS") and AllEventScripts or AllEggScripts

    for _, item in ipairs(targetList) do
        local matchSearch = (query == "") or item.Name:find(query) or item.Desc:find(query)
        item.Card.Visible = matchSearch
    end
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(UpdateSearchFilter)
