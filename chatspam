-- ==================== CONFIG & REMOTE ====================
local MIN_DELAY = 0.25
local DEFAULT_DELAY = 0.65
local currentDelay = DEFAULT_DELAY
local sentCount = 0
local isSending = false
local sendThread = nil

local function getGvbnpuRemote()
	local remoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
	if remoteEvents then
		local direct = remoteEvents:FindFirstChild("Gvbnpu")
		if direct then
			return direct
		end
	end

	for _, obj in ipairs(game:GetDescendants()) do
		if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and obj.Name:lower():find("gvbnpu", 1, true) then
			return obj
		end
	end

	return nil
end

local function sanitizeMessage(rawText)
	local cleaned = tostring(rawText or "")
	-- إزالة أي بادئة أوامر (مثل /) لأن الإرسال مخصص لرسالة شات فقط
	cleaned = cleaned:gsub("^%s*/+", "")
	cleaned = cleaned:gsub("%s+/", " ")
	cleaned = cleaned:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
	return cleaned
end

local function sendFullChatMessage(msg)
	if msg == "" then return false end

	-- إرسال الرسالة كاملة سوة بدون تقسيم عبر Gvbnpu
	local gvbnpu = getGvbnpuRemote()
	if gvbnpu then
		local ok = pcall(function()
			if gvbnpu:IsA("RemoteEvent") then
				gvbnpu:FireServer(msg)
			elseif gvbnpu:IsA("RemoteFunction") then
				gvbnpu:InvokeServer(msg)
			end
		end)
		if ok then return true end
	end

	-- دعم احتياطي في حال عدم توفر Gvbnpu باللعبة
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local ok = pcall(function()
			local channels = TextChatService:FindFirstChild("TextChannels")
			local general = channels and (channels:FindFirstChild("RBXGeneral") or channels:GetChildren()[1])
			if general and general:IsA("TextChannel") then
				general:SendAsync(msg)
			end
		end)
		if ok then return true end
	else
		local ok = pcall(function()
			local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			local sayMsg = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
			if sayMsg and sayMsg:IsA("RemoteEvent") then
				sayMsg:FireServer(msg, "All")
			end
		end)
		if ok then return true end
	end

	return false
end

local function parseDelay(rawText)
	local cleaned = tostring(rawText or ""):gsub(",", ".")
	local num = tonumber(cleaned)
	if not num then
		return DEFAULT_DELAY
	end
	if num < MIN_DELAY then
		return MIN_DELAY
	end
	return num
end

