-- ==================== LOGIC ====================
local function updateStatusText()
	local stateText = isSending and "يعمل" or "متوقف"
	statusLbl.Text = string.format("الحالة: %s | السرعة: %.2fs", stateText, currentDelay)
	counterLbl.Text = "المرسل: " .. tostring(sentCount)
end

speedBox.FocusLost:Connect(function()
	currentDelay = parseDelay(speedBox.Text)
	speedBox.Text = tostring(currentDelay)
	updateStatusText()
end)

local function stopAutoChat()
	isSending = false
	if sendThread then
		task.cancel(sendThread)
		sendThread = nil
	end
	startStopBtn.Text = "بدء الإرسال التلقائي"
	startStopBtn.BackgroundColor3 = theme.accentDark
	updateStatusText()
end

local function startAutoChat()
	local cleanMsg = sanitizeMessage(messageBox.Text)
	if cleanMsg == "" then
		statusLbl.Text = "الحالة: اكتب رسالة أولاً!"
		statusLbl.TextColor3 = theme.accent
		return
	end

	currentDelay = parseDelay(speedBox.Text)
	speedBox.Text = tostring(currentDelay)

	isSending = true
	startStopBtn.Text = "إيقاف الإرسال"
	startStopBtn.BackgroundColor3 = theme.danger
	statusLbl.TextColor3 = theme.success
	updateStatusText()

	sendThread = task.spawn(function()
		while isSending and screenGui.Parent do
			local msgToSend = sanitizeMessage(messageBox.Text)
			if msgToSend == "" then
				stopAutoChat()
				break
			end

			-- إرسال الرسالة كاملة سوة بدون تقسيم
			local ok = sendFullChatMessage(msgToSend)
			if ok then
				sentCount += 1
				updateStatusText()
			end

			local waitTime = parseDelay(speedBox.Text)
			currentDelay = waitTime
			task.wait(waitTime)
		end
	end)
end

startStopBtn.MouseButton1Click:Connect(function()
	if isSending then
		stopAutoChat()
	else
		startAutoChat()
	end
end)

