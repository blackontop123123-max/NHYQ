        local query = searchBox.Text:lower()
        for _, elem in ipairs(cardData) do
            elem.card.Visible = (query == "" or elem.name:lower():find(query) ~= nil or elem.desc:lower():find(query) ~= nil)
        end
    end)

    return frame
end

