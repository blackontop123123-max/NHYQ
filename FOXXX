        nameLabel.TextSize = 13
        nameLabel.TextColor3 = Colors.Text
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.BackgroundTransparency = 1

        local execBtn = Instance.new("TextButton", card)
        execBtn.Size = UDim2.new(0, 100, 0, 32)
        execBtn.Position = UDim2.new(1, -112, 0.5, -16)
        execBtn.Text = "▶ EXECUTE"
        execBtn.Font = Enum.Font.GothamBold
        execBtn.TextSize = 11
        execBtn.TextColor3 = Colors.Text
        execBtn.BackgroundColor3 = Colors.Accent2
        CreateUICorner(execBtn, 8)
        execBtn.AutoButtonColor = false

        execBtn.MouseButton1Click:Connect(function()
            PlaySound(12221967)
            execBtn.Text = "⏳"
            local success = ExecuteScript(data[3])
            execBtn.Text = success and "✓ DONE" or "✕ FAIL"
            task.delay(1.5, function() execBtn.Text = "▶ EXECUTE" end)
