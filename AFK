    CoreGui.NHYQ_AFK_Hub:Destroy()
end

-- دالة إرسال أوامر الإدارة للتايتل
local function sendTitleCommand(cmd)
    pcall(function()
        if ReplicatedStorage:FindFirstChild("HDAdminHDClient") then
            ReplicatedStorage.HDAdminHDClient.Signals.RequestCommandModification:InvokeServer(cmd)
        elseif ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("DataService") then
            ReplicatedStorage.RemoteEvents.DataService:FireServer(cmd)
        end
    end)
    pcall(function()
        game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync(cmd)
    end)
end

