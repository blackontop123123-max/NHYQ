-- 3. منطق التشغيل والتحقق الذكي
local active = false
local idledConnection = nil

-- حلقة مراقبة تعمل في الخلفية لإعادة كتابة التايتل فقط إذا كانت الحماية مشغلة
task.spawn(function()
    while true do
        task.wait(3) -- فحص كل 3 ثوانٍ
        if active then
            sendTitleCommand(";title me AFK")
        end
    end
end)

ActionBtn.MouseButton1Click:Connect(function()
    active = not active
    if active then
        ActionBtn.Text = "NHYQ-AFK: ON"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
        
        -- تفعيل التايتل فوراً
        sendTitleCommand(";title me AFK")
        
        -- تفعيل الحماية من الطرد
        idledConnection = LocalPlayer.Idled:Connect(function()
            VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            task.wait(1)
            VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        end)
    else
        ActionBtn.Text = "NHYQ-AFK: OFF"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        
        -- إزالة التايتل تماماً عند إطفاء الحماية ولن يعود تلقائياً
        sendTitleCommand(";notitle me")
        sendTitleCommand(";untitle me")
        
        -- إيقاف الحماية من الطرد
        if idledConnection then
            idledConnection:Disconnect()
            idledConnection = nil
        end
    end
end)

