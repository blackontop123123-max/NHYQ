-- 3. منطق الركض الذي لا يقهر أبداً
local active = false
local idledConnection = nil
local moveConnection = nil
local respawnConnection = nil
local maxDistance = 14

local function getNewTarget(pos)
    local rx = math.random(-maxDistance, maxDistance)
    local rz = math.random(-maxDistance, maxDistance)
    return Vector3.new(pos.X + rx, pos.Y, pos.Z + rz)
end

local function runSystem()
    if not active then return end
    
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid", 10)
    local hrp = character:WaitForChild("HumanoidRootPart", 10)
    
    if humanoid and hrp then
        humanoid.WalkSpeed = 22
        local centerPos = hrp.Position
        local targetPos = getNewTarget(centerPos)
        humanoid:MoveTo(targetPos)
        
        if moveConnection then moveConnection:Disconnect() end
        
        local timer = 0
        moveConnection = RunService.RenderStepped:Connect(function(dt)
            if not active then return end
            
            local curChar = LocalPlayer.Character
            if not curChar or not curChar:FindFirstChild("HumanoidRootPart") then return end
            
            local currentHrp = curChar.HumanoidRootPart
            local currentHum = curChar:FindFirstChildOfClass("Humanoid")
            
            if currentHum and currentHrp then
                timer = timer + dt
                
                -- تحديث دوري للوجهة كل 1.5 ثانية أو إذا وصل للهدف، لضمان استمرار الركض السريع بدون توقف
                local distToTarget = (Vector3.new(currentHrp.Position.X, 0, currentHrp.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
                local distFromCenter = (currentHrp.Position - centerPos).Magnitude
                
                if distFromCenter > (maxDistance + 5) then
                    -- إذا ابتعد كثيرًا أو صار re، نعيد ضبط المركز لمكانه الحالي
                    centerPos = currentHrp.Position
                    targetPos = getNewTarget(centerPos)
                    currentHum:MoveTo(targetPos)
                    timer = 0
                elseif timer >= 1.5 or distToTarget < 3.5 then
                    targetPos = getNewTarget(centerPos)
                    currentHum:MoveTo(targetPos)
                    timer = 0
                end
            end
        end)
    end
end

ActionBtn.MouseButton1Click:Connect(function()
    active = not active
    
    if active then
        ActionBtn.Text = "NHYQ-AFK: ON"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
        
