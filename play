		local baseOrigin = Vector3.new(0, 500, 0)
		local roadWidth = 36
		local roadLength = 320

		local roadPart = Instance.new("Part", world)
		roadPart.Anchored = true
		roadPart.Size = Vector3.new(roadWidth, 2, roadLength)
		roadPart.Position = baseOrigin + Vector3.new(0, -1, -roadLength / 2 + 20)
		roadPart.Color = Color3.fromRGB(32, 32, 38)
		roadPart.Material = Enum.Material.Asphalt

		for side = -1, 1, 2 do
			local curb = Instance.new("Part", world)
			curb.Anchored = true
			curb.Size = Vector3.new(4, 2.6, roadLength)
			curb.Position = baseOrigin + Vector3.new(side * (roadWidth / 2 + 2), -0.7, -roadLength / 2 + 20)
			curb.Color = Color3.fromRGB(70, 70, 78)
			curb.Material = Enum.Material.Concrete
		end

		local stripes = {}
		for i = 1, 18 do
			local s = Instance.new("Part", world)
			s.Anchored = true
			s.Size = Vector3.new(0.6, 0.15, 7)
			s.Color = Color3.fromRGB(240, 240, 240)
			s.Material = Enum.Material.Neon
			s.Position = baseOrigin + Vector3.new(0, 0.05, -i * 18)
			table.insert(stripes, s)
		end

		local motoModel = Instance.new("Model", world)
		motoModel.Name = "PlayerMoto"

		local function MakePart(sz, col, mat)
			local p = Instance.new("Part", motoModel)
			p.Size = sz
			p.Color = col
			p.Material = mat or Enum.Material.SmoothPlastic
			p.Anchored = true
			p.CanCollide = false
			return p
		end

		local chassis = MakePart(Vector3.new(1.6, 1.3, 4.2), ACCENT_RED, Enum.Material.Metal)
		local seat = MakePart(Vector3.new(1.4, 0.5, 1.8), Color3.fromRGB(20, 20, 24))
		local riderTorso = MakePart(Vector3.new(1.5, 2.2, 1.1), Color3.fromRGB(45, 45, 55))
		local riderHead = MakePart(Vector3.new(1.2, 1.2, 1.2), Color3.fromRGB(245, 245, 245))
		local frontWheel = MakePart(Vector3.new(0.7, 1.8, 1.8), Color3.fromRGB(15, 15, 18))
		local rearWheel = MakePart(Vector3.new(0.7, 1.8, 1.8), Color3.fromRGB(15, 15, 18))

		local motoPos = baseOrigin + Vector3.new(0, 1.4, 0)
		local speed = 0
		local maxSpeed = (mode == "MOTO_3D") and 115 or 130
		local steerInput = 0
		local throttleHeld = false
		local brakeHeld = false

		local function MakePad(txt, pos, sz, col)
			local b = Instance.new("TextButton", Body)
			b.Size = sz
			b.Position = pos
			b.BackgroundColor3 = col
			b.BackgroundTransparency = 0.2
			b.Text = txt
			b.TextColor3 = TEXT_WHITE
			b.Font = Enum.Font.GothamBlack
			b.TextSize = 15
			b.ZIndex = 35
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 12)
			local st = Instance.new("UIStroke", b)
			st.Color = TEXT_WHITE
			st.Thickness = 1.5
			st.Transparency = 0.35
			return b
		end

		local LeftPad = MakePad("◀ يسار", UDim2.new(0.03, 0, 1, -78), UDim2.new(0.21, 0, 0, 64), Color3.fromRGB(30, 30, 38))
		local RightPad = MakePad("يمين ▶", UDim2.new(0.26, 0, 1, -78), UDim2.new(0.21, 0, 0, 64), Color3.fromRGB(30, 30, 38))
		local BrakePad = MakePad("بريك ■", UDim2.new(0.54, 0, 1, -78), UDim2.new(0.20, 0, 0, 64), Color3.fromRGB(185, 28, 28))
		local GasPad = MakePad("بانزين ▲", UDim2.new(0.76, 0, 1, -78), UDim2.new(0.21, 0, 0, 64), ACCENT_GREEN)

		LeftPad.MouseButton1Down:Connect(function() steerInput = -1 end)
		LeftPad.MouseButton1Up:Connect(function() if steerInput == -1 then steerInput = 0 end end)
		RightPad.MouseButton1Down:Connect(function() steerInput = 1 end)
		RightPad.MouseButton1Up:Connect(function() if steerInput == 1 then steerInput = 0 end end)

		BrakePad.MouseButton1Down:Connect(function() brakeHeld = true end)
		BrakePad.MouseButton1Up:Connect(function() brakeHeld = false end)
		GasPad.MouseButton1Down:Connect(function() throttleHeld = true end)
		GasPad.MouseButton1Up:Connect(function() throttleHeld = false end)

		local traffic = {}
		local spawnClock = 0

		local function SpawnTrafficEntity()
			local ent = Instance.new("Model", world)
			local laneX = math.random(-14, 14)
			local zPos = motoPos.Z - 210

			if mode == "MOTO_3D" then
				local isCar = math.random() < 0.65
				if isCar then
					local carBody = Instance.new("Part", ent)
					carBody.Anchored = true
					carBody.CanCollide = false
					carBody.Size = Vector3.new(4.6, 3.2, 9.5)
					carBody.Position = Vector3.new(baseOrigin.X + laneX, baseOrigin.Y + 1.6, zPos)
					carBody.Color = Color3.fromRGB(math.random(50, 220), math.random(50, 220), math.random(50, 220))
					carBody.Material = Enum.Material.SmoothPlastic
					table.insert(traffic, {model = ent, pos = carBody.Position, half = Vector3.new(2.3, 1.6, 4.7), speed = math.random(18, 36), vx = 0})
				else
					local ped = Instance.new("Part", ent)
					ped.Anchored = true
					ped.CanCollide = false
					ped.Size = Vector3.new(1.5, 4.2, 1.5)
					ped.Position = Vector3.new(baseOrigin.X + laneX, baseOrigin.Y + 2.1, zPos)
					ped.Color = Color3.fromRGB(250, 204, 21)
					local walkVx = (laneX > 0) and -6 or 6
					table.insert(traffic, {model = ent, pos = ped.Position, half = Vector3.new(0.8, 2.0, 0.8), speed = 10, vx = walkVx})
				end
			else
				local bar = Instance.new("Part", ent)
				bar.Anchored = true
				bar.CanCollide = false
				bar.Size = Vector3.new(8, 3, 2.5)
				bar.Position = Vector3.new(baseOrigin.X + laneX, baseOrigin.Y + 1.5, zPos)
				bar.Color = ACCENT_RED
				bar.Material = Enum.Material.Neon
				table.insert(traffic, {model = ent, pos = bar.Position, half = Vector3.new(4, 1.5, 1.25), speed = 15, vx = 0})
			end
		end

		ActiveConn = RunService.RenderStepped:Connect(function(dt)
			if isPaused or isGameOver then return end

			if throttleHeld then
				speed = math.min(maxSpeed, speed + dt * 85)
			elseif brakeHeld then
				speed = math.max(0, speed - dt * 110)
			else
				speed = math.max(0, speed - dt * 28)
			end

			local turnFactor = (speed > 2) and (steerInput * dt * 24) or 0
			local nextX = math.clamp(motoPos.X + turnFactor, baseOrigin.X - roadWidth / 2 + 1.5, baseOrigin.X + roadWidth / 2 - 1.5)
			local nextZ = motoPos.Z - speed * dt
			motoPos = Vector3.new(nextX, baseOrigin.Y + 1.4, nextZ)

			score = score + (speed * dt * 0.4)
			StatusLbl.Text = string.format("KM/H: %d  |  SCORE: %d", math.floor(speed * 1.8), math.floor(score))

			local tilt = -steerInput * 0.25
			local cf = CFrame.new(motoPos) * CFrame.Angles(0, 0, tilt)

			chassis.CFrame = cf
			seat.CFrame = cf * CFrame.new(0, 0.8, 0.3)
			riderTorso.CFrame = cf * CFrame.new(0, 2.0, 0.2) * CFrame.Angles(0.25, 0, 0)
			riderHead.CFrame = cf * CFrame.new(0, 3.6, -0.1)
			frontWheel.CFrame = cf * CFrame.new(0, -0.5, -1.6) * CFrame.Angles(0, math.pi / 2, 0)
			rearWheel.CFrame = cf * CFrame.new(0, -0.5, 1.6) * CFrame.Angles(0, math.pi / 2, 0)

			roadPart.Position = Vector3.new(baseOrigin.X, baseOrigin.Y - 1, motoPos.Z - roadLength / 2 + 40)
			for idx, s in ipairs(stripes) do
				local sz = motoPos.Z - 20 - (idx * 18)
				s.Position = Vector3.new(baseOrigin.X, baseOrigin.Y + 0.05, sz)
			end

			local camDesired = motoPos + Vector3.new(steerInput * 2.5, 7.5, 14.5)
			local camLookAt = motoPos + Vector3.new(0, 2.2, -18)
			camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camDesired, camLookAt), math.min(1, dt * 10))

			spawnClock = spawnClock + dt
			local spawnInterval = math.max(0.42, 1.05 - (speed / 220))
			if spawnClock >= spawnInterval then
				spawnClock = 0
				SpawnTrafficEntity()
			end

			for i = #traffic, 1, -1 do
				local item = traffic[i]
				local nx = math.clamp(item.pos.X + item.vx * dt, baseOrigin.X - roadWidth / 2 + 1.5, baseOrigin.X + roadWidth / 2 - 1.5)
				local nz = item.pos.Z + item.speed * dt
				item.pos = Vector3.new(nx, item.pos.Y, nz)

				local mainPart = item.model:FindFirstChildWhichIsA("BasePart")
				if mainPart then
