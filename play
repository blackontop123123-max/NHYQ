			info.TextColor3 = TEXT_WHITE
			info.Font = Enum.Font.GothamBold
			info.TextSize = 12
			info.ZIndex = 26

			local rows, cols = 8, 8
			local pieceVal = {K = 100, Q = 9, R = 5, B = 3, N = 3, P = 1}
			local glyph = {
				wK = "♔", wQ = "♕", wR = "♖", wB = "♗", wN = "♘", wP = "♙",
				bK = "♚", bQ = "♛", bR = "♜", bB = "♝", bN = "♞", bP = "♟"
			}

			local board = {}
			for r = 1, rows do
				board[r] = {}
				for c = 1, cols do board[r][c] = "" end
			end

			local backRank = {"R", "N", "B", "Q", "K", "B", "N", "R"}
			for c = 1, cols do
				board[1][c] = "b" .. backRank[c]
				board[2][c] = "bP"
				board[7][c] = "wP"
				board[8][c] = "w" .. backRank[c]
			end

			local selected = nil
			local turn = "w"
			local sqBtns = {}

			local function IsPathClear(b, r1, c1, r2, c2)
				local dr = r2 - r1
				local dc = c2 - c1
				local stepR = (dr == 0) and 0 or (dr > 0 and 1 or -1)
				local stepC = (dc == 0) and 0 or (dc > 0 and 1 or -1)
				local cr, cc = r1 + stepR, c1 + stepC
				while cr ~= r2 or cc ~= c2 do
					if b[cr][cc] ~= "" then return false end
					cr += stepR
					cc += stepC
				end
				return true
			end

			local function IsValidMove(b, r1, c1, r2, c2)
				if r1 == r2 and c1 == c2 then return false end
				local p = b[r1][c1]
				local target = b[r2][c2]
				if p == "" then return false end
				local side = string.sub(p, 1, 1)
				local role = string.sub(p, 2, 2)
				if target ~= "" and string.sub(target, 1, 1) == side then return false end

				local dr = r2 - r1
				local dc = c2 - c1
				local adr = math.abs(dr)
				local adc = math.abs(dc)

				if role == "N" then
					return (adr == 2 and adc == 1) or (adr == 1 and adc == 2)
				elseif role == "K" then
					return adr <= 1 and adc <= 1
				elseif role == "R" then
					return (dr == 0 or dc == 0) and IsPathClear(b, r1, c1, r2, c2)
				elseif role == "B" then
					return (adr == adc) and IsPathClear(b, r1, c1, r2, c2)
				elseif role == "Q" then
					return (dr == 0 or dc == 0 or adr == adc) and IsPathClear(b, r1, c1, r2, c2)
				elseif role == "P" then
					local dir = (side == "w") and -1 or 1
					local startRow = (side == "w") and 7 or 2
					if dc == 0 and dr == dir and target == "" then return true end
					if dc == 0 and r1 == startRow and dr == dir * 2 and target == "" and IsPathClear(b, r1, c1, r2, c2) then
						return true
					end
					if adc == 1 and dr == dir and target ~= "" then return true end
					return false
				end
				return false
			end

			local function RefreshBoard()
				for r = 1, rows do
					for c = 1, cols do
						local p = board[r][c]
						local btn = sqBtns[r][c]
						btn.Text = (p ~= "") and (glyph[p] or "") or ""
						btn.TextColor3 = (string.sub(p, 1, 1) == "w") and TEXT_WHITE or ACCENT_RED
						local isDark = ((r + c) % 2 == 1)
						local isSel = selected and selected.r == r and selected.c == c
						btn.BackgroundColor3 = isSel and ACCENT_AMBER or (isDark and Color3.fromRGB(60, 60, 72) or Color3.fromRGB(28, 28, 34))
					end
				end
			end

			local function CheckKingCapture(b)
				local wKing, bKing = false, false
				for r = 1, rows do
					for c = 1, cols do
						if b[r][c] == "wK" then wKing = true end
						if b[r][c] == "bK" then bKing = true end
					end
				end
				if not bKing then return "w" end
				if not wKing then return "b" end
				return nil
			end

			local function MovePiece(r1, c1, r2, c2)
				local p = board[r1][c1]
				board[r2][c2] = p
				board[r1][c1] = ""
				if p == "wP" and r2 == 1 then board[r2][c2] = "wQ" end
				if p == "bP" and r2 == rows then board[r2][c2] = "bQ" end
				selected = nil
				RefreshBoard()

				local winSide = CheckKingCapture(board)
				if winSide then
					isGameOver = true
					EndTxt.Text = (winSide == "w") and "فزت في الشطرنج!" or "الروبوت فاز في الشطرنج!"
					EndScreen.Visible = true
					return true
				end
				return false
			end

			local function BotChessMove()
				local legal = {}
				for r1 = 1, rows do
					for c1 = 1, cols do
						if string.sub(board[r1][c1], 1, 1) == "b" then
							for r2 = 1, rows do
								for c2 = 1, cols do
									if IsValidMove(board, r1, c1, r2, c2) then
										local cap = board[r2][c2]
										local val = (cap ~= "") and (pieceVal[string.sub(cap, 2, 2)] or 1) or 0
										table.insert(legal, {r1=r1, c1=c1, r2=r2, c2=c2, score=val})
									end
								end
							end
						end
					end
				end
				if #legal == 0 then return end

				if math.random() < BotMistakeChance() then
					local m = legal[math.random(1, #legal)]
					MovePiece(m.r1, m.c1, m.r2, m.c2)
					return
				end

				table.sort(legal, function(a, b) return a.score > b.score end)
				local topPool = (botLevel == "HARD") and 1 or math.min(#legal, 3)
				local chosen = legal[math.random(1, topPool)]
				MovePiece(chosen.r1, chosen.c1, chosen.r2, chosen.c2)
			end

			local cGrid = Instance.new("Frame", Arena)
			cGrid.Size = UDim2.new(0, 224, 0, 224)
			cGrid.Position = UDim2.new(0.5, -112, 0.5, -94)
			cGrid.BackgroundTransparency = 1
			cGrid.ZIndex = 26

			for r = 1, rows do
