local function GetLocalAsset(url, id)
	local fileName = "DevImage_" .. tostring(id) .. ".png"
	local okF, exists = pcall(function() return isfile and isfile(fileName) end)
	if okF and exists then
		local ok, a = pcall(function() return getcustomasset(fileName) end)
		if ok and a then return a end
	end
	local req = request or http_request or (syn and syn.request)
	if not req then return nil end
	local ok, res = pcall(function() return req({Url = url, Method = "GET"}) end)
	if not ok or not res or res.StatusCode ~= 200 then return nil end
	if not pcall(function() writefile(fileName, res.Body) end) then return nil end
	local ok2, a = pcall(function() return getcustomasset(fileName) end)
	return ok2 and a or nil
end

