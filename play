	local isOpen = true

	local function setOpen(state)
		isOpen = state
		toggle.Image = state and TOGGLE_OPEN_ID or TOGGLE_CLOSE_ID
		if state then
			window.Visible = true
			TweenService:Create(windowScale, TweenInfo.new(dur(0.3), Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Scale = userSc,
			}):Play()
		else
			local tw = TweenService:Create(windowScale, TweenInfo.new(dur(0.2), Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Scale = 0.01,
			})
			tw.Completed:Connect(function()
				if not isOpen then
					window.Visible = false
				end
			end)
			tw:Play()
		end
	end

	local toggleMoved = false
	do
		local dragging, dragStart, startPos = false, nil, nil
		toggle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				toggleMoved = false
				dragStart = input.Position
				startPos = toggle.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)
		keep(UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - dragStart
				if d.Magnitude > 6 then
					toggleMoved = true
				end
				if toggleMoved then
					toggle.Position = UDim2.new(
						startPos.X.Scale, startPos.X.Offset + d.X,
						startPos.Y.Scale, startPos.Y.Offset + d.Y
					)
				end
			end
		end))
	end

	toggle.Activated:Connect(function()
		if toggleMoved then
			toggleMoved = false
			return
		end
		setOpen(not isOpen)
	end)
