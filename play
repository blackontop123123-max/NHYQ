			local function CheckWinner(b)
				for _, l in ipairs(lines) do
					if b[l[1]] ~= "" and b[l[1]] == b[l[2]] and b[l[2]] == b[l[3]] then
						return b[l[1]]
					end
				end
				local full = true
				for _, v in ipairs(b) do if v == "" then full = false break end end
				return full and "DRAW" or nil
			end

			local function Minimax(b, depth, isMax)
				local res = CheckWinner(b)
				if res == "O" then return 10 - depth end
				if res == "X" then return depth - 10 end
				if res == "DRAW" then return 0 end

				if isMax then
					local best = -100
					for i = 1, 9 do
						if b[i] == "" then
							b[i] = "O"
							local val = Minimax(b, depth + 1, false)
							b[i] = ""
							if val > best then best = val end
						end
					end
					return best
				else
					local best = 100
					for i = 1, 9 do
						if b[i] == "" then
							b[i] = "X"
							local val = Minimax(b, depth + 1, true)
							b[i] = ""
							if val < best then best = val end
						end
					end
					return best
				end
			end

			local function PickBotMove()
				local empty = {}
				for i, v in ipairs(board) do if v == "" then table.insert(empty, i) end end
				if #empty == 0 then return nil end

				if math.random() < BotMistakeChance() then
					return empty[math.random(1, #empty)]
				end

				local bestScore = -100
				local bestMoves = {}
				for _, idx in ipairs(empty) do
					board[idx] = "O"
					local sc = Minimax(board, 0, false)
					board[idx] = ""
					if sc > bestScore then
						bestScore = sc
						bestMoves = {idx}
					elseif sc == bestScore then
						table.insert(bestMoves, idx)
					end
				end

				if botLevel == "MEDIUM" and #bestMoves > 1 then
					return bestMoves[math.random(1, #bestMoves)]
				end
				return bestMoves[1]
			end

