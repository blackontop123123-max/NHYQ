			if stats.Visible then
				local ping = 0
				pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + .5) end)
				if ping == 0 then pcall(function() ping = math.floor(player:GetNetworkPing() * 1000 + .5) end) end
