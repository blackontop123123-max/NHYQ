			local v = get()
			local f = math.clamp((v - mn) / (mx - mn), 0, 1)
			fill.Size = UDim2.new(f, 0, 1, 0)
			knob.Position = UDim2.new(f, 0, .5, 0)
			vl.Text = tostring(math.floor(v))
