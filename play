local function stopAudio()
	local s = loadSound
	loadSound = nil
	if s then
		local tw = TweenService:Create(s, TweenInfo.new(1), { Volume = 0 })
		tw.Completed:Connect(function() s:Destroy() end)
		tw:Play()
	end
end

