	local BOOST = { on = false, tok = 0, orig = setmetatable({}, { __mode = "k" }), conn = nil, shadows = nil }

	local function boostInst(o)
		if o:IsA("Terrain") then return end
		if o:IsA("BasePart") then
			if not BOOST.orig[o] then BOOST.orig[o] = { m = o.Material, s = o.CastShadow } end
			o.Material = Enum.Material.SmoothPlastic
			o.CastShadow = false
		elseif o:IsA("Decal") or o:IsA("Texture") then
			if not BOOST.orig[o] then BOOST.orig[o] = { t = o.Transparency } end
			o.Transparency = 1
		elseif o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Smoke") or o:IsA("Fire") or o:IsA("Sparkles") then
			if not BOOST.orig[o] then BOOST.orig[o] = { e = o.Enabled } end
			o.Enabled = false
		end
	end

	local function restoreInst(o, d)
		if d.m then
			o.Material = d.m
			o.CastShadow = d.s
		elseif d.t ~= nil then
			o.Transparency = d.t
		elseif d.e ~= nil then
			o.Enabled = d.e
		end
	end

	local function setBoost(on)
		BOOST.tok += 1
		local my = BOOST.tok
		BOOST.on = on
		if on then
			pcall(function()
				BOOST.shadows = Lighting.GlobalShadows
				Lighting.GlobalShadows = false
			end)
			if BOOST.conn then BOOST.conn:Disconnect() end
			BOOST.conn = workspace.DescendantAdded:Connect(function(o)
				if BOOST.on then pcall(boostInst, o) end
			end)
			task.spawn(function()
				local n = 0
				for _, o in ipairs(workspace:GetDescendants()) do
					if my ~= BOOST.tok then return end
					pcall(boostInst, o)
					n += 1
					if n % 400 == 0 then task.wait() end
				end
			end)
		else
			if BOOST.conn then BOOST.conn:Disconnect() BOOST.conn = nil end
			pcall(function()
				if BOOST.shadows ~= nil then Lighting.GlobalShadows = BOOST.shadows end
			end)
			task.spawn(function()
				local n = 0
				for o, d in pairs(BOOST.orig) do
					if my ~= BOOST.tok then return end
					pcall(restoreInst, o, d)
					BOOST.orig[o] = nil
					n += 1
					if n % 400 == 0 then task.wait() end
				end
			end)
		end
	end

