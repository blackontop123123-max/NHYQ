				for i, t in ipairs(botHand) do
					local ok, side = CanPlay(t)
					if ok then table.insert(playableIdx, {idx = i, side = side}) end
				end

				if #playableIdx > 0 then
					local chosen
					if math.random() < BotMistakeChance() then
						chosen = playableIdx[math.random(1, #playableIdx)]
					else
						table.sort(playableIdx, function(a, b)
							local ta, tb = botHand[a.idx], botHand[b.idx]
							return (ta[1] + ta[2]) > (tb[1] + tb[2])
						end)
						chosen = playableIdx[1]
					end
					local played = table.remove(botHand, chosen.idx)
					PlaceTile(played, chosen.side)
				else
					table.insert(botHand, {math.random(0, 6), math.random(0, 6)})
				end

				UpdateInfo()
				RebuildChainUI()
				if #botHand == 0 then
					isGameOver = true
					EndTxt.Text = "الروبوت أنهى قطعه وفاز!"
					EndScreen.Visible = true
				end
			end

			RebuildHandUI = function()
				for _, ch in ipairs(handHolder:GetChildren()) do ch:Destroy() end
				handHolder.CanvasSize = UDim2.new(0, math.max(300, #myHand * 54), 0, 0)
				local layout = Instance.new("UIListLayout", handHolder)
				layout.FillDirection = Enum.FillDirection.Horizontal
				layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
				layout.Padding = UDim.new(0, 6)

				for i, tile in ipairs(myHand) do
					local can = CanPlay(tile)
					local tb = Instance.new("TextButton", handHolder)
					tb.Size = UDim2.new(0, 46, 0, 66)
					tb.BackgroundColor3 = can and Color3.fromRGB(245, 245, 240) or Color3.fromRGB(50, 50, 58)
					tb.Text = tile[1] .. "\n─\n" .. tile[2]
					tb.TextColor3 = can and BG_DARK or TEXT_GRAY
					tb.Font = Enum.Font.GothamBlack
					tb.TextSize = 14
					tb.ZIndex = 27
					Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 6)
					local st = Instance.new("UIStroke", tb)
					st.Color = can and ACCENT_RED or Color3.fromRGB(80, 80, 90)
					st.Thickness = 2

					tb.MouseButton1Click:Connect(function()
						if isPaused or isGameOver then return end
						local ok, side = CanPlay(tile)
						if not ok then return end
						table.remove(myHand, i)
						PlaceTile(tile, side)
						UpdateInfo()
						RebuildChainUI()
						RebuildHandUI()

						if #myHand == 0 then
							isGameOver = true
							EndTxt.Text = "مبروك! فزت في الدومنة!"
							EndScreen.Visible = true
							return
						end

						task.delay(BotThinkDelay(), BotDominoTurn)
					end)
				end
			end

			local DrawBtn = Instance.new("TextButton", Arena)
			DrawBtn.Size = UDim2.new(0, 140, 0, 32)
			DrawBtn.Position = UDim2.new(0.5, -70, 0.52, 0)
			DrawBtn.BackgroundColor3 = ACCENT_RED
			DrawBtn.Text = "سحب قطعة جديدة"
			DrawBtn.TextColor3 = TEXT_WHITE
			DrawBtn.Font = Enum.Font.GothamBold
			DrawBtn.TextSize = 12
			DrawBtn.ZIndex = 27
			Instance.new("UICorner", DrawBtn).CornerRadius = UDim.new(0, 8)
			DrawBtn.MouseButton1Click:Connect(function()
				if isPaused or isGameOver then return end
				table.insert(myHand, {math.random(0, 6), math.random(0, 6)})
				UpdateInfo()
				RebuildHandUI()
			end)

			UpdateInfo()
			RebuildChainUI()
			RebuildHandUI()
		end

		local function BuildUNO()
			ClearArena()
			local currentSub = subCounter
			local colors = {
				{Name = "أحمر", Col = ACCENT_RED},
				{Name = "أخضر", Col = ACCENT_GREEN},
				{Name = "أصفر", Col = ACCENT_AMBER},
				{Name = "أزرق", Col = Color3.fromRGB(59, 130, 246)}
			}

			local function RandCard()
				local c = colors[math.random(1, #colors)]
				local val = (math.random() < 0.25) and "+2" or tostring(math.random(1, 9))
				return {ColorName = c.Name, Color = c.Col, Val = val}
			end

			local topCard = RandCard()
			local playerHand, botHand = {}, {}
			for _ = 1, 5 do
				table.insert(playerHand, RandCard())
				table.insert(botHand, RandCard())
			end

			local status = Instance.new("TextLabel", Arena)
			status.Size = UDim2.new(1, -16, 0, 28)
			status.Position = UDim2.new(0, 8, 0, 6)
			status.BackgroundTransparency = 1
			status.Text = "أوراق الروبوت: 5"
			status.TextColor3 = TEXT_WHITE
			status.Font = Enum.Font.GothamBold
			status.TextSize = 13
			status.ZIndex = 26

			local pileCard = Instance.new("TextButton", Arena)
			pileCard.Size = UDim2.new(0, 74, 0, 96)
			pileCard.Position = UDim2.new(0.5, -37, 0.36, -48)
			pileCard.BackgroundColor3 = topCard.Color
			pileCard.Text = topCard.Val .. "\n" .. topCard.ColorName
			pileCard.TextColor3 = TEXT_WHITE
			pileCard.Font = Enum.Font.GothamBlack
			pileCard.TextSize = 14
			pileCard.ZIndex = 27
			Instance.new("UICorner", pileCard).CornerRadius = UDim.new(0, 10)

			local handFrame = Instance.new("ScrollingFrame", Arena)
			handFrame.Size = UDim2.new(1, -16, 0, 82)
			handFrame.Position = UDim2.new(0, 8, 1, -92)
			handFrame.BackgroundTransparency = 1
			handFrame.ScrollBarThickness = 3
			handFrame.ScrollingDirection = Enum.ScrollingDirection.X
			handFrame.ZIndex = 26

			local function CanMatch(card)
				return card.ColorName == topCard.ColorName or card.Val == topCard.Val
			end

			local RefreshUNO

			local function BotUNOTurn()
				if isGameOver or currentSub ~= subCounter or mySession ~= SessionCounter then return end
				local matches = {}
				for idx, c in ipairs(botHand) do
					if CanMatch(c) then table.insert(matches, idx) end
				end

				if #matches > 0 then
					local pickIdx = (math.random() < BotMistakeChance()) and matches[math.random(1, #matches)] or matches[1]
					topCard = table.remove(botHand, pickIdx)
					if topCard.Val == "+2" then
						table.insert(playerHand, RandCard())
						table.insert(playerHand, RandCard())
					end
				else
					table.insert(botHand, RandCard())
				end

				pileCard.BackgroundColor3 = topCard.Color
				pileCard.Text = topCard.Val .. "\n" .. topCard.ColorName
				status.Text = "أوراق الروبوت: " .. #botHand

				if #botHand == 0 then
					isGameOver = true
					EndTxt.Text = "الروبوت فاز في أونو!"
					EndScreen.Visible = true
				else
					RefreshUNO()
				end
			end

			RefreshUNO = function()
				status.Text = "أوراق الروبوت: " .. #botHand .. " | أوراقك: " .. #playerHand
				for _, ch in ipairs(handFrame:GetChildren()) do ch:Destroy() end
				handFrame.CanvasSize = UDim2.new(0, math.max(300, #playerHand * 60), 0, 0)
				local l = Instance.new("UIListLayout", handFrame)
				l.FillDirection = Enum.FillDirection.Horizontal
				l.HorizontalAlignment = Enum.HorizontalAlignment.Left
				l.Padding = UDim.new(0, 6)

				for i, c in ipairs(playerHand) do
					local cb = Instance.new("TextButton", handFrame)
					cb.Size = UDim2.new(0, 52, 0, 72)
					cb.BackgroundColor3 = c.Color
					cb.Text = c.Val .. "\n" .. c.ColorName
					cb.TextColor3 = TEXT_WHITE
					cb.Font = Enum.Font.GothamBlack
					cb.TextSize = 11
					cb.ZIndex = 27
					Instance.new("UICorner", cb).CornerRadius = UDim.new(0, 8)

					cb.MouseButton1Click:Connect(function()
						if isPaused or isGameOver or not CanMatch(c) then return end
						topCard = table.remove(playerHand, i)
						pileCard.BackgroundColor3 = topCard.Color
						pileCard.Text = topCard.Val .. "\n" .. topCard.ColorName

						if topCard.Val == "+2" then
							table.insert(botHand, RandCard())
							table.insert(botHand, RandCard())
						end

						if #playerHand == 0 then
							isGameOver = true
							EndTxt.Text = "فزت في أونو!"
							EndScreen.Visible = true
							return
						end

						RefreshUNO()
						task.delay(BotThinkDelay(), BotUNOTurn)
					end)
				end
			end

			local DrawUNO = Instance.new("TextButton", Arena)
			DrawUNO.Size = UDim2.new(0, 120, 0, 32)
			DrawUNO.Position = UDim2.new(0.5, -60, 0.64, 0)
			DrawUNO.BackgroundColor3 = BG_DARK
			DrawUNO.Text = "سحب ورقة"
			DrawUNO.TextColor3 = TEXT_WHITE
			DrawUNO.Font = Enum.Font.GothamBold
			DrawUNO.TextSize = 12
			DrawUNO.ZIndex = 27
			Instance.new("UICorner", DrawUNO).CornerRadius = UDim.new(0, 6)
			DrawUNO.MouseButton1Click:Connect(function()
				if isPaused or isGameOver then return end
				table.insert(playerHand, RandCard())
				RefreshUNO()
			end)

			RefreshUNO()
		end

		local function BuildPool()
			ClearArena()
			local currentSub = subCounter
			local myScore, botScore = 0, 0
			local turn = "PLAYER"
			local cuePower = 0.65

			local pLbl = Instance.new("TextLabel", Arena)
			pLbl.Size = UDim2.new(1, -16, 0, 26)
			pLbl.Position = UDim2.new(0, 8, 0, 4)
			pLbl.BackgroundTransparency = 1
			pLbl.Text = "أنت: 0  |  الروبوت: 0  |  دورك"
			pLbl.TextColor3 = TEXT_WHITE
			pLbl.Font = Enum.Font.GothamBold
			pLbl.TextSize = 12
			pLbl.ZIndex = 26

			local tableFrame = Instance.new("Frame", Arena)
			tableFrame.Size = UDim2.new(0.92, 0, 0.58, 0)
			tableFrame.Position = UDim2.new(0.04, 0, 0.14, 0)
			tableFrame.BackgroundColor3 = Color3.fromRGB(21, 94, 52)
			tableFrame.ZIndex = 26
			Instance.new("UICorner", tableFrame).CornerRadius = UDim.new(0, 14)
			local tbStroke = Instance.new("UIStroke", tableFrame)
			tbStroke.Color = Color3.fromRGB(120, 53, 15)
			tbStroke.Thickness = 4

			local pockets = {
				Vector2.new(0.03, 0.08), Vector2.new(0.50, 0.06), Vector2.new(0.97, 0.08),
				Vector2.new(0.03, 0.92), Vector2.new(0.50, 0.94), Vector2.new(0.97, 0.92)
			}
			for _, pk in ipairs(pockets) do
				local hole = Instance.new("Frame", tableFrame)
				hole.Size = UDim2.new(0, 22, 0, 22)
				hole.AnchorPoint = Vector2.new(0.5, 0.5)
				hole.Position = UDim2.new(pk.X, 0, pk.Y, 0)
				hole.BackgroundColor3 = Color3.fromRGB(8, 8, 10)
				hole.ZIndex = 27
				Instance.new("UICorner", hole).CornerRadius = UDim.new(1, 0)
			end

			local cueBall = Instance.new("Frame", tableFrame)
			cueBall.Size = UDim2.new(0, 20, 0, 20)
			cueBall.AnchorPoint = Vector2.new(0.5, 0.5)
			cueBall.Position = UDim2.new(0.24, 0, 0.5, 0)
			cueBall.BackgroundColor3 = TEXT_WHITE
			cueBall.ZIndex = 29
			Instance.new("UICorner", cueBall).CornerRadius = UDim.new(1, 0)

			local ballPos = Vector2.new(0.24, 0.5)
			local ballVel = Vector2.zero

			local targets = {}
			local targetCoords = {
				Vector2.new(0.70, 0.50),
				Vector2.new(0.76, 0.37),
				Vector2.new(0.76, 0.63),
				Vector2.new(0.82, 0.44),
				Vector2.new(0.82, 0.56)
			}
			for i, pos in ipairs(targetCoords) do
				local b = Instance.new("Frame", tableFrame)
				b.Size = UDim2.new(0, 20, 0, 20)
				b.AnchorPoint = Vector2.new(0.5, 0.5)
				b.Position = UDim2.new(pos.X, 0, pos.Y, 0)
				b.BackgroundColor3 = (i % 2 == 1) and ACCENT_RED or ACCENT_AMBER
				b.ZIndex = 28
				Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
				table.insert(targets, {ui = b, pos = pos, active = true})
			end

			local powerBg = Instance.new("Frame", Arena)
			powerBg.Size = UDim2.new(0.42, 0, 0, 26)
			powerBg.Position = UDim2.new(0.05, 0, 1, -36)
			powerBg.BackgroundColor3 = BG_DARK
			powerBg.ZIndex = 28
			Instance.new("UICorner", powerBg).CornerRadius = UDim.new(0, 7)

			local powerFill = Instance.new("Frame", powerBg)
			powerFill.Size = UDim2.new(cuePower, 0, 1, 0)
			powerFill.BackgroundColor3 = ACCENT_AMBER
			powerFill.ZIndex = 29
			Instance.new("UICorner", powerFill).CornerRadius = UDim.new(0, 7)

			local powerBtn = Instance.new("TextButton", powerBg)
			powerBtn.Size = UDim2.new(1, 0, 1, 0)
			powerBtn.BackgroundTransparency = 1
			powerBtn.Text = "قوة: 65%"
			powerBtn.TextColor3 = TEXT_WHITE
			powerBtn.Font = Enum.Font.GothamBlack
			powerBtn.TextSize = 11
			powerBtn.ZIndex = 30
			powerBtn.MouseButton1Click:Connect(function()
				cuePower = cuePower + 0.2
				if cuePower > 1.0 then cuePower = 0.35 end
				powerFill.Size = UDim2.new(cuePower, 0, 1, 0)
				powerBtn.Text = string.format("قوة: %d%%", math.floor(cuePower * 100))
			end)

			local ShootBtn = Instance.new("TextButton", Arena)
			ShootBtn.Size = UDim2.new(0.42, 0, 0, 30)
			ShootBtn.Position = UDim2.new(0.53, 0, 1, -38)
			ShootBtn.BackgroundColor3 = ACCENT_RED
			ShootBtn.Text = "تسديد الكرة"
			ShootBtn.TextColor3 = TEXT_WHITE
			ShootBtn.Font = Enum.Font.GothamBold
			ShootBtn.TextSize = 12
			ShootBtn.ZIndex = 28
			Instance.new("UICorner", ShootBtn).CornerRadius = UDim.new(0, 8)

			local function AimAndShoot(isBot)
				if ballVel.Magnitude > 0.05 or isGameOver then return end
				local aimTarget = Vector2.new(0.78, 0.5)
				for _, t in ipairs(targets) do
					if t.active then aimTarget = t.pos break end
				end
				local dir = (aimTarget - ballPos).Unit
				local spread = isBot and (BotMistakeChance() * 0.4) or 0.06
				local angleOffset = (math.random() - 0.5) * spread
				local cosA, sinA = math.cos(angleOffset), math.sin(angleOffset)
				local rotDir = Vector2.new(dir.X * cosA - dir.Y * sinA, dir.X * sinA + dir.Y * cosA).Unit
				local pwr = isBot and (botLevel == "HARD" and 1.25 or 0.95) or (0.65 + cuePower * 0.75)
				ballVel = rotDir * pwr
			end

			ShootBtn.MouseButton1Click:Connect(function()
				if isPaused or isGameOver or turn ~= "PLAYER" then return end
				AimAndShoot(false)
			end)

			local poolConn
			poolConn = RunService.RenderStepped:Connect(function(dt)
				if not Win or not Win.Parent or currentSub ~= subCounter or mySession ~= SessionCounter then
					if poolConn then poolConn:Disconnect() end
					return
				end
				if isPaused or isGameOver then return end

				if ballVel.Magnitude > 0.01 then
					ballPos = ballPos + ballVel * dt
					ballVel = ballVel * math.max(0, 1 - dt * 1.25)

					if ballPos.X < 0.05 or ballPos.X > 0.95 then
						ballVel = Vector2.new(-ballVel.X, ballVel.Y)
						ballPos = Vector2.new(math.clamp(ballPos.X, 0.05, 0.95), ballPos.Y)
					end
					if ballPos.Y < 0.09 or ballPos.Y > 0.91 then
						ballVel = Vector2.new(ballVel.X, -ballVel.Y)
						ballPos = Vector2.new(ballPos.X, math.clamp(ballPos.Y, 0.09, 0.91))
					end
					cueBall.Position = UDim2.new(ballPos.X, 0, ballPos.Y, 0)

					for _, t in ipairs(targets) do
						if t.active then
							local nearBall = (t.pos - ballPos).Magnitude < 0.075
							local nearPocket = false
							for _, pk in ipairs(pockets) do
								if (t.pos - pk).Magnitude < 0.11 then
									nearPocket = true
									break
								end
							end
							if nearBall or nearPocket then
								t.active = false
								t.ui.Visible = false
								if turn == "PLAYER" then myScore += 1 else botScore += 1 end
								pLbl.Text = "أنت: " .. myScore .. "  |  الروبوت: " .. botScore
							end
						end
					end

					if ballVel.Magnitude <= 0.02 then
						ballVel = Vector2.zero
						if myScore + botScore >= #targets then
							isGameOver = true
							EndTxt.Text = (myScore >= botScore) and "فزت في البليارد!" or "الروبوت فاز في البليارد!"
							EndScreen.Visible = true
						elseif turn == "PLAYER" then
							turn = "BOT"
							pLbl.Text = "أنت: " .. myScore .. "  |  الروبوت: " .. botScore .. "  |  دور الروبوت"
							task.delay(BotThinkDelay(), function()
								if isGameOver or currentSub ~= subCounter or mySession ~= SessionCounter then return end
								AimAndShoot(true)
							end)
						else
							turn = "PLAYER"
							pLbl.Text = "أنت: " .. myScore .. "  |  الروبوت: " .. botScore .. "  |  دورك"
						end
					end
				end
			end)
		end

		local subGames = {
			{Name = "شطرنج", Fn = BuildChess},
			{Name = "دومنة", Fn = BuildDomino},
			{Name = "أونو", Fn = BuildUNO},
			{Name = "بليارد", Fn = BuildPool},
			{Name = "إكس أو", Fn = BuildXO}
		}

		local subBtns = {}
		for i, sg in ipairs(subGames) do
			local sb = Instance.new("TextButton", SubGameScroll)
			sb.Size = UDim2.new(0, 84, 0, 26)
			sb.BackgroundColor3 = BG_DARK
			sb.Text = sg.Name
			sb.TextColor3 = TEXT_WHITE
			sb.Font = Enum.Font.GothamBold
			sb.TextSize = 11
			sb.ZIndex = 26
			Instance.new("UICorner", sb).CornerRadius = UDim.new(0, 6)
			sb.MouseButton1Click:Connect(function()
				for k, b in ipairs(subBtns) do
					b.BackgroundColor3 = (k == i) and ACCENT_RED or BG_DARK
				end
				sg.Fn()
			end)
			table.insert(subBtns, sb)
		end

		subBtns[1].BackgroundColor3 = ACCENT_RED
		BuildChess()
	end
end

ExecuteBtn.MouseButton1Click:Connect(function()
	LaunchMode(SelectedMode)
end)
