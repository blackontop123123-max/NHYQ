					sq.Font = Enum.Font.GothamBold
					sq.TextSize = 17
					sq.ZIndex = 27
					Instance.new("UICorner", sq).CornerRadius = UDim.new(0, 3)

					sq.MouseButton1Click:Connect(function()
						if isPaused or isGameOver or turn ~= "w" then return end
						local cellPiece = board[r][c]
						if not selected then
							if string.sub(cellPiece, 1, 1) == "w" then
								selected = {r = r, c = c}
								RefreshBoard()
							end
						else
							if selected.r == r and selected.c == c then
								selected = nil
								RefreshBoard()
							elseif IsValidMove(board, selected.r, selected.c, r, c) then
								if MovePiece(selected.r, selected.c, r, c) then return end
								turn = "b"
								info.Text = "الروبوت يلعب..."
								task.delay(BotThinkDelay(), function()
									if isGameOver or currentSub ~= subCounter or mySession ~= SessionCounter then return end
									BotChessMove()
									if not isGameOver then
										turn = "w"
										info.Text = "دورك (الأبيض)"
									end
								end)
							elseif string.sub(cellPiece, 1, 1) == "w" then
								selected = {r = r, c = c}
								RefreshBoard()
							end
						end
					end)
					sqBtns[r][c] = sq
				end
			end
			RefreshBoard()
		end

