	local function applyFx()
		pcall(function()
			local mode = S.fxNight and "night" or (S.fxDay and "day" or "none")
			local fogOn = S.fxFog and not fxSuppressed
			local cloudsOn = S.fxClouds and not fxSuppressed
			local shaderOn = S.fxShader and not fxSuppressed
			if mode ~= lastTime then
				lastTime = mode
				if mode == "night" then
					Lighting.ClockTime = 0 Lighting.Brightness = 1
					Lighting.Ambient = Color3.fromRGB(40, 40, 70)
					Lighting.OutdoorAmbient = Color3.fromRGB(40, 40, 70)
				elseif mode == "day" then
					Lighting.ClockTime = 14 Lighting.Brightness = 3
					Lighting.Ambient = ORIG.Ambient Lighting.OutdoorAmbient = ORIG.OutdoorAmbient
				else
					Lighting.ClockTime = ORIG.ClockTime Lighting.Brightness = ORIG.Brightness
					Lighting.Ambient = ORIG.Ambient Lighting.OutdoorAmbient = ORIG.OutdoorAmbient
				end
			end
			if fogOn then
				lastFog = true
				Lighting.FogStart = 0 Lighting.FogEnd = 300 Lighting.FogColor = Color3.fromRGB(190, 200, 210)
			elseif lastFog then
				lastFog = false
				Lighting.FogStart = ORIG.FogStart Lighting.FogEnd = ORIG.FogEnd Lighting.FogColor = ORIG.FogColor
			end
			local terrain = workspace:FindFirstChildOfClass("Terrain")
			if terrain then
				if cloudsOn or shaderOn then
					local c = ensure("Clouds", "YWIF_Clouds", terrain)
					if shaderOn then
						c.Cover = .9 c.Density = .85 c.Color = Color3.fromRGB(235, 225, 255)
					else
						c.Cover = .6 c.Density = .5 c.Color = Color3.new(1, 1, 1)
					end
				else
					local c = terrain:FindFirstChild("YWIF_Clouds")
					if c then c:Destroy() end
				end
			end
			if shaderOn then
				if not Lighting:FindFirstChildOfClass("Atmosphere") then
					local at = ensure("Atmosphere", "YWIF_Atmosphere", Lighting)
					at.Density = .38 at.Offset = .25 at.Glare = .3 at.Haze = 1.6
