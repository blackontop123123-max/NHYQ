	local function applyFilter()
		local f = Lighting:FindFirstChild("YWIF_Filter")
		if FN.filter == 1 then
			if f then f:Destroy() end
			return
		end
		if not f then f = Instance.new("ColorCorrectionEffect") f.Name = "YWIF_Filter" f.Parent = Lighting end
		if FN.filter == 2 then
			f.Brightness = -0.15 f.Contrast = 0.15 f.Saturation = -0.2 f.TintColor = Color3.fromRGB(150, 170, 255)
		elseif FN.filter == 3 then
			f.Brightness = 0 f.Contrast = 0.1 f.Saturation = -0.5 f.TintColor = Color3.fromRGB(255, 225, 175)
		else
			f.Brightness = 0 f.Contrast = 0.15 f.Saturation = -1 f.TintColor = Color3.new(1, 1, 1)
		end
	end

