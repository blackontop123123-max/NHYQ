local function SelectTab(idx)
	local d = TabsData[idx]
	SelectedMode = d.Mode
	InfoTitle.Text = d.Title
	InfoDesc.Text = d.Desc
	for i, b in ipairs(TabBtns) do
		b.BackgroundColor3 = (i == idx) and ACCENT_RED or BG_DARK
		b.TextColor3 = (i == idx) and TEXT_WHITE or TEXT_GRAY
	end
end

