	keep(UserInputService.InputChanged:Connect(function(input, processed)
		if not FC.on or processed then return end
		if input.UserInputType == Enum.UserInputType.Touch
			or (input.UserInputType == Enum.UserInputType.MouseMovement
				and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
			FC.yaw -= input.Delta.X * 0.005
			FC.pitch = math.clamp(FC.pitch - input.Delta.Y * 0.005, -1.5, 1.5)
		end
	end))

	local skyAcc = 0
	keep(RunService.RenderStepped:Connect(function(dt)
		local ch = player.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")

		if root then
			if rainPart then rainPart.CFrame = CFrame.new(root.Position + Vector3.new(0, 30, 0)) end
			local n = #orbs
			if n > 0 then
				local t = os.clock() * OB.speed * 0.3
				local col = fxColor()
				for i = 1, n do
					local a = t + (i / n) * math.pi * 2
					local o = orbs[i]
					o.CFrame = CFrame.new(root.Position + Vector3.new(
						math.cos(a) * OB.radius, math.sin(t * 2 + i) * 0.8, math.sin(a) * OB.radius))
					if OB.mode ~= 4 then o.Color = col end
				end
			end
		end

		if FC.on then
			local cam = workspace.CurrentCamera
			local _, _, h = myParts()
			if cam then
				local rot = CFrame.Angles(0, FC.yaw, 0) * CFrame.Angles(FC.pitch, 0, 0)
				local look, right = rot.LookVector, rot.RightVector
				local flatLook = Vector3.new(look.X, 0, look.Z)
				local flatRight = Vector3.new(right.X, 0, right.Z)
				local md = h and h.MoveDirection or Vector3.zero
				local dir = Vector3.zero
				if md.Magnitude > 0 and flatLook.Magnitude > 0 and flatRight.Magnitude > 0 then
					dir = look * md:Dot(flatLook.Unit) + right * md:Dot(flatRight.Unit)
				end
				local vert = 0
				if FC.up or UserInputService:IsKeyDown(Enum.KeyCode.E) then vert += 1 end
				if FC.down or UserInputService:IsKeyDown(Enum.KeyCode.Q) then vert -= 1 end
				FC.pos += (dir + Vector3.new(0, vert, 0)) * FC.speed * dt
				cam.CameraType = Enum.CameraType.Scriptable
				cam.CFrame = CFrame.new(FC.pos) * rot
			end
		end

		if SK.rainbow and SK.preset > 1 then
			skyAcc += dt
			if skyAcc > 0.1 then
				skyAcc = 0
				local hue = (os.clock() * 0.1) % 1
				Lighting.ColorShift_Top = Color3.fromHSV(hue, 0.8, 1)
				Lighting.ColorShift_Bottom = Color3.fromHSV((hue + 0.15) % 1, 0.8, 1)
				local a = Lighting:FindFirstChildOfClass("Atmosphere")
				if a then a.Color = Color3.fromHSV(hue, 0.5, 1) end
			end
		end
	end))

