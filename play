	local function getAtm()
		local a = Lighting:FindFirstChildOfClass("Atmosphere")
		if not a then
			a = Instance.new("Atmosphere") a.Name = "YWIF_SkyAtm" a.Parent = Lighting ownAtm = true
		end
		return a
