	local autoLow, lowCnt, goodCnt, needGood, autoOrigQL = false, 0, 0, 15, nil
	autoRestore = function()
		if not autoLow then return end
		autoLow = false lowCnt = 0 goodCnt = 0
		fxSuppressed = false
		pcall(function()
			if S.quality >= 1 then applyQuality(S.quality)
			elseif autoOrigQL then settings().Rendering.QualityLevel = autoOrigQL end
		end)
		applyFx()
	end
	task.spawn(function()
		while gui.Parent do
			task.wait(1)
			if not S.autoQ then
				if autoLow then autoRestore() end
			else
				if curFps < S.autoQFps then lowCnt += 1 goodCnt = 0
				elseif curFps >= S.autoQFps + 15 then goodCnt += 1 lowCnt = 0
				else lowCnt = 0 goodCnt = 0 end
				if not autoLow and lowCnt >= 3 then
					autoLow = true
					pcall(function() autoOrigQL = settings().Rendering.QualityLevel end)
					pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
					fxSuppressed = true applyFx()
					needGood = math.min(needGood * 2, 120)
				elseif autoLow and goodCnt >= needGood then
					autoRestore()
				end
			end
		end
	end)

