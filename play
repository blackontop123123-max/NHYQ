	local function applySky()
		if SK.preset == 1 then
			if origSky then
				Lighting.ColorShift_Top = origSky.top
				Lighting.ColorShift_Bottom = origSky.bot
				Lighting.OutdoorAmbient = origSky.out
				origSky = nil
			end
			local a = Lighting:FindFirstChildOfClass("Atmosphere")
			if a then
				if ownAtm then a:Destroy() ownAtm = nil
				elseif origAtm then
					a.Color = origAtm.Color a.Decay = origAtm.Decay a.Haze = origAtm.Haze a.Density = origAtm.Density
				end
			end
			origAtm = nil
			return
		end
		local d = SKY[SK.preset]
		if not origSky then
			origSky = { top = Lighting.ColorShift_Top, bot = Lighting.ColorShift_Bottom, out = Lighting.OutdoorAmbient }
		end
		local a = getAtm()
		if not origAtm and not ownAtm then
			origAtm = { Color = a.Color, Decay = a.Decay, Haze = a.Haze, Density = a.Density }
		end
		Lighting.ColorShift_Top = d.top
		Lighting.ColorShift_Bottom = d.bot
		Lighting.OutdoorAmbient = d.amb
		a.Color = d.atm a.Decay = d.decay a.Haze = 2 a.Density = 0.4
