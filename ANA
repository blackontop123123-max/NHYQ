local function IsBanned(player)
    local name = player.Name:lower()
    local display = player.DisplayName:lower()
    local uid = tostring(player.UserId)
    for _, banned in ipairs(BannedNames) do
        local b = tostring(banned):lower()
        if b ~= "" and (name == b or display == b or uid == b) then
            return true, banned
        end
    end
    return false, nil
end

