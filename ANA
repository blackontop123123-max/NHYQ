local function UpdateUsersInfo()
    local players = Players:GetPlayers()
    local count = #players
    local names = {}
    local devFound = false
    local devNames = {"r3bhtttt", "گلر", "NHYQ"}

    for _, player in ipairs(players) do
        table.insert(names, player.Name)
        for _, dev in ipairs(devNames) do
            if string.lower(player.Name) == string.lower(dev) or string.lower(player.DisplayName) == string.lower(dev) then
                devFound = true
            end
        end
    end

    UsersCountLabel.Text = "👥 عدد المستخدمين: " .. count

    if devFound then
        DevStatusLabel.Text = "👑 المطور: ✅ موجود"
        DevStatusLabel.TextColor3 = Colors.Success
    else
        DevStatusLabel.Text = "👑 المطور: ❌ غير موجود"
        DevStatusLabel.TextColor3 = Colors.Error
    end

    if count > 0 then
        local namesStr = table.concat(names, ", ")
        if #namesStr > 60 then namesStr = string.sub(namesStr, 1, 60) .. "..." end
        UsersListLabel.Text = "👤 المستخدمون: " .. namesStr
    else
        UsersListLabel.Text = "👤 لا يوجد مستخدمون"
    end
end

