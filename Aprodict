local signal = RS:FindFirstChild("HDAdminHDClient") and RS.HDAdminHDClient:FindFirstChild("Signals")
local createLogSignal = signal and signal:FindFirstChild("CreateLog") and signal.CreateLog.OnClientEvent
local executeSignal = signal and signal:FindFirstChild("ExecuteClientCommand") and signal.ExecuteClientCommand.OnClientEvent
local errorSignal = signal and signal:FindFirstChild("Error") and signal.Error.OnClientEvent

local function RemoveWarp()
    local total = 0
    for _, obj in pairs(game:GetDescendants()) do
        local name = obj.Name:lower()
        if name:find("warp") then
            pcall(function() obj:Destroy() total = total + 1 end)
        end
    end
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("WarpEffect") then
            pcall(function() obj:Destroy() total = total + 1 end)
        end
    end
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = obj.Name:lower()
            if name:find("warp") then
                pcall(function() obj:Destroy() total = total + 1 end)
            end
        end
    end
    for _, obj in pairs(LS:GetDescendants()) do
        local name = obj.Name:lower()
        if name:find("warp") then
            pcall(function() obj:Destroy() total = total + 1 end)
        end
    end
    return total
end

local function updateBlock()
    local signals = {createLogSignal, executeSignal, errorSignal}
    for _, sig in ipairs(signals) do
        if sig then
            pcall(function()
                local connections = getconnections(sig)
                for _, conn in ipairs(connections) do
                    if blocked then conn:Disable() else conn:Enable() end
                end
            end)
        end
    end
    if blocked then
        RemoveWarp()
    end
end

