local isBlockerOn = false

task.spawn(function()
    while true do
        if isBlockerOn then
            pcall(function()
                local hdGui = PlayerGui:FindFirstChild("HDAdminInterface")
                if hdGui then
                    for _, noticeContainer in ipairs(hdGui:GetDescendants()) do
                        if noticeContainer.Name == "Notice" or noticeContainer.Name == "Notices" then
                            noticeContainer.Visible = false
                        end
                    end
                end
            end)
        end
        task.wait(0.2)
    end
end)

noticeBtn.MouseButton1Click:Connect(function()
    isBlockerOn = not isBlockerOn

    if isBlockerOn then
        noticeBtn.Text = "◉  NOTICE BLOCKER: ON"
        noticeBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 50)
        noticeStroke.Color = Color3.fromRGB(0, 200, 100)
        noticeGlow.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        noticeBtn.TextColor3 = COLORS.Text
    else
        noticeBtn.Text = "○  NOTICE BLOCKER: OFF"
        noticeBtn.BackgroundColor3 = COLORS.DarkerBg
        noticeStroke.Color = COLORS.TextDim
        noticeGlow.BackgroundColor3 = COLORS.TextDim
        noticeBtn.TextColor3 = COLORS.Text

        pcall(function()
            local hdGui = PlayerGui:FindFirstChild("HDAdminInterface")
            if hdGui then
                for _, noticeContainer in ipairs(hdGui:GetDescendants()) do
                    if noticeContainer.Name == "Notice" or noticeContainer.Name == "Notices" then
                        noticeContainer.Visible = true
                    end
                end
            end
        end)
