local function GetAvatar(userId, imageLabel)
    if not userId or userId <= 0 then
        imageLabel.Image = "rbxassetid://139930568"
        return
    end
    pcall(function()
        local img = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        imageLabel.Image = img or "rbxassetid://139930568"
    end)
end

