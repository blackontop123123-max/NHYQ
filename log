    for name, data in pairs(MonitoredPlayers) do
        local targetPlayer = Players:FindFirstChild(name)
        local userId = targetPlayer and targetPlayer.UserId or 0
        local displayName = targetPlayer and targetPlayer.DisplayName or name
        local hist = PlayerHistory[name] or { Joins = 0, Leaves = 0 }
        local timerText = data.TimerLabel and data.TimerLabel.Text or "⏱️ الوقت: 00:00"
        local statusText = data.StatusLabel and data.StatusLabel.Text or "غير معروف"
        local statusColor = data.StatusLabel and data.StatusLabel.TextColor3 or Color3.fromRGB(220, 170, 170)

        table.insert(items, {
            Name = name,
            DisplayName = displayName,
            UserId = userId,
            Joins = hist.Joins,
            Leaves = hist.Leaves,
            TimerText = timerText,
            StatusText = statusText,
            StatusColor = statusColor
        })
    end

    table.sort(items, function(a, b)
        return a.Name < b.Name
    end)

    return {
        LogTitle = CustomLogTitle,
        CapturedAt = os.date("%H:%M:%S"),
        Players = items
    }
end

