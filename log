local function SwitchTab(isPlayers)
    PlayersPage.Visible = isPlayers
    StoragePage.Visible = not isPlayers
    TabPlayersBtn.BackgroundColor3 = isPlayers and THEME.TabActive or THEME.TabInactive
    TabStorageBtn.BackgroundColor3 = (not isPlayers) and THEME.TabActive or THEME.TabInactive
    if not isPlayers then
        RefreshStorageForCurrentPlayer()
    end
end

