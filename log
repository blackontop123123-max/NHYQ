local activePlaybackToken = 0

CloseViewerBtn.MouseButton1Click:Connect(function()
    activePlaybackToken += 1
    ViewerBackdrop.Visible = false
end)

PreviewModal = function(entry)
    if not entry or entry.OwnerId ~= GetOwnerId() then return end
    activePlaybackToken += 1
    local token = activePlaybackToken
    ViewerBackdrop.Visible = true
    ViewerTitle.Text = entry.Title

    if entry.Kind == "Photo" then
        RenderMenuFrameIntoViewer(entry.FrameData, "صورة • " .. entry.Time)
    else
        task.spawn(function()
            local frames = entry.Frames or {}
            for i = 1, #frames do
                if token ~= activePlaybackToken or not ViewerBackdrop.Visible or entry.OwnerId ~= GetOwnerId() then break end
                RenderMenuFrameIntoViewer(frames[i], string.format("فيد %d/%dث", i, entry.Duration))
                task.wait(1)
            end
            if token == activePlaybackToken and ViewerBackdrop.Visible and entry.OwnerId == GetOwnerId() and #frames > 0 then
                RenderMenuFrameIntoViewer(frames[#frames], "انتهى (5ث)")
            end
        end)
    end
end

