local function RemoveSavedLogForCurrentPlayer(entryId)
    local ownerId = GetOwnerId()
    local ownerLogs = GetOwnerLogs()
    for i = #ownerLogs, 1, -1 do
        local item = ownerLogs[i]
        if item.Id == entryId and item.OwnerId == ownerId then
            table.remove(ownerLogs, i)
            break
        end
    end
end

