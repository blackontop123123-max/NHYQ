    task.wait(0.4)
    local targetText = "NHYQ"
    
    for i = 1, #targetText do
        TitleLabel.Text = string.sub(targetText, 1, i)
        
        if i >= 2 then
            RightCrown.TextTransparency = 0
            LeftCrown.TextTransparency = 0
        end
        
        ShakeScreen()
        task.wait(0.15)
    end
    
    local tweenService = game:GetService("TweenService")
    local info = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    tweenService:Create(UnderLine, info, {Size = UDim2.new(0, 300, 0, 3), Position = UDim2.new(0.5, -150, 0.4, 75)}):Play()
    
    task.wait(0.3)

    for i = 1, 100 do
        PercentLabel.Text = "Loading: " .. i .. "%"
        FillBar.Size = UDim2.new(i/100, 0, 1, 0)
        
        if i == 30 then
            SkipButton.Visible = true
        end
        
        task.wait(0.025)
    end

    task.wait(0.4)
    FinishLoader()
end)

