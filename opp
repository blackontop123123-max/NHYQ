--==================================================
-- VERIFY LOGIC & 3 ATTEMPTS BAN SYSTEM
--==================================================

local failedAttempts = 0
local CORRECT_KEY = "NHYQONTOP1234"

local function VerifyKey()
    local entered = KeyInput.Text

    if entered == "" then
        Status.Text = "Please enter a key."
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    if entered == CORRECT_KEY then
        Status.Text = "✓ KEY VERIFIED"
        Status.TextColor3 = Color3.fromRGB(0, 255, 100)
        KeyStroke.Color = Color3.fromRGB(0, 255, 100)

        TweenService:Create(
            Verify,
            TweenInfo.new(0.25),
            {BackgroundColor3 = Color3.fromRGB(0, 150, 60)}
        ):Play()

        task.wait(1)

        Background:Destroy()
        ToggleBtn.Visible = true

        WelcomeBanner.Position = UDim2.new(0, 0, 0, -75)
        TweenService:Create(
            WelcomeBanner,
            TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            { Position = UDim2.new(0, 0, 0, 0) }
        ):Play()

        LoadMainScript()

        task.wait(5)
        TweenService:Create(
            WelcomeBanner,
            TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            { Position = UDim2.new(0, 0, 0, -75) }
        ):Play()
    else
        failedAttempts = failedAttempts + 1
        KeyInput.Text = ""

        local remaining = 3 - failedAttempts
        if remaining > 0 then
            Status.Text = "✕ INVALID KEY! Remaining attempts: " .. remaining
        else
            Status.Text = "✕ INVALID KEY"
        end
        Status.TextColor3 = Color3.fromRGB(255, 40, 40)
        KeyStroke.Color = Color3.fromRGB(255, 0, 0)

        local oldPosition = Main.Position
        for i = 1, 4 do
            Main.Position = oldPosition + UDim2.fromOffset(math.random(-5, 5), 0)
            task.wait(0.04)
        end
        Main.Position = oldPosition

        if failedAttempts >= 3 then
            Background.Visible = false
            BanScreen.Visible = true
        end
    end
end

Verify.MouseButton1Click:Connect(VerifyKey)

KeyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        VerifyKey()
    end
end)

--==================================================
-- DRAG SYSTEM FOR KEY WINDOW
--==================================================

local dragging = false
local dragStart
local startPos

local function updateDrag(input)
    local delta = input.Position - dragStart
    Main.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

_U.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        updateDrag(input)
    end
end)
