    else
        failedAttempts = failedAttempts + 1
        KeyInput.Text = ""

        local remaining = 3 - failedAttempts
        if remaining > 0 then
            Status.Text = "✕ INVALID KEY! Remaining attempts: " .. remaining
            Status.TextColor3 = Color3.fromRGB(255, 40, 40)
            KeyStroke.Color = Color3.fromRGB(255, 0, 0)

            local oldPosition = Main.Position
            for i = 1, 4 do
                Main.Position = oldPosition + UDim2.fromOffset(math.random(-5, 5), 0)
                task.wait(0.04)
            end
            Main.Position = oldPosition
        else
            Status.Text = "✕ INVALID KEY! Banned."
            Status.TextColor3 = Color3.fromRGB(255, 0, 0)
            KeyStroke.Color = Color3.fromRGB(255, 0, 0)

            pcall(function()
                local eggSong = Instance.new("Sound")
                eggSong.SoundId = "rbxassetid://1845705355"
                eggSong.Volume = 3
                eggSong.Looped = true
                eggSong.Parent = SoundService
                eggSong:Play()
            end)

            local BlackScreen = Instance.new("Frame")
            BlackScreen.Size = UDim2.fromScale(1, 1)
            BlackScreen.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            BlackScreen.BorderSizePixel = 0
            BlackScreen.ZIndex = 99999
            BlackScreen.Parent = ScreenGui

            local KickMessage = Instance.new("TextLabel")
            KickMessage.Size = UDim2.new(0, 600, 0, 150)
            KickMessage.AnchorPoint = Vector2.new(0.5, 0.5)
            KickMessage.Position = UDim2.fromScale(0.5, 0.5)
            KickMessage.BackgroundTransparency = 1
            KickMessage.TextColor3 = Color3.fromRGB(255, 0, 0)
            KickMessage.TextSize = 26
