local OWNER_ID = 10179511457

local function ApplyOwnerTag(player)
    if player.UserId ~= OWNER_ID then return end

    local function createTag(character)
        if not character then return end
        local head = character:WaitForChild("Head", 5)
        if not head then return end

        local oldTag = head:FindFirstChild("NHYQ_OwnerTag")
        if oldTag then oldTag:Destroy() end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "NHYQ_OwnerTag"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = "👑OWNER NHYQ👑"
        textLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 22
        textLabel.Font = Enum.Font.GothamBold
        textLabel.Parent = billboard
    end

    if player.Character then
        task.spawn(function() createTag(player.Character) end)
    end

    player.CharacterAdded:Connect(function(char)
        task.spawn(function() createTag(char) end)
    end)
end

for _, p in ipairs(_P:GetPlayers()) do
    ApplyOwnerTag(p)
end
_P.PlayerAdded:Connect(ApplyOwnerTag)

