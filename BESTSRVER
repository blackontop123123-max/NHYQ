<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔥 عالم NHYQ 🔥 | مجتمع روبلوكس والتريد والسكربتات</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #070709;
            --card-bg: rgba(18, 18, 24, 0.85);
            --primary: #ff1e38;
            --primary-glow: rgba(255, 30, 56, 0.55);
            --accent: #ff6b00;
            --text-main: #ffffff;
            --text-muted: #a0a5b5;
            --border: rgba(255, 30, 56, 0.25);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            overflow-x: hidden;
            line-height: 1.6;
        }

        #particles-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        .container {
            max-width: 1050px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Hero Section */
        .hero {
            text-align: center;
            padding: 55px 20px 40px;
            position: relative;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 30, 56, 0.12);
            border: 1px solid var(--border);
            padding: 6px 18px;
            border-radius: 50px;
            font-size: 0.9rem;
            color: #ff8fa0;
            margin-bottom: 20px;
            box-shadow: 0 0 15px rgba(255, 30, 56, 0.15);
        }

        .pulse-dot {
            width: 10px;
            height: 10px;
            background: #23a55a;
            border-radius: 50%;
            box-shadow: 0 0 10px #23a55a;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(35, 165, 90, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(35, 165, 90, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(35, 165, 90, 0); }
        }

        .hero h1 {
            font-size: 3.4rem;
            font-weight: 900;
            letter-spacing: 1px;
            margin-bottom: 12px;
            text-shadow: 0 0 25px var(--primary-glow);
        }

        .hero h1 span {
            background: linear-gradient(135deg, #ff1e38, #ff7b00);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            color: var(--text-muted);
            font-size: 1.15rem;
            max-width: 680px;
            margin: 0 auto 32px;
        }

        /* CTA Buttons */
        .cta-group {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 40px;
        }

        .btn-join {
            background: linear-gradient(135deg, #ff1e38, #b8001f);
            color: #fff;
            text-decoration: none;
            padding: 15px 38px;
            border-radius: 14px;
            font-weight: 800;
            font-size: 1.2rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 25px var(--primary-glow);
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .btn-join:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 12px 35px rgba(255, 30, 56, 0.8);
        }

        .btn-copy {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 15px 26px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 1.05rem;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(8px);
        }

        .btn-copy:hover {
            background: rgba(255, 30, 56, 0.15);
            border-color: var(--primary);
        }

        /* Games Strip */
        .section-title {
            text-align: center;
            font-size: 1.8rem;
            font-weight: 800;
            margin: 45px 0 22px;
        }

        .section-title span {
            color: var(--primary);
        }

        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
            gap: 12px;
            margin-bottom: 45px;
        }

        .game-pill {
            background: var(--card-bg);
            border: 1px solid var(--border);
            padding: 14px 16px;
            border-radius: 12px;
            text-align: center;
            font-weight: 700;
            font-size: 0.95rem;
            transition: 0.25s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .game-pill:hover {
            border-color: var(--primary);
            transform: translateY(-3px);
            box-shadow: 0 5px 18px rgba(255, 30, 56, 0.25);
        }

        /* Interactive Channels Explorer */
        .explorer-box {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 25px;
            backdrop-filter: blur(12px);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
        }

        .tabs {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 25px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 18px;
        }

        .tab-btn {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text-muted);
            border: 1px solid transparent;
            padding: 10px 18px;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.25s;
            font-size: 0.95rem;
        }

        .tab-btn.active, .tab-btn:hover {
            background: rgba(255, 30, 56, 0.18);
            color: #fff;
            border-color: var(--primary);
            box-shadow: 0 0 15px rgba(255, 30, 56, 0.25);
        }

        .channels-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 12px;
        }

        .channel-item {
            background: rgba(10, 10, 14, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.06);
            padding: 13px 16px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: 0.2s;
        }

        .channel-item:hover {
            border-color: rgba(255, 30, 56, 0.45);
            background: rgba(255, 30, 56, 0.06);
        }

        .ch-name {
            font-weight: 700;
            font-size: 0.95rem;
            color: #f1f1f1;
        }

        .ch-tag {
            font-size: 0.75rem;
            background: rgba(255, 30, 56, 0.15);
            color: #ff7588;
            padding: 3px 9px;
            border-radius: 6px;
            font-weight: 600;
        }

        /* Features Cards */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 18px;
            margin-top: 40px;
        }

        .feat-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            transition: 0.3s;
        }

        .feat-card:hover {
            transform: translateY(-4px);
            border-color: var(--primary);
        }

        .feat-icon {
            font-size: 2rem;
            margin-bottom: 12px;
        }

        .feat-card h3 {
            font-size: 1.2rem;
            margin-bottom: 8px;
            color: #fff;
        }

        .feat-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 45px 20px 30px;
            color: var(--text-muted);
            font-size: 0.9rem;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            margin-top: 50px;
        }

        @media (max-width: 600px) {
            .hero h1 { font-size: 2.3rem; }
            .btn-join, .btn-copy { width: 100%; justify-content: center; }
        }
    </style>
</head>
<body>

<canvas id="particles-canvas"></canvas>

<div class="container">
    <!-- Hero -->
    <section class="hero">
        <div class="status-badge">
            <span class="pulse-dot"></span>
            <span>السيرفر نشط الآن • التريد والفعاليات شغالة 24/7</span>
        </div>
        <h1>🔥 <span>عالم NHYQ</span> 🔥</h1>
        <p>أقوى تجمع عربي للاعبي روبلوكس! تريدات مضمونة لأشهر المابات، سكربتات ومفاتيح دلتا محدثة، فعاليات مستمرة، وسوالف فويس على مدار الساعة.</p>

        <div class="cta-group">
            <a href="https://discord.gg/yV4wUaHN8" target="_blank" class="btn-join">
                🚀 انضم للسيرفر الآن
            </a>
            <button class="btn-copy" onclick="copyInvite()" id="copyBtn">
                📋 نسخ رابط الدعوة
            </button>
        </div>
    </section>

    <!-- Supported Trade Games -->
    <h2 class="section-title">💎 رومات <span>التريدات</span> المتوفرة</h2>
    <div class="games-grid">
        <div class="game-pill">🍎 BLOX-FRUITS</div>
        <div class="game-pill">💎 MM2</div>
        <div class="game-pill">🔪 MURDER-VS-SHERIFF</div>
        <div class="game-pill">🐾 ADOPT-ME</div>
        <div class="game-pill">🧠 STEAL-A-BRAINROT</div>
        <div class="game-pill">🚔 JAILBREAK</div>
        <div class="game-pill">🌱 GROW-A-GARDEN</div>
        <div class="game-pill">👑 ROYALE-HIGH</div>
        <div class="game-pill">🤝 TRADE-HANGOUT</div>
    </div>

    <!-- Interactive Channels Explorer -->
    <h2 class="section-title">📂 تصفح <span>أقسام ورومات</span> السيرفر</h2>
    <div class="explorer-box">
        <div class="tabs">
            <button class="tab-btn active" onclick="renderTab('community', this)">💬 الشات والفعاليات</button>
            <button class="tab-btn" onclick="renderTab('trades', this)">💎 التريدات والحماية</button>
            <button class="tab-btn" onclick="renderTab('scripts', this)">⚡ السكربتات ودلتا</button>
            <button class="tab-btn" onclick="renderTab('welcome', this)">🚀 البداية والأذكار</button>
            <button class="tab-btn" onclick="renderTab('voice', this)">🎧 الرومات الصوتية</button>
        </div>
        <div class="channels-list" id="channelsContainer"></div>
    </div>

    <!-- Features -->
    <div class="features-grid">
        <div class="feat-card">
            <div class="feat-icon">🛡️</div>
            <h3>حماية من النصابين</h3>
            <p>قسم مخصص للبلاغات (Scammer Report) لضمان بيئة تبادل آمنة وموثوقة لكل الأعضاء.</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon">⚡</div>
            <h3>قسم السكربتات ومفتاح دلتا</h3>
            <p>تحديثات مستمرة لأخبار السكربتات، سكربتات عشوائية، ومفاتيح دلتا جاهزة للاستخدام.</p>
        </div>
        <div class="feat-card">
            <div class="feat-icon">🏆</div>
            <h3>تفاعل وفعاليات يومية</h3>
            <p>شات عام نشط، ستريك يومي، فعاليات وجوائز مستمرة، ورومات فويس مفتوحة للجميع.</p>
        </div>
    </div>

    <footer>
        <p>© 2026 🔥 عالم NHYQ 🔥 — رابط الدعوة المباشر: <strong>discord.gg/yV4wUaHN8</strong></p>
    </footer>
</div>

<script>
    const serverChannels = {
        community: [
            { name: "# 💭・الشات-العام", tag: "تفاعل 24/7" },
            { name: "# 🏆・الفعاليات", tag: "جوائز" },
            { name: "# 💡・الاقتراحات", tag: "آراءكم" },
            { name: "# 📸・فضايح", tag: "ضحك ووناسة" },
            { name: "# 🔥・الستريك", tag: "تحدي يومي" },
            { name: "# 🔥・بوستات", tag: "دعم السيرفر" }
        ],
        trades: [
            { name: "# 🍎・BLOX-FRUITS", tag: "تريد" },
            { name: "# 💎・MM2", tag: "تريد" },
            { name: "# 🔪・MURDER-VS-SHERIFF", tag: "تريد" },
            { name: "# 🐾・ADOPT-ME", tag: "تريد" },
            { name: "# 🧠・STEAL-A-BRAINROT", tag: "تريد" },
            { name: "# 🚔・JAILBREAK", tag: "تريد" },
            { name: "# 🌱・GROW-A-GARDEN", tag: "تريد" },
            { name: "# 👑・ROYALE-HIGH", tag: "تريد" },
            { name: "# 💎・TRADE-HANGOUT", tag: "تبادل عام" },
            { name: "# 🚨・SCAMMER-REPORT", tag: "حماية وبلاغات" }
        ],
        scripts: [
            { name: "# 💻・سكربتات-عشوائيه", tag: "محدث" },
            { name: "# 🖥️・آخبار-سكربت", tag: "تحديثات" },
            { name: "# ✅・موثقين-سكربت", tag: "موثوق" },
            { name: "# 🔑・مفتاح-دلتا", tag: "Delta Key" },
            { name: "# ⚡・ROBLOX-HACKS", tag: "أدوات" }
        ],
        welcome: [
            { name: "# 👋・الترحيب", tag: "أهلاً بك" },
            { name: "# 📜・القوانين", tag: "النظام" },
            { name: "# 📣・الآخبار", tag: "جديدنا" },
            { name: "# 🔔・الإعلانات", tag: "مهم" },
            { name: "# 🤝・التحالفات", tag: "شراكات" },
            { name: "# 📖・آذكار", tag: "أجر وتذكير" },
            { name: "# 🎫・التكت", tag: "دعم فني" }
        ],
        voice: [
            { name: "🔊 🎧・سوالف صوتية", tag: "مفتوح" },
            { name: "🔊 🎧・فويس عام", tag: "مفتوح" },
            { name: "🔊 🎧・سوالف صوتية 2", tag: "مفتوح" }
        ]
    };

    function renderTab(category, btn) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const container = document.getElementById('channelsContainer');
        container.innerHTML = serverChannels[category].map(ch => `
            <div class="channel-item">
                <span class="ch-name">${ch.name}</span>
                <span class="ch-tag">${ch.tag}</span>
            </div>
        `).join('');
    }

    function copyInvite() {
        const link = "https://discord.gg/yV4wUaHN8";
        navigator.clipboard.writeText(link).then(() => {
            const btn = document.getElementById('copyBtn');
            btn.innerHTML = "✅ تم نسخ الرابط!";
            btn.style.borderColor = "#23a55a";
            setTimeout(() => {
                btn.innerHTML = "📋 نسخ رابط الدعوة";
                btn.style.borderColor = "rgba(255, 255, 255, 0.15)";
            }, 2500);
        });
    }

    // Fire Embers Background Animation
    const canvas = document.getElementById('particles-canvas');
    const ctx = canvas.getContext('2d');
    let particles = [];

    function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    for (let i = 0; i < 45; i++) {
        particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            r: Math.random() * 2.5 + 0.8,
            dy: -(Math.random() * 0.8 + 0.3),
            dx: (Math.random() - 0.5) * 0.4,
            alpha: Math.random() * 0.6 + 0.2
        });
    }

    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach(p => {
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 45, 65, ${p.alpha})`;
            ctx.fill();
            p.y += p.dy;
            p.x += p.dx;
            if (p.y < 0) {
                p.y = canvas.height;
                p.x = Math.random() * canvas.width;
            }
        });
        requestAnimationFrame(animate);
    }

    renderTab('community');
    animate();
</script>
</body>
</html>
