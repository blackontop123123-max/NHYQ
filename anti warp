-- 1. حماية BLUR
runService.RenderStepped:Connect(function()
  if protections.Blur then
    for _, v in ipairs(lighting:GetChildren()) do
      if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v.Name:lower():find("blur") then
        v:Destroy()
      end
    end
    local camera = workspace.CurrentCamera
    if camera then
      for _, v in ipairs(camera:GetChildren()) do
        if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v.Name:lower():find("blur") then
          v:Destroy()
        end
      end
    end
  end
end)

-- 2. حماية WARP & LOOPWARP (الكاميرا منفصلة تماماً ومستقلة + محاكاة المنظور الطبيعي 100%)
runService.RenderStepped:Connect(function()
  if protections.Warp or protections.LoopWarp then
    pcall(function()
      local char = localPlayer.Character
      local camera = workspace.CurrentCamera
      if char and camera then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        
        if hrp and head then
          -- فصل الكاميرا كلياً عن السيرفر وتفعيل نوع التحكم اليدوي المباشر
          camera.CameraType = Enum.CameraType.Scriptable
          
          -- حساب اتجاه الكاميرا بالزوايا
          local focusPosition = head.Position
          local rotationCFrame = CFrame.Angles(0, math.rad(cameraAngleX), 0) * CFrame.Angles(math.rad(cameraAngleY), 0, 0)
          local targetCFrame = CFrame.new(focusPosition) * rotationCFrame * CFrame.new(0, 0, cameraDistance)
          
          -- تثبيت الكاميرا بالمنظور المحاكي مع النظر إلى الشخصية مباشرة
          camera.CFrame = CFrame.new(targetCFrame.Position, focusPosition)
        end
      end
    end)
  end
end)
