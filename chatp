--==================================================
-- 3) وظائف الشات
--==================================================
local function addMessage(sender, msg, isMe)
    local lbl = Instance.new("TextLabel", scroll)
    lbl.Size = UDim2.new(1, -8, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Top
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextWrapped = true
    lbl.Text = "  " .. sender .. ": " .. msg
    lbl.TextColor3 = isMe and Color3.fromRGB(100, 200, 255) or Color3.fromRGB(255, 150, 100)
    
    task.wait()
    local totalH = 0
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextLabel") then totalH = totalH + c.AbsoluteSize.Y + 4 end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, totalH + 10)
    scroll.CanvasPosition = Vector2.new(0, math.max(0, totalH))
end

-- إرسال الرسالة عبر قناة TextChatService
local function sendMessage()
    local txt = input.Text
    if txt == "" then return end
    if #txt > 200 then txt = txt:sub(1, 200) end

    -- عرض محلي
    addMessage(localPlayer.Name, txt, true)

    -- الإرسال عبر القناة الخاصة
    if channel then
        pcall(function()
            channel:SendAsync(txt)
        end)
    end

    input.Text = ""
end

sendBtn.MouseButton1Click:Connect(sendMessage)
input.FocusLost:Connect(function(enter) if enter then sendMessage() end end)

--==================================================
-- 4) استقبال الرسائل من القناة
--==================================================
if channel then
    channel.MessageReceived:Connect(function(message)
        -- نتأكد إن الرسالة مو مننا (عشان ما نكررها)
        if message.TextSource and message.TextSource.UserId == localPlayer.UserId then
            return
        end
        
        local senderName = "Player"
        if message.TextSource then
            local p = Players:GetPlayerByUserId(message.TextSource.UserId)
            if p then senderName = p.Name end
        end
        
        addMessage(senderName, message.Text, false)
    end)
end

print("✅ NHYQ Private Chat Loaded via TextChatService")
