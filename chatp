            pBtn.Size = UDim2.new(1, 0, 0, 26)
            pBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            pBtn.Text = pName
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.TextSize = 10
            pBtn.Font = Enum.Font.GothamMedium
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
            
            pBtn.MouseButton1Click:Connect(function()
                for _, btn in ipairs(ModalScroll:GetChildren()) do
                    if btn:IsA("TextButton") then
                        btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                    end
                end
                pBtn.BackgroundColor3 = Color3.fromRGB(120, 20, 20)
                selectedTargetPlayer = pName
            end)
        end
    end

    PlayerListModal.Visible = true
end

