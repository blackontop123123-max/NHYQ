-- 2. نظام الفقاعة فوق الرأس (مثل الصورة)
--==================================================
local function showBubbleOnHead(playerName, msgText)
	local targetPlayer = players:FindFirstChild(playerName)
	if not targetPlayer or not targetPlayer.Character then return end
	local head = targetPlayer.Character:FindFirstChild("Head")
	if not head then return end

	local old = head:FindFirstChild("NHYQ_Bubble")
	if old then old:Destroy() end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "NHYQ_Bubble"
	billboard.Size = UDim2.new(0, 160, 0, 50) 
	billboard.StudsOffset = Vector3.new(0, 2.5, 0) 
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local bg = Instance.new("Frame", billboard)
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
	bg.BackgroundTransparency = 0.1
	bg.BorderSizePixel = 0
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 8)

	local stroke = Instance.new("UIStroke", bg)
	stroke.Color = Color3.fromRGB(0, 0, 0)
	stroke.Thickness = 1.5
	stroke.Transparency = 0

	local lbl = Instance.new("TextLabel", bg)
	lbl.Size = UDim2.new(1, -12, 1, -12)
	lbl.Position = UDim2.new(0, 6, 0, 6)
	lbl.BackgroundTransparency = 1
	lbl.Text = msgText
	lbl.TextColor3 = Color3.fromRGB(0, 0, 0)
	lbl.TextSize = 13
	lbl.Font = Enum.Font.GothamBold
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Center
	lbl.TextYAlignment = Enum.TextYAlignment.Center

	task.delay(5, function()
		if billboard and billboard.Parent then billboard:Destroy() end
	end)
end

-- إضافة الرسائل داخل المستطيل المصغر
local function addMessageToBar(senderName, msgText, isSystem)
	local label = Instance.new("TextLabel", MiniScroll)
	label.Size = UDim2.new(1, 0, 0, 15)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.BackgroundTransparency = 1
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamBold
	label.TextSize = 9
	label.TextWrapped = true
	
	if isSystem then
		label.Text = "🔧 " .. msgText
		label.TextColor3 = Color3.fromRGB(150, 150, 150)
	else
		label.Text = "🔥 " .. senderName .. ": " .. msgText
		label.TextColor3 = Color3.fromRGB(255, 150, 100)
	end

	if #MiniScroll:GetChildren() > 15 then
		local firstChild = MiniScroll:FindFirstChildOfClass("TextLabel")
		if firstChild then firstChild:Destroy() end
	end

	task.defer(function()
		MiniScroll.CanvasPosition = Vector2.new(0, math.max(0, MiniScroll.AbsoluteCanvasSize.Y - MiniScroll.AbsoluteSize.Y))
	end)
end

--==================================================
-- 3. محرك الاتصال (WebSocket)
--==================================================
local function SendPacket(Packet)
	if Closed or not Socket then return false end
	local Success = pcall(function() Socket:Send(httpService:JSONEncode(Packet)) end)
	return Success
end

local function Disconnect()
	Generation += 1
	local OldSocket = Socket
	Socket = nil
	if OldSocket then pcall(function() OldSocket:Close() end) end
end

local function HandleMessage(RawMessage)
	local Success, Data = pcall(function() return httpService:JSONDecode(tostring(RawMessage)) end)
	if not Success or type(Data) ~= "table" then return end

	if Data.type == "joined" then
		addMessageToBar("", "متصل بالشات العالمي ✅", true)
		showBubbleOnHead(Username, "متصل ✅")
		
	elseif Data.type == "say" then
		local Payload = Data.payload
		if type(Payload) == "table" and type(Payload.text) == "string" then
			local senderName = tostring(Data.username)
			local msgText = Payload.text
			
			addMessageToBar(senderName, msgText, false)
			showBubbleOnHead(senderName, msgText)
		end
	end
end

local function JoinChat()
	if Closed then return end
	Disconnect()
	
	addMessageToBar("", "جاري الاتصال...", true)
	local MyGeneration = Generation

	local ConnectSuccess, ConnectResult = pcall(function() return WebSocket.connect(ENDPOINT) end)
	if not ConnectSuccess or not ConnectResult then
		addMessageToBar("", "فشل الاتصال!", true)
		return
	end

	if Closed or MyGeneration ~= Generation then
		pcall(function() ConnectResult:Close() end)
		return
	end

	Socket = ConnectResult

	Socket.OnMessage:Connect(function(RawMessage)
		if Closed or MyGeneration ~= Generation then return end
		HandleMessage(RawMessage)
	end)

	Socket.OnClose:Connect(function()
		if Closed or MyGeneration ~= Generation then return end
		Socket = nil
		addMessageToBar("", "تم قطع الاتصال.", true)
	end)

	SendPacket({
		type = "join",
		room = ROOM_NAME,
		username = Username
	})
end

-- إرسال الرسالة
local function handleSendMessage()
	local text = InputBox.Text
	if text == "" then return end
	if #text > 100 then text = text:sub(1, 100) end

	showBubbleOnHead(Username, text)
	addMessageToBar(Username, text, false)

	local Success = SendPacket({
		type = "say",
		payload = { type = "chat", text = text }
	})

	if Success then InputBox.Text = "" else addMessageToBar("", "فشل الإرسال", true) end
end

SendBtn.MouseButton1Click:Connect(handleSendMessage)
InputBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then handleSendMessage() end
end)

-- بدء الاتصال فوراً عند التشغيل
JoinChat()
