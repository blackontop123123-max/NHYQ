-- 2. الوظائف (الفقاعات فوق الرأس + قائمة اللاعبين)
--==================================================
local function updateTargetList()
    local currentSelected = targetList[currentIndex] or "All"
    targetList = {"All"}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(targetList, p.Name)
        end
    end
    for i, name in ipairs(targetList) do
        if name == currentSelected then
            currentIndex = i
            return
        end
    end
    currentIndex = 1
end

local function showBubbleOnHead(targetName, msgText)
    pcall(function()
        local targetPlayer = Players:FindFirstChild(targetName)
        if targetPlayer and targetPlayer.Character then
            local head = targetPlayer.Character:FindFirstChild("Head")
            if head then
                ChatService:Chat(head, "[NHYQ] " .. msgText, Enum.ChatColor.Red)
            end
        end
    end)
end

local function AddMessage(Text, ColorOverride)
    if Closed or not ChatGui.Parent then return end
    MessageOrder += 1

    local Label = Instance.new("TextLabel")
    Label.Name = "ChatMessage"
    Label.LayoutOrder = MessageOrder
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.new(1, -4, 0, 15)
    Label.AutomaticSize = Enum.AutomaticSize.Y
    Label.Text = tostring(Text)
    Label.TextColor3 = ColorOverride or Color3.fromRGB(255, 160, 120)
    Label.TextSize = 8.5
    Label.Font = Enum.Font.GothamBold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.TextWrapped = true
    Label.Parent = MiniScroll

    table.insert(Labels, Label)
    while #Labels > MAX_MESSAGES do
        local Oldest = table.remove(Labels, 1)
        if Oldest then Oldest:Destroy() end
    end

    task.defer(function()
        if Closed or not MiniScroll.Parent then return end
        MiniScroll.CanvasPosition = Vector2.new(0, math.max(0, MiniScroll.AbsoluteCanvasSize.Y - MiniScroll.AbsoluteSize.Y))
    end)
end

local function ClearMessages()
    for _, Label in ipairs(Labels) do
        Label:Destroy()
    end
    table.clear(Labels)
    MiniScroll.CanvasPosition = Vector2.zero
end

--==================================================
-- 3. نظام الاتصال (WebSocket) والإرسال والاستقبال
--==================================================
local function SendPacket(Packet)
    if Closed or not Socket then return false end
    local Success = pcall(function()
        Socket:Send(HttpService:JSONEncode(Packet))
    end)
    return Success
end

local function Disconnect()
    Generation += 1
    for _, Conn in ipairs(SocketConnections) do
        pcall(function() Conn:Disconnect() end)
    end
    table.clear(SocketConnections)
    if Socket then
        pcall(function() Socket:Close() end)
        Socket = nil
    end
end

local function IsMuted(Name)
    return Muted[tostring(Name):lower()] == true
end

local function ProcessIncomingChat(senderName, rawText)
    if IsMuted(senderName) then return end

    local targetUser, actualMsg = rawText:match("^@([^:]+):%s*(.+)$")
    
    if targetUser and actualMsg then
        if targetUser:lower() == Username:lower() or senderName:lower() == Username:lower() then
            AddMessage("🔒 [" .. senderName .. " ➔ " .. targetUser .. "]: " .. actualMsg, Color3.fromRGB(255, 70, 70))
            showBubbleOnHead(senderName, actualMsg)
        end
    else
        AddMessage("🔥 " .. senderName .. ": " .. rawText, Color3.fromRGB(255, 160, 120))
        showBubbleOnHead(senderName, rawText)
    end
end

local function HandleMessage(RawMessage)
    local Success, Data = pcall(function()
        return HttpService:JSONDecode(tostring(RawMessage))
    end)
    if not Success or type(Data) ~= "table" then return end

    if Data.type == "joined" then
        AddMessage("⚡ تم الدخول للروم بنجاح!", Color3.fromRGB(100, 255, 100))
        if type(Data.history) == "table" then
            for _, Entry in ipairs(Data.history) do
                if type(Entry) == "table" and type(Entry.payload) == "table" and Entry.payload.type == "chat" then
                    ProcessIncomingChat(tostring(Entry.username), tostring(Entry.payload.text))
                end
            end
        end

    elseif Data.type == "say" then
        if type(Data.payload) == "table" and Data.payload.type == "chat" then
            ProcessIncomingChat(tostring(Data.username), tostring(Data.payload.text))
        end

    elseif Data.type == "user-joined" then
        AddMessage("➕ دخل: " .. tostring(Data.username), Color3.fromRGB(180, 180, 180))

    elseif Data.type == "user-left" then
        AddMessage("➖ غادر: " .. tostring(Data.username), Color3.fromRGB(150, 150, 150))

    elseif Data.type == "error" then
        AddMessage("⚠️ خطأ: " .. tostring(Data.message), Color3.fromRGB(255, 50, 50))
    end
end

local function ConnectToRoom()
    if Closed then return end
    Disconnect()
    AddMessage("⏳ جاري الاتصال التلقائي بالروم...", Color3.fromRGB(200, 200, 200))

    local MyGeneration = Generation
    local ConnectSuccess, ConnectResult = pcall(function()
        return WebSocket.connect(ENDPOINT)
    end)

    if not ConnectSuccess or not ConnectResult then
        AddMessage("❌ فشل الاتصال بالسيرفر!", Color3.fromRGB(255, 50, 50))
        return
    end

    if Closed or MyGeneration ~= Generation then
        pcall(function() ConnectResult:Close() end)
        return
    end

    Socket = ConnectResult

    table.insert(SocketConnections, Socket.OnMessage:Connect(function(RawMessage)
        if Closed or MyGeneration ~= Generation then return end
        HandleMessage(RawMessage)
    end))

    table.insert(SocketConnections, Socket.OnClose:Connect(function()
        if Closed or MyGeneration ~= Generation then return end
        Socket = nil
        AddMessage("🔌 انقطع الاتصال. اكتب /reconnect للعودة.", Color3.fromRGB(255, 80, 80))
    end))

    SendPacket({
        type = "join",
        room = ROOM_NAME,
        username = Username
    })
end

local function CloseChat()
    if Closed then return end
    Closed = true
    Disconnect()
    for _, Conn in ipairs(Connections) do
        pcall(function() Conn:Disconnect() end)
    end
    table.clear(Connections)
    if Env.NHYQChatClose == CloseChat then
        Env.NHYQChatClose = nil
    end
    ChatGui:Destroy()
end

Env.NHYQChatClose = CloseChat

