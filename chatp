local Players      = game:GetService("Players")
local RS           = game:GetService("ReplicatedStorage")
local CoreGui      = game:GetService("CoreGui")
local ChatSvc      = game:GetService("Chat")
local localPlayer  = Players.LocalPlayer

--==================================================
-- 1) الاتصال بـ RemoteEvent
--==================================================
local NETWORK_NAME = "NHYQ_Chat_Remote"

local function getRemoteEvent()
    local re = RS:FindFirstChild(NETWORK_NAME)
    if re then return re end
    -- احتياط: أي RemoteEvent موجود
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            return obj
        end
    end
    return nil
end

local remoteEvent = getRemoteEvent()

--==================================================
-- 2) الواجهة
--==================================================
