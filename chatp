--==================================================
local function addMessage(sender, msg, isMe)
    local lbl = Instance.new("TextLabel", scroll)
    lbl.Size = UDim2.new(1, -8, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Top
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextWrapped = true
    lbl.Text = "  " .. sender .. ": " .. msg
    lbl.TextColor3 = isMe and Color3.fromRGB(100, 200, 255) or Color3.fromRGB(255, 150, 100)
    
    task.wait()
    local totalH = 0
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextLabel") then totalH = totalH + c.AbsoluteSize.Y + 4 end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, totalH + 10)
    scroll.CanvasPosition = Vector2.new(0, math.max(0, totalH))
end

--==================================================
-- 🔥 إرسال عبر RemoteEvents المختلفة
--==================================================
local lastSend = 0

local function sendMessage()
    local txt = input.Text
    if txt == "" then return end
    if #txt > 100 then txt = txt:sub(1, 100) end
    
    -- منع الباند
    local now = tick()
    if now - lastSend < 2 then
        addMessage("⚠️", "انتظر شوية قبل الإرسال التالي", false)
        return
    end
    lastSend = now
    
    -- عرض محلي
    addMessage(localPlayer.Name, txt, true)
    
    -- جرّب RemoteEvents بطرق مختلفة
    local sent = false
    
    if ReplicateEffect then
        pcall(function()
            ReplicateEffect:FireServer("NHYQ_CHAT", localPlayer.Name, txt)
            sent = true
        end)
    end
    
    if not sent and Notification then
        pcall(function()
            Notification:FireServer("NHYQ_CHAT", localPlayer.Name, txt)
            sent = true
        end)
    end
    
    if not sent then
        addMessage("⚠️ النظام", "ما في RemoteEvent متاح", false)
    end
    
    input.Text = ""
end

sendBtn.MouseButton1Click:Connect(sendMessage)
input.FocusLost:Connect(function(enter)
    if enter then sendMessage() end
end)

--==================================================
-- استقبال (إذا الـ RemoteEvent يوزع للجميع)
--==================================================
if ReplicateEffect then
    ReplicateEffect.OnClientEvent:Connect(function(...)
        local args = {...}
        -- نتحقق إذا الرسالة تخصنا
        for i, v in ipairs(args) do
            if v == "NHYQ_CHAT" and args[i+1] and args[i+2] then
                if args[i+1] ~= localPlayer.Name then
                    addMessage(args[i+1], tostring(args[i+2]), false)
                end
                break
            end
        end
    end)
end

if Notification then
    Notification.OnClientEvent:Connect(function(...)
        local args = {...}
        for i, v in ipairs(args) do
            if v == "NHYQ_CHAT" and args[i+1] and args[i+2] then
                if args[i+1] ~= localPlayer.Name then
                    addMessage(args[i+1], tostring(args[i+2]), false)
                end
                break
            end
        end
    end)
end

