        TargetSelectorBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        TargetSelectorBtn.Text = "🔒 " .. selected:sub(1, 5)
        TargetSelectorBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end))

local function SendMessage()
    if Closed then return end
    local Message = InputBox.Text
    if not Message:match("%S") then return end

    if Message:lower():match("^%s*/clear%s*$") then
        ClearMessages()
        InputBox.Text = ""
        return
    end

    if Message:lower():match("^%s*/reconnect%s*$") then
        InputBox.Text = ""
        ConnectToRoom()
        return
    end

    updateTargetList()
    local targetName = targetList[currentIndex] or "All"
    local finalPayloadText = Message

    if targetName ~= "All" then
        finalPayloadText = "@" .. targetName .. ": " .. Message
    end

    if #finalPayloadText > 100 then
        AddMessage("⚠️ الرسالة أطول من 100 حرف.", Color3.fromRGB(255, 80, 80))
        return
    end

    local Success = SendPacket({
        type = "say",
        payload = {
            type = "chat",
            text = finalPayloadText
        }
    })

    if Success then
        InputBox.Text = ""
    else
        AddMessage("❌ فشل الإرسال، جرب /reconnect", Color3.fromRGB(255, 50, 50))
    end
end

table.insert(Connections, SendBtn.MouseButton1Click:Connect(SendMessage))
table.insert(Connections, InputBox.FocusLost:Connect(function(EnterPressed)
    if EnterPressed then SendMessage() end
end))

-- الدخول التلقائي للروم فور تشغيل السكربت
