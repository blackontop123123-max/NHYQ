--==================================================
-- NHYQ Chat — يستخدم SayMessageRequest الرسمي
-- يشتغل بينك وبين صاحبك بنفس السيرفر
--==================================================

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local localPlayer = Players.LocalPlayer

-- البحث عن SayMessageRequest
local SayMsg
for _, obj in ipairs(RS:GetDescendants()) do
    if obj:IsA("RemoteEvent") and obj.Name == "SayMessageRequest" then
        SayMsg = obj
        break
    end
end

print("SayMessageRequest:", SayMsg and "✅ موجود" or "❌ ما لقاه")

