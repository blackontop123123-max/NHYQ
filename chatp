--==================================================
-- NHYQ FLOATING MINI CHAT BAR (WORKING VERSION)
-- يعمل بين لاعبين مختلفين في نفس السيرفر
--==================================================

local players = game:GetService("Players")
local replicatedStorage = game:GetService("ReplicatedStorage")
local coreGui = game:GetService("CoreGui")
local chatService = game:GetService("Chat")
local localPlayer = players.LocalPlayer

-- محاولة إيجاد RemoteEvent موجود مسبقاً
local remoteEvent = replicatedStorage:FindFirstChild("NHYQ_Chat_Remote")

-- إذا ما موجود، نبحث عن أي RemoteEvent عام
if not remoteEvent then
	for _, obj in ipairs(replicatedStorage:GetDescendants()) do
		if obj:IsA("RemoteEvent") then
			remoteEvent = obj
			break
		end
	end
end

-- ⚠️ تنبيه: إذا ما فيه RemoteEvent موجود، السكربت راح يستخدم ChatService فقط
-- لكن الرسائل ما راح تنعرض في الشريط المصغر لصاحبك إلا إذا كان موجود RemoteEvent

--==================================================
-- الواجهة (تعمل عندك وعند صاحبك)
--==================================================

local chatGui = Instance.new("ScreenGui")
chatGui.Name = "NHYQ_FloatingChat_GUI"
chatGui.Parent = coreGui
chatGui.ResetOnSpawn = false
chatGui.IgnoreGuiInset = true

local ChatBarFrame = Instance.new("Frame")
ChatBarFrame.Size = UDim2.new(0, 280, 0, 150)
ChatBarFrame.Position = UDim2.new(1, -295, 0, 15)
ChatBarFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
ChatBarFrame.BackgroundTransparency = 0.15
ChatBarFrame.BorderSizePixel = 0
ChatBarFrame.Active = true
ChatBarFrame.Draggable = true
ChatBarFrame.Parent = chatGui

Instance.new("UICorner", ChatBarFrame).CornerRadius = UDim.new(0, 8)
local BarStroke = Instance.new("UIStroke", ChatBarFrame)
BarStroke.Color = Color3.fromRGB(180, 0, 0)
BarStroke.Thickness = 1.5

local MiniScroll = Instance.new("ScrollingFrame", ChatBarFrame)
MiniScroll.Size = UDim2.new(1, -10, 1, -45)
MiniScroll.Position = UDim2.new(0, 5, 0, 5)
MiniScroll.BackgroundTransparency = 1
MiniScroll.BorderSizePixel = 0
MiniScroll.ScrollBarThickness = 2
MiniScroll.ScrollBarImageColor3 = Color3.fromRGB(180, 0, 0)
MiniScroll.CanvasSize = UDim2.new(0, 0, 0, 0)

local MiniList = Instance.new("UIListLayout", MiniScroll)
MiniList.SortOrder = Enum.SortOrder.LayoutOrder
MiniList.Padding = UDim.new(0, 3)

-- قائمة الأهداف
local targetList = {"All"}
local currentIndex = 1

local function updateTargetList()
	local currentSelected = targetList[currentIndex] or "All"
	targetList = {"All"}
	for _, p in ipairs(players:GetPlayers()) do
		if p ~= localPlayer then
			table.insert(targetList, p.Name)
		end
	end
	for i, name in ipairs(targetList) do
		if name == currentSelected then
			currentIndex = i
			return
		end
	end
	currentIndex = 1
end
updateTargetList()

local TargetSelectorBtn = Instance.new("TextButton", ChatBarFrame)
TargetSelectorBtn.Size = UDim2.new(0, 72, 0, 30)
TargetSelectorBtn.Position = UDim2.new(0, 5, 1, -35)
TargetSelectorBtn.BackgroundColor3 = Color3.fromRGB(20, 10, 10)
TargetSelectorBtn.Text = "🌐 All"
TargetSelectorBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
TargetSelectorBtn.TextSize = 8.5
TargetSelectorBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", TargetSelectorBtn).CornerRadius = UDim.new(0, 5)
Instance.new("UIStroke", TargetSelectorBtn).Color = Color3.fromRGB(180, 0, 0)

TargetSelectorBtn.MouseButton1Click:Connect(function()
	updateTargetList()
	currentIndex = currentIndex + 1
	if currentIndex > #targetList then currentIndex = 1 end
	local selected = targetList[currentIndex]
	if selected == "All" then
		TargetSelectorBtn.Text = "🌐 All"
		TargetSelectorBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
	else
		TargetSelectorBtn.Text = "🔒 " .. selected:sub(1, 5)
		TargetSelectorBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
	end
end)

local InputBox = Instance.new("TextBox", ChatBarFrame)
InputBox.Size = UDim2.new(1, -142, 0, 30)
InputBox.Position = UDim2.new(0, 80, 1, -35)
InputBox.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
InputBox.BorderSizePixel = 0
InputBox.ClearTextOnFocus = false
InputBox.PlaceholderText = "اكتب رسالتك هنا..."
