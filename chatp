--==================================================
-- 🔥 دوال الإرسال (الطريقة الأساسية)
--==================================================

-- الطريقة 1: ChatService (Legacy)
local function sendViaLegacy(txt)
    pcall(function()
        local char = localPlayer.Character
        local head = char and char:FindFirstChild("Head")
        if head then
            ChatSvc:Chat(head, "[NHYQ] " .. txt, Enum.ChatColor.Red)
            return true
        end
    end)
    return false
end

-- الطريقة 2: TextChatService (النظام الجديد)
local function sendViaTextChat(txt)
    local ok = pcall(function()
        local channels = TextChat:FindFirstChild("TextChannels")
        local general = channels and channels:FindFirstChild("RBXGeneral")
        if general then
            general:SendAsync("[NHYQ] " .. txt)
        end
    end)
    return ok
end

-- الطريقة 3: TextBox الأصلي في اللعبة (الحل الأخير — يشتغل دائماً)
local function sendViaMainChatBox(txt)
    pcall(function()
        -- نلاقي TextBox الشات الرسمي في اللعبة
        local chatInput
        -- Legacy chat
        local legacy = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
        if legacy then
            local chat = legacy:FindFirstChild("Chat")
            if chat then
                local textBox = chat:FindFirstChild("ChatBarParentFrame")
                if textBox then
                    textBox = textBox:FindFirstChild("Frame")
                    if textBox then
                        textBox = textBox:FindFirstChild("TextButton")
                        if textBox then
                            chatInput = textBox:FindFirstChild("TextBox")
                        end
                    end
                end
            end
        end

        -- TextChatService chat box
        if not chatInput then
            local playerGui = localPlayer:FindFirstChild("PlayerGui")
            if playerGui then
                local chatGui = playerGui:FindFirstChild("Chat")
                if chatGui then
                    for _, v in ipairs(chatGui:GetDescendants()) do
                        if v:IsA("TextBox") then
                            chatInput = v
                            break
                        end
                    end
                end
            end
        end

        if chatInput then
            chatInput.Text = "[NHYQ] " .. txt
            chatInput:CaptureFocus()
            task.wait(0.05)
            chatInput:ReleaseFocus(true)
        end
    end)
end

--==================================================
-- إرسال موحّد (يجرّب كل الطرق)
--==================================================
local function sendMessage()
    local txt = input.Text
    if txt == "" then return end
    if #txt > 200 then txt = txt:sub(1, 200) end

    print("📤 إرسال:", txt)
    print("   ChatVersion:", ChatSvc.ChatVersion)

    -- جرّب Legacy أولاً (أسرع)
    if ChatSvc.ChatVersion == Enum.ChatVersion.LegacyChatService then
        sendViaLegacy(txt)
    else
        -- النظام الجديد
        sendViaTextChat(txt)
        -- وبرضه جرّب Legacy (بعض الألعاب تستخدم الاثنين)
        sendViaLegacy(txt)
    end

    input.Text = ""
end

-- زر إرسال عبر الشات الرسمي (مضمون 100%)
local function sendViaOfficialChat()
    local txt = input.Text
    if txt == "" then return end
    if #txt > 200 then txt = txt:sub(1, 200) end

    print("📢 إرسال عبر الشات الرسمي:", txt)
    sendViaMainChatBox("[NHYQ] " .. txt)
    input.Text = ""
end

sendBtn.MouseButton1Click:Connect(sendMessage)
sendNormal.MouseButton1Click:Connect(sendViaOfficialChat)

input.FocusLost:Connect(function(enter)
    if enter then sendMessage() end
