MiniScroll.ScrollBarThickness = 2
MiniScroll.ScrollBarImageColor3 = Color3.fromRGB(180, 0, 0)
MiniScroll.CanvasSize        = UDim2.new(0, 0, 0, 0)

local MiniList = Instance.new("UIListLayout", MiniScroll)
MiniList.SortOrder = Enum.SortOrder.LayoutOrder
MiniList.Padding   = UDim.new(0, 3)

-- قائمة اللاعبين
local targetList = {"All"}
local currentIndex = 1

local function updateTargetList()
    local prev = targetList[currentIndex] or "All"
    targetList = {"All"}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            table.insert(targetList, p.Name)
        end
    end
    currentIndex = 1
    for i, n in ipairs(targetList) do
        if n == prev then currentIndex = i; return end
    end
end
updateTargetList()

-- زر اختيار الهدف
local TargetBtn = Instance.new("TextButton", ChatBarFrame)
TargetBtn.Size             = UDim2.new(0, 80, 0, 30)
TargetBtn.Position         = UDim2.new(0, 5, 1, -35)
