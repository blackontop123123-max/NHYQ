--==================================================
-- 🔥 الإرسال عبر SayMessageRequest
--==================================================
local lastSend = 0

local function sendMsg()
    if not SayMsg then
        print("❌ SayMessageRequest مو موجود")
        return
    end
    
    local txt = input.Text
    if txt == "" then return end
    if #txt > 200 then txt = txt:sub(1, 200) end
    
    -- منع الباند (سيرفر يرفض لو أرسلنا بسرعة)
    local now = tick()
    if now - lastSend < 1.5 then
        print("⏳ انتظر شوي قبل الإرسال التالي")
        return
    end
    lastSend = now
    
    -- إرسال بصيغة Legacy Chat الرسمية
    pcall(function()
        SayMsg:FireServer(txt, "All")
    end)
    
    print("📤 أرسلت:", txt)
    input.Text = ""
end

sendBtn.MouseButton1Click:Connect(sendMsg)
input.FocusLost:Connect(function(enter)
    if enter then sendMsg() end
end)

print("✅ NHYQ Chat V3 Loaded")
print("SayMessageRequest:", SayMsg and SayMsg:GetFullName() or "NONE")
