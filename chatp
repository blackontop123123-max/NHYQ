--==================================================
-- 3) دوال مساعدة
--==================================================
local function showBubble(playerObj, text)
    pcall(function()
        local char = playerObj and playerObj.Character
        local head = char and char:FindFirstChild("Head")
        if head then
            ChatSvc:Chat(head, "[NHYQ] " .. text, Enum.ChatColor.Red)
        end
    end)
end

local function addMessage(senderName, msg, isPriv)
    local lbl = Instance.new("TextLabel", MiniScroll)
    lbl.Size                = UDim2.new(1, 0, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment      = Enum.TextXAlignment.Left
    lbl.Font                = Enum.Font.GothamBold
    lbl.TextSize            = 9
    lbl.TextWrapped         = true
    local badge = isPriv and "🔒" or "🔥"
    lbl.Text        = badge .. " " .. senderName .. ": " .. msg
    lbl.TextColor3  = isPriv and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 150, 100)

    if #MiniScroll:GetChildren() > 12 then
        local first = MiniScroll:FindFirstChildOfClass("TextLabel")
        if first then first:Destroy() end
    end

    local totalH = 0
    for _, c in ipairs(MiniScroll:GetChildren()) do
        if c:IsA("TextLabel") then totalH = totalH + 18 end
    end
    MiniScroll.CanvasSize = UDim2.new(0, 0, 0, totalH)
    MiniScroll.CanvasPosition = Vector2.new(0, math.max(0, totalH))
end

--==================================================
-- 4) إرسال الرسالة
--==================================================
local function sendMessage()
    local text = InputBox.Text
    if text == "" then return end

    updateTargetList()
    local target = targetList[currentIndex] or "All"

    -- (أ) فوق رأسك — الكل يشوفها
    showBubble(localPlayer, (target == "All") and ("[All] " .. text) or ("[" .. target .. "] " .. text))

    -- (ب) إرسال عبر RemoteEvent إذا موجود
    if remoteEvent then
        pcall(function()
            remoteEvent:FireServer("SEND", localPlayer.Name, target, text)
        end)
    end

    -- (ج) عرض محلي
    addMessage(localPlayer.Name .. " ➔ " .. target, text, target ~= "All")
    InputBox.Text = ""
end

SendBtn.MouseButton1Click:Connect(sendMessage)
InputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendMessage() end
end)

--==================================================
-- 5) استقبال الرسائل من الشبكة
--==================================================
if remoteEvent then
    remoteEvent.OnClientEvent:Connect(function(action, senderName, target, msg)
        if action ~= "SEND" then return end
        if type(senderName) ~= "string" or type(msg) ~= "string" then return end
        if senderName == localPlayer.Name then return end -- ما نكرر رسالتنا

        -- إذا الرسالة لك أو للكل
        if target == "All" or target == localPlayer.Name then
            local sender = Players:FindFirstChild(senderName)
            if sender then
                showBubble(sender, (target == "All") and ("[All] " .. msg) or ("[You] " .. msg))
            end
            local isPriv = (target ~= "All")
            local lbl = isPriv and (senderName .. " ➔ " .. target) or senderName
            addMessage(lbl, msg, isPriv)
        end
    end)
end

print("✅ NHYQ Chat Bar Loaded! Remote:", remoteEvent and remoteEvent:GetFullName() or "NONE")
