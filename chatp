local function AddMessage(roomName, Text, ColorOverride, isRemoteRoom)
    if Closed or not ChatGui.Parent then return end

    local targetHistory = (roomName == ROOM_NAME_1) and HistoryRoom1 or HistoryRoom2
    table.insert(targetHistory, {text = Text, color = ColorOverride, remote = isRemoteRoom})
    while #targetHistory > MAX_MESSAGES do
        table.remove(targetHistory, 1)
    end

    if ACTIVE_ROOM == roomName then
        MessageOrder += 1
        local Label = Instance.new("TextLabel")
        Label.Name = "ChatMessage"
        Label.LayoutOrder = MessageOrder
        Label.BackgroundTransparency = 1
        Label.Size = UDim2.new(1, -4, 0, isRemoteRoom and 24 or 18)
        Label.AutomaticSize = Enum.AutomaticSize.Y
        Label.Text = tostring(Text)
        Label.TextColor3 = ColorOverride or Color3.fromRGB(255, 160, 120)
        Label.TextSize = isRemoteRoom and 13 or 10.5
        Label.Font = Enum.Font.GothamBold
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.TextWrapped = true
        Label.RichText = true
        Label.Parent = MiniScroll

        task.defer(function()
            if Closed or not MiniScroll.Parent then return end
            MiniScroll.CanvasPosition = Vector2.new(0, math.max(0, MiniScroll.AbsoluteCanvasSize.Y - MiniScroll.AbsoluteSize.Y))
        end)
    end
end

