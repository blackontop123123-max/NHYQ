InputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
InputBox.TextSize = 9
InputBox.Font = Enum.Font.GothamMedium
Instance.new("UICorner", InputBox).CornerRadius = UDim.new(0, 5)
Instance.new("UIStroke", InputBox).Color = Color3.fromRGB(100, 0, 0)

local SendBtn = Instance.new("TextButton", ChatBarFrame)
SendBtn.Size = UDim2.new(0, 54, 0, 30)
SendBtn.Position = UDim2.new(1, -59, 1, -35)
SendBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
SendBtn.Text = "إرسال 🚀"
SendBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SendBtn.TextSize = 9
SendBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", SendBtn).CornerRadius = UDim.new(0, 5)

local ToggleBarBtn = Instance.new("TextButton")
ToggleBarBtn.Size = UDim2.new(0, 38, 0, 38)
ToggleBarBtn.Position = UDim2.new(0, 12, 0.5, -19)
ToggleBarBtn.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
ToggleBarBtn.Text = "💬"
ToggleBarBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
