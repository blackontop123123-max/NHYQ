local function SendPacket(roomName, Packet)
    if Closed then return false end
    local socket = (roomName == ROOM_NAME_1) and Socket1 or Socket2
    if not socket then return false end
    local Success = pcall(function()
        socket:Send(HttpService:JSONEncode(Packet))
    end)
    return Success
end

local function IsBlocked(Name)
    return BlockedPlayers[tostring(Name):lower()] == true
end

local function ProcessIncomingChat(roomName, senderName, rawText)
    if IsBlocked(senderName) then return end

    local userColorHex = GetUniqueColorHex(senderName)
    local isRemote = (roomName == ROOM_NAME_2)
    
    local targetUser, actualMsg = rawText:match("^@([^:]+):%s*(.+)$")
    local formattedText = ""

    if targetUser and actualMsg then
        if targetUser:lower() == Username:lower() or senderName:lower() == Username:lower() then
            formattedText = string.format("🔒 [<font color=\"%s\">%s</font> ➔ <font color=\"%s\">%s</font>]: %s", userColorHex, senderName, GetUniqueColorHex(targetUser), targetUser, actualMsg)
            AddMessage(roomName, formattedText, nil, isRemote)
            if roomName == ROOM_NAME_1 then
                showBubbleOnHead(senderName, actualMsg)
            end
            PlayNotificationSoundAndBanner(senderName, actualMsg)
            
            if not ChatBarFrame.Visible and senderName ~= Username then
                UnreadCount += 1
                BadgeLabel.Text = tostring(UnreadCount)
                BadgeLabel.Visible = true
            end
        end
    else
        formattedText = string.format("<font color=\"%s\">%s</font>: %s", userColorHex, senderName, rawText)
        AddMessage(roomName, formattedText, nil, isRemote)
        if roomName == ROOM_NAME_1 then
            showBubbleOnHead(senderName, rawText)
        end
        if senderName ~= Username then
            PlayNotificationSoundAndBanner(senderName, rawText)
            if not ChatBarFrame.Visible then
                UnreadCount += 1
                BadgeLabel.Text = tostring(UnreadCount)
                BadgeLabel.Visible = true
            end
        end
    end
end

local function HandleMessage(roomName, RawMessage)
    local Success, Data = pcall(function()
        return HttpService:JSONDecode(tostring(RawMessage))
    end)
    if not Success or type(Data) ~= "table" then return end

    local activePlayers = (roomName == ROOM_NAME_1) and RoomActivePlayers1 or RoomActivePlayers2

    if Data.type == "joined" then
        activePlayers[Username] = true
        if roomName == ACTIVE_ROOM then updateActiveUsersDisplay() end
        if type(Data.history) == "table" then
            for _, Entry in ipairs(Data.history) do
                if type(Entry) == "table" and type(Entry.username) == "string" then
                    activePlayers[Entry.username] = true
                end
                if type(Entry) == "table" and type(Entry.payload) == "table" and Entry.payload.type == "chat" then
                    ProcessIncomingChat(roomName, tostring(Entry.username), tostring(Entry.payload.text))
                end
            end
        end
        if roomName == ACTIVE_ROOM then updateActiveUsersDisplay() end

    elseif Data.type == "say" then
        if type(Data.username) == "string" then
            activePlayers[Data.username] = true
            if roomName == ACTIVE_ROOM then updateActiveUsersDisplay() end
        end
        if type(Data.payload) == "table" and Data.payload.type == "chat" then
            ProcessIncomingChat(roomName, tostring(Data.username), tostring(Data.payload.text))
        end

    elseif Data.type == "user-joined" then
        local uName = tostring(Data.username)
        activePlayers[uName] = true
        if roomName == ACTIVE_ROOM then updateActiveUsersDisplay() end

    elseif Data.type == "user-left" then
        local uName = tostring(Data.username)
        activePlayers[uName] = nil
        if roomName == ACTIVE_ROOM then updateActiveUsersDisplay() end
    end
end

-- تشغيل الاتصال الدائم لكل روم في الخلفية بشكل مستقل
local function InitializeSockets()
    local wsConnect = WebSocket and WebSocket.connect or syn and syn.websocket and syn.websocket.connect or Krnl and Krnl.WebSocket and Krnl.WebSocket.connect
    if not wsConnect then return end

    -- اتصال روم نفس السيرفر (Room 8)
    task.spawn(function()
        local success, res = pcall(function() return wsConnect(ENDPOINT) end)
        if success and res then
            Socket1 = res
            Socket1.OnMessage:Connect(function(msg) HandleMessage(ROOM_NAME_1, msg) end)
            Socket1.OnClose:Connect(function() Socket1 = nil end)
            task.wait(0.3)
            SendPacket(ROOM_NAME_1, {type = "join", room = ROOM_NAME_1, username = Username})
        end
    end)

    -- اتصال روم غير السيرفر (Room 4)
    task.spawn(function()
        local success, res = pcall(function() return wsConnect(ENDPOINT) end)
        if success and res then
            Socket2 = res
            Socket2.OnMessage:Connect(function(msg) HandleMessage(ROOM_NAME_2, msg) end)
            Socket2.OnClose:Connect(function() Socket2 = nil end)
            task.wait(0.3)
            SendPacket(ROOM_NAME_2, {type = "join", room = ROOM_NAME_2, username = Username})
        end
    end)
end

