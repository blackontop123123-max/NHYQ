local function GetUniqueColorForName(name)
    local hash = 0
    for i = 1, #name do
        hash = (hash * 31 + string.byte(name, i)) % 360
    end
    local hue = hash / 360
    local c = Color3.fromHSV(hue, 0.9, 1)
    return c
end

local function GetUniqueColorHex(name)
    local c = GetUniqueColorForName(name)
    local r = math.floor(c.R * 255)
    local g = math.floor(c.G * 255)
    local b = math.floor(c.B * 255)
    return string.format("#%02X%02X%02X", r, g, b)
end

