local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local CoreGui = game:GetService("CoreGui")
local localPlayer = Players.LocalPlayer

-- 1) إنشاء قناة شات خاصة
local channelName = "NHYQ_Private_Chat"
local channel

-- نحاول نلقى القناة إذا موجودة، أو ننشئها
local textChannels = TextChatService:FindFirstChild("TextChannels")
if textChannels then
    channel = textChannels:FindFirstChild(channelName)
    if not channel then
        channel = Instance.new("TextChannel")
        channel.Name = channelName
        channel.Parent = textChannels
    end
end

