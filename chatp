ToggleBarBtn.MouseButton1Click:Connect(function()
	ChatBarFrame.Visible = not ChatBarFrame.Visible
end)

-- إظهار فقاعة الكلام
local function showBubbleOnHead(targetPlayer, msgText)
	pcall(function()
		local char = targetPlayer.Character
		if char then
			local head = char:FindFirstChild("Head")
			if head then
				chatService:Chat(head, "[NHYQ] " .. msgText, Enum.ChatColor.Red)
			end
		end
	end)
end

local function addMessageToBar(senderName, msgText, isPrivate)
	local label = Instance.new("TextLabel", MiniScroll)
	label.Size = UDim2.new(1, 0, 0, 15)
	label.BackgroundTransparency = 1
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamBold
	label.TextSize = 8.5
	local badge = isPrivate and "🔒" or "🔥"
	label.Text = badge .. " " .. senderName .. ": " .. msgText
	label.TextColor3 = isPrivate and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 150, 100)

	if #MiniScroll:GetChildren() > 10 then
		local firstChild = MiniScroll:FindFirstChildOfClass("TextLabel")
		if firstChild then firstChild:Destroy() end
	end
	local totalH = 0
	for _, child in ipairs(MiniScroll:GetChildren()) do
		if child:IsA("TextLabel") then totalH = totalH + 16 end
	end
	MiniScroll.CanvasSize = UDim2.new(0, 0, 0, totalH)
	MiniScroll.CanvasPosition = Vector2.new(0, MiniScroll.CanvasSize.Y.Offset)
end

--==================================================
-- 🔥 إرسال الرسالة (الحل الأساسي)
--==================================================
local function handleSendMessage()
	local text = InputBox.Text
	if text == "" then return end

	updateTargetList()
	local targetName = targetList[currentIndex] or "All"

	-- الخيار 1: إذا فيه RemoteEvent موجود نستخدمه
	if remoteEvent then
		pcall(function()
			remoteEvent:FireServer(targetName, text)
		end)
	end

	-- الخيار 2: نستخدم ChatService (يظهر فوق الرأس للجميع)
	local myChar = localPlayer.Character
	if myChar then
		local myHead = myChar:FindFirstChild("Head")
		if myHead then
			local displayMsg = targetName == "All" and ("[All] " .. text) or ("[" .. targetName .. "] " .. text)
			chatService:Chat(myHead, "[NHYQ] " .. displayMsg, Enum.ChatColor.Red)
		end
	end

	-- إضافة الرسالة في الشريط المحلي
	addMessageToBar(localPlayer.Name .. " ➔ " .. targetName, text, targetName ~= "All")

	InputBox.Text = ""
end

SendBtn.MouseButton1Click:Connect(handleSendMessage)
InputBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then handleSendMessage() end
end)

-- استقبال (إذا فيه RemoteEvent يعمل)
if remoteEvent then
	remoteEvent.OnClientEvent:Connect(function(action, sName, targetMode, msg)
		if action == "Receive" and type(sName) == "string" then
			if targetMode == "All" or targetMode == localPlayer.Name then
				local isPriv = (targetMode ~= "All")
				local pObj = players:FindFirstChild(sName)
				if pObj then
					showBubbleOnHead(pObj, msg)
				end
				local displayTarget = isPriv and (sName .. " ➔ " .. targetMode) or sName
				addMessageToBar(displayTarget, msg, isPriv)
			end
		end
	end)
end

print("NHYQ Chat Bar Loaded!")
