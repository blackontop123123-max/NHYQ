--==================================================
-- أبسط شات فوق الرأس (يشتغل إذا اللعبة تسمح)
--==================================================

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- إنشاء واجهة صغيرة للكتابة
local gui = Instance.new("ScreenGui")
gui.Name = "SimpleChat"
gui.ResetOnSpawn = false
gui.Parent = localPlayer:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 60, 0, 60)
btn.Position = UDim2.new(0, 20, 0.5, -30)
btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
btn.Text = "شات"
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.TextSize = 16
btn.Font = Enum.Font.GothamBold
btn.Draggable = true
Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

local input = Instance.new("TextBox", gui)
input.Size = UDim2.new(0, 200, 0, 40)
input.Position = UDim2.new(0, 90, 0.5, -20)
input.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
input.PlaceholderText = "اكتب هنا..."
input.Text = ""
input.TextColor3 = Color3.fromRGB(255, 255, 255)
input.TextSize = 14
input.Visible = false
Instance.new("UICorner", input).CornerRadius = UDim.new(0, 8)

btn.MouseButton1Click:Connect(function()
    input.Visible = not input.Visible
    if input.Visible then input:CaptureFocus() end
end)

-- الدالة اللي تظهر الفقاعة فوق راسك
local function showBubble(text)
    local char = localPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    -- إزالة الفقاعة القديمة
    local old = head:FindFirstChild("MyBubble")
    if old then old:Destroy() end

    -- إنشاء الفقاعة
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MyBubble"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local bg = Instance.new("Frame", billboard)
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    bg.BackgroundTransparency = 0.2
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", bg).Color = Color3.fromRGB(200, 0, 0)

    local lbl = Instance.new("TextLabel", bg)
    lbl.Size = UDim2.new(1, -10, 1, -10)
    lbl.Position = UDim2.new(0, 5, 0, 5)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextSize = 14
    lbl.Font = Enum.Font.GothamBold
    lbl.TextWrapped = true

    -- تختفي بعد 5 ثواني
    task.delay(5, function()
        if billboard and billboard.Parent then
            billboard:Destroy()
        end
    end)
end

-- عند الضغط على Enter
input.FocusLost:Connect(function(enterPressed)
    if enterPressed and input.Text ~= "" then
        showBubble(input.Text)
        input.Text = ""
        input.Visible = false
    end
end)
