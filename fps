-- وظيفة زر الإغلاق والفتح
local isOpen = true
toggleButton.MouseButton1Click:Connect(function()
	isOpen = not isOpen
	mainFrame.Visible = isOpen
	if isOpen then
		toggleButton.Text = "-"
	else
		toggleButton.Text = "+"
	end
end)

-- حساب الوقت والـ FPS والـ Ping تلقائياً
local startTime = tick()
local lastUpdate = 0
local frameCount = 0

RunService.RenderStepped:Connect(function(dt)
	frameCount = frameCount + 1
	local currentTime = tick()
	
	if currentTime - lastUpdate >= 1 then
		local fps = math.floor(frameCount / (currentTime - lastUpdate))
		fpsLabel.Text = "F P S: " .. tostring(fps)
		
		local p = 0
		pcall(function()
			p = math.floor(player:GetNetworkPing() * 1000)
		end)
		pingLabel.Text = "Ping: " .. tostring(p) .. "ms"
		
		local totalSeconds = math.floor(currentTime - startTime)
		local minutes = math.floor(totalSeconds / 60)
		local seconds = totalSeconds % 60
		timeLabel.Text = string.format("Time: %02d:%02d", minutes, seconds)
		
		frameCount = 0
		lastUpdate = currentTime
	end
end)
