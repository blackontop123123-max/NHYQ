-- ====== دوال مساعدة ======
local function createGlow(parent, color, trans, size)
    local g = Instance.new("ImageLabel")
    g.Size = UDim2.new(1, size or 18, 1, size or 18)
    g.Position = UDim2.new(0, -(size or 18)/2, 0, -(size or 18)/2)
    g.BackgroundTransparency = 1
    g.Image = "rbxassetid://5554236805"
    g.ImageColor3 = color or C.accent
    g.ImageTransparency = trans or 0.55
    g.ScaleType = Enum.ScaleType.Slice
    g.SliceCenter = Rect.new(23, 23, 277, 277)
    g.ZIndex = 0
    g.Parent = parent
    return g
end

local function createGlassFrame(parent, size, pos, color)
    local f = Instance.new("Frame")
    f.Size = size
    f.Position = pos
    f.BackgroundColor3 = color or C.glass
    f.BackgroundTransparency = 0.92
    f.BorderSizePixel = 0
    f.ClipsDescendants = true
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 16)
    local s = Instance.new("UIStroke", f)
    s.Color = C.accent
    s.Thickness = 1.2
    s.Transparency = 0.55
    return f
end

-- ====== وظائف التنفيذ ======
local function sendHDAdminCommand(cmd)
    if cmd == "" then return end
    local hdAdmin = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
    if hdAdmin then
        local signals = hdAdmin:FindFirstChild("Signals")
        if signals then
            local requestCmd = signals:FindFirstChild("RequestCommand")
            if requestCmd then
                pcall(function() requestCmd:InvokeServer(cmd) end)
            end
        end
    end
end

