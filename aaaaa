    ReplicatedStorage.DescendantAdded:Connect(function(obj)
        if protectEnabled and obj:IsA("RemoteEvent") and obj.Name:lower():find("executeclientcommand") then
            obj:Destroy()
        end
    end)

    local function isBlocked(name)
        name = name:lower()
        for _, w in ipairs(blockedWords) do
            if name:find(w, 1, true) then return true end
        end
    end

    local function blockGui(g)
        if protectEnabled and isBlocked(g.Name) and g.Name ~= "NHYQ_HUB" and g.Name ~= "NHYQSquareBtn" then
            g:Destroy()
        end
    end

    PlayerGui.ChildAdded:Connect(function(c)
        task.wait(0.02)
        blockGui(c)
    end)

    task.spawn(function()
        while true do
            if protectEnabled then
                for _, g in ipairs(PlayerGui:GetChildren()) do blockGui(g) end
            end
            task.wait(0.3)
        end
    end)

    protectToggleBtn.MouseButton1Click:Connect(function()
        protectEnabled = not protectEnabled
        if protectEnabled then
            protectToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 20, 60)
            protectToggleBtn.Text = "شغال"
            nukeRemote()
            setStatus("🛡️ تم تفعيل حماية NHYQ")
        else
            protectToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 30, 40)
            protectToggleBtn.Text = "تشغيل"
            setStatus("⚠️ تم إيقاف حماية NHYQ")
        end
    end)
end

