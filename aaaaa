    local function buildCopy(name, prefix, cmds)
        prefix = (prefix ~= "" and prefix) or ";"
        local parts = {}
        for i = 1, 10 do
            local line = ""
            for j, cmd in ipairs(cmds) do
                if j == 1 then
                    line = prefix .. cmd .. " " .. name
                else
                    line = line .. " " .. prefix .. cmd .. " " .. name
                end
            end
            parts[i] = line
        end
        return table.concat(parts, " ")
    end

