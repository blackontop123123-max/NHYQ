            closeBtn.ZIndex = 901
            Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(1, 0)

            local speedLabel = Instance.new("TextLabel", panel)
            speedLabel.Size = UDim2.new(1, -16, 0, 18)
            speedLabel.Position = UDim2.new(0, 8, 0, 30)
            speedLabel.BackgroundTransparency = 1
            speedLabel.Text = string.format("Speed: %.2fs (%.1f CPS)", state.interval, 1/state.interval)
            speedLabel.Font = Enum.Font.Gotham
            speedLabel.TextSize = 11
            speedLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
            speedLabel.TextXAlignment = Enum.TextXAlignment.Left
            speedLabel.ZIndex = 901

            local function updateSpeedLabel()
                speedLabel.Text = string.format("Speed: %.2fs (%.1f CPS)", state.interval, 1/state.interval)
            end

            local slowerBtn = Instance.new("TextButton", panel)
            slowerBtn.Size = UDim2.new(0, 40, 0, 30)
            slowerBtn.Position = UDim2.new(0, 8, 0, 54)
            slowerBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            slowerBtn.Text = "-"
            slowerBtn.Font = Enum.Font.GothamBlack
            slowerBtn.TextSize = 18
            slowerBtn.TextColor3 = Color3.fromRGB(230,230,230)
            slowerBtn.BorderSizePixel = 0
            slowerBtn.ZIndex = 901
            Instance.new("UICorner", slowerBtn).CornerRadius = UDim.new(0, 8)

            local fasterBtn = Instance.new("TextButton", panel)
            fasterBtn.Size = UDim2.new(0, 40, 0, 30)
            fasterBtn.Position = UDim2.new(0, 54, 0, 54)
            fasterBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            fasterBtn.Text = "+"
            fasterBtn.Font = Enum.Font.GothamBlack
            fasterBtn.TextSize = 18
            fasterBtn.TextColor3 = Color3.fromRGB(230,230,230)
            fasterBtn.BorderSizePixel = 0
            fasterBtn.ZIndex = 901
            Instance.new("UICorner", fasterBtn).CornerRadius = UDim.new(0, 8)

            local toggleBtn = Instance.new("TextButton", panel)
            toggleBtn.Size = UDim2.new(0, 80, 0, 30)
            toggleBtn.Position = UDim2.new(0, 102, 0, 54)
            toggleBtn.BackgroundColor3 = COLOR_OFF
            toggleBtn.Text = "START"
            toggleBtn.Font = Enum.Font.GothamBlack
            toggleBtn.TextSize = 13
            toggleBtn.TextColor3 = Color3.fromRGB(255,255,255)
            toggleBtn.BorderSizePixel = 0
            toggleBtn.ZIndex = 901
            Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 8)

            closeBtn.MouseButton1Click:Connect(function()
                if state.clicking then
                    state.clicking = false
                    if clickThread then
                        task.cancel(clickThread)
                        clickThread = nil
                    end
                end
                gui:Destroy()
                print("🔴 تم إغلاق Auto Clicker")
            end)

            local clickThread

            local function performClick()
                local pos = target.AbsolutePosition + target.AbsoluteSize / 2
                VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 0)
                task.wait(0.01)
                VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
            end

            local function startClicking()
                state.clicking = true
                toggleBtn.Text = "STOP"
                toggleBtn.BackgroundColor3 = COLOR_ON
                targetStroke.Color = COLOR_ON

                clickThread = task.spawn(function()
                    while state.clicking do
                        performClick()
                        task.wait(state.interval)
                    end
                end)
            end

            local function stopClicking()
                state.clicking = false
                toggleBtn.Text = "START"
                toggleBtn.BackgroundColor3 = COLOR_OFF
                targetStroke.Color = Color3.fromRGB(255, 100, 100)
            end

            toggleBtn.MouseButton1Click:Connect(function()
                if state.clicking then
                    stopClicking()
                else
                    startClicking()
                end
            end)

            slowerBtn.MouseButton1Click:Connect(function()
                state.interval = math.min(state.maxInterval, state.interval + state.step)
                updateSpeedLabel()
            end)

            fasterBtn.MouseButton1Click:Connect(function()
                state.interval = math.max(state.minInterval, state.interval - state.step)
                updateSpeedLabel()
            end)

            updateSpeedLabel()
            print("✅ Auto Clicker جاهز - زر X يحذف كل شيء")
        ]]
        
