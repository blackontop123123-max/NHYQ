local function ApplyThemeFull()
    local theme = T()
    
    if State.MainFrame then
        State.MainFrame.BackgroundColor3 = theme.Bg
        State.MainFrame.BackgroundTransparency = 0.05
        
        local glass = State.MainFrame:FindFirstChild("GlassEffect")
        if glass then
            glass.BackgroundColor3 = theme.Bg2
            glass.BackgroundTransparency = 0.85
        end
        
        local glowStroke = State.MainFrame:FindFirstChildOfClass("UIStroke")
        if glowStroke then
            glowStroke.Color = theme.Glow
            local grad = glowStroke:FindFirstChildOfClass("UIGradient")
            if grad then
                grad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, theme.Glow),
                    ColorSequenceKeypoint.new(0.5, theme.Accent),
                    ColorSequenceKeypoint.new(1, theme.Glow),
                })
            end
        end
    end
    
    local titleBar = State.MainFrame and State.MainFrame:FindFirstChild("TitleBar")
    if titleBar then
        titleBar.BackgroundColor3 = theme.Bg2
        titleBar.BackgroundTransparency = 0.2
        
        local titleLabel = titleBar:FindFirstChildOfClass("TextLabel")
        if titleLabel then
            local grad = titleLabel:FindFirstChildOfClass("UIGradient")
            if grad then
                grad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, theme.Glow),
                    ColorSequenceKeypoint.new(0.5, theme.Accent),
                    ColorSequenceKeypoint.new(1, theme.Glow),
                })
            end
        end
    end
    
    local sidebar = State.MainFrame and State.MainFrame:FindFirstChild("Sidebar")
    if sidebar then
        sidebar.BackgroundColor3 = theme.Bg2
        sidebar.BackgroundTransparency = 0.3
        
        local stroke = sidebar:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = theme.Border
        end
    end
    
    local tabBtns = State.MainFrame and State.MainFrame:FindFirstChild("ContentArea") and State.MainFrame.ContentArea:FindFirstChild("Sidebar")
    if tabBtns then
        for _, child in ipairs(tabBtns:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = theme.Accent
                child.BackgroundTransparency = 1
                child.TextColor3 = theme.Inner
                
                local indicator = child:FindFirstChild("Indicator")
                if indicator then
                    indicator.BackgroundColor3 = theme.Accent
                end
            end
        end
    end
    
    local contentArea = State.MainFrame and State.MainFrame:FindFirstChild("ContentArea")
    if contentArea then
        for _, page in ipairs(contentArea:GetChildren()) do
            if page:IsA("Frame") then
                for _, card in ipairs(page:GetChildren()) do
                    if card:IsA("Frame") and card.Name ~= "GlassEffect" then
                        local stroke = card:FindFirstChildOfClass("UIStroke")
                        if stroke then
                            stroke.Color = theme.Border
                        end
                        card.BackgroundColor3 = theme.Card
                        
                        for _, label in ipairs(card:GetDescendants()) do
                            if label:IsA("TextLabel") then
                                if label.Name == "StatsLabel_FPS" or label.Name == "StatsLabel_Ping" or label.Name == "StatsLabel_Players" then
                                    label.TextColor3 = theme.Accent
                                elseif label.Text == "الإحصائيات الحية" or label.Text == "معلومات اللاعب" or label.Text == "إرسال إشعار" then
                                    label.TextColor3 = theme.Accent
                                elseif label.Name == "PlayerNameLabel" or label.Name == "PlayerIdLabel" or label.Name == "DeviceLabel" or label.Name == "PlaceLabel" then
                                    label.TextColor3 = theme.Accent
                                else
                                    label.TextColor3 = theme.Text
                                end
                            end
                            if label:IsA("TextButton") then
                                if label.Text == "إرسال للسيرفر" or label.Text == "التحقق من الهوية" then
                                    label.BackgroundColor3 = theme.Accent
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    if State.ToggleBtn then
        local stroke = State.ToggleBtn:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = theme.Glow
            local grad = stroke:FindFirstChildOfClass("UIGradient")
            if grad then
                grad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, theme.Glow),
                    ColorSequenceKeypoint.new(0.5, theme.Accent),
                    ColorSequenceKeypoint.new(1, theme.Glow),
                })
            end
        end
    end
    
    local notifContainer = CoreGui:FindFirstChild(GUI_NAME) and CoreGui[GUI_NAME]:FindFirstChild("NotifContainer")
    if notifContainer then
        for _, notif in ipairs(notifContainer:GetChildren()) do
            if notif:IsA("Frame") then
                notif.BackgroundColor3 = theme.Bg
                local stroke = notif:FindFirstChildOfClass("UIStroke")
                if stroke then
                    stroke.Color = theme.Border
                end
                for _, child in ipairs(notif:GetDescendants()) do
                    if child:IsA("TextLabel") then
                        if child.Text == "إشعار" then
                            child.TextColor3 = theme.Title
                        else
                            child.TextColor3 = theme.Text
                        end
                    end
                end
            end
        end
    end
    
    State.ThemeRefresh = State.ThemeRefresh + 1
end

