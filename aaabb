            centerDot.Size = UDim2.new(1, 0, 1, 0)
            centerDot.BackgroundTransparency = 1
            centerDot.Text = "+"
            centerDot.TextColor3 = Color3.fromRGB(255, 255, 255)
            centerDot.TextScaled = true
            centerDot.ZIndex = 1001

            makeDraggable(target)

            local panel = Instance.new("Frame")
