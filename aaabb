        TextSize = 14,
        TextColor3 = theme.Accent,
        ZIndex = 22,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    
    for i, th in ipairs(Themes) do
        local btn = MakeBtn(settingsScroll, {
            Size = UDim2.new(1,0,0,38),
            BackgroundColor3 = th.Bg,
            BackgroundTransparency = 0.2,
            ZIndex = 22,
        }, function()
            State.CurrentTheme = i
            ApplyThemeFull()
            Notif:Send("", "الثيم", "تم تطبيق: " .. th.Name, th.Accent)
        end)
        C(btn, 10)
        S(btn, th.Border, 1.5, 0.3)
        
        local dot = MakeFrame(btn, {
            Size = UDim2.new(0,12,0,12),
            Position = UDim2.new(0,12,0.5,-6),
            BackgroundColor3 = th.Accent,
            ZIndex = 23,
        })
        C(dot, 999)
        
        MakeLabel(btn, {
            Text = th.Name,
            Size = UDim2.new(1,-36,1,0),
            Position = UDim2.new(0,32,0,0),
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextColor3 = th.Title,
            ZIndex = 23,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
    end
    
    -- ==============================================================================
    --  الزر العائم القابل للحركة
    -- ==============================================================================
    
    local toggleBtn = Instance.new("ImageButton")
    toggleBtn.Name = "ToggleBtn"
    toggleBtn.Size = UDim2.new(0, 70, 0, 70)
    toggleBtn.Position = UDim2.new(0, 16, 0.5, -35)
    toggleBtn.BackgroundTransparency = 1
    toggleBtn.Image = TOGGLE_IMAGE
    toggleBtn.ScaleType = Enum.ScaleType.Fit
    toggleBtn.BorderSizePixel = 0
    toggleBtn.ZIndex = 100
    toggleBtn.AutoButtonColor = false
    toggleBtn.Parent = screenGui
    
    State.ToggleBtn = toggleBtn
    
    local toggleGlow = Instance.new("UIStroke")
    toggleGlow.Color = theme.Glow
    toggleGlow.Thickness = 3
    toggleGlow.Transparency = 0.3
    toggleGlow.Parent = toggleBtn
    local tGrad = Instance.new("UIGradient")
    tGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.Glow),
        ColorSequenceKeypoint.new(0.5, theme.Accent),
        ColorSequenceKeypoint.new(1, theme.Glow),
    })
    tGrad.Parent = toggleGlow
    
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 999)
    
    task.spawn(function()
        local r = 0
        while toggleGlow and toggleGlow.Parent do
            local g = toggleGlow:FindFirstChildOfClass("UIGradient")
            if g then g.Rotation = r%360 end
            r = r + 1.5
            task.wait(0.04)
        end
    end)
    
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    toggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = toggleBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local newX = startPos.X.Offset + delta.X
            local newY = startPos.Y.Offset + delta.Y
            
            local viewport = workspace.CurrentCamera.ViewportSize
            newX = math.clamp(newX, 0, viewport.X - 70)
            newY = math.clamp(newY, 0, viewport.Y - 70)
            
            toggleBtn.Position = UDim2.new(0, newX, 0, newY)
        end
    end)
    
    toggleBtn.MouseButton1Click:Connect(function()
        if main.Visible and main.Size.X.Offset > 10 then
            Tween(main, {Size=UDim2.new(0,0,0,0), Position=UDim2.new(0.5,0,0.5,0)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In):Play()
            task.wait(0.35)
            main.Visible = false
        else
            main.Visible = true
            Tween(main, {Size=UDim2.new(0,790,0,540), Position=UDim2.new(0.5,-395,0.5,-270)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        end
    end)
    
    toggleBtn.MouseEnter:Connect(function()
        Tween(toggleBtn, {Size = UDim2.new(0, 76, 0, 76)}, 0.15, Enum.EasingStyle.Back):Play()
    end)
    toggleBtn.MouseLeave:Connect(function()
        Tween(toggleBtn, {Size = UDim2.new(0, 70, 0, 70)}, 0.15, Enum.EasingStyle.Back):Play()
    end)
    
    -- ==============================================================================
    --  تحديث الإحصائيات
    -- ==============================================================================
    
    local statsRef = main:FindFirstChild("ContentArea") and main.ContentArea:FindFirstChild("الرئيسية") and main.ContentArea["الرئيسية"]:FindFirstChild("StatsCard")
    local frameCount, lastFPS = 0, tick()
    
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        if tick() - lastFPS >= 1 then
            State.Stats.FPS = frameCount
            frameCount = 0
            lastFPS = tick()
            State.Stats.Ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            
            if statsRef then
                local fps = statsRef:FindFirstChild("StatsLabel_FPS")
                local ping = statsRef:FindFirstChild("StatsLabel_Ping")
                if fps then fps.Text = State.Stats.FPS end
                if ping then ping.Text = State.Stats.Ping .. " ms" end
            end
        end
    end)
    
    Tween(main, {Size=UDim2.new(0,790,0,540)}, 0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
    
    ApplyThemeFull()
    
    Notif:Send("", "أهلاً بك!", "ANA HUB V5.0 — جاهز للاستخدام", theme.Accent)
end

