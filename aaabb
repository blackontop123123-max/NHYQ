local Particles = { Container = nil, Items = {}, Running = false }

function Particles:Init(parent)
    self.Container = MakeFrame(parent, {
        Size = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 2,
    })
end

function Particles:Start()
    if self.Running then return end
    self.Running = true
    task.spawn(function()
        while self.Running do
            local theme = T()
            while #self.Items < 25 do
                local p = MakeFrame(self.Container, {
                    Size = UDim2.new(0, math.random(2,5), 0, math.random(2,5)),
                    Position = UDim2.new(math.random(), 0, math.random(), 0),
                    BackgroundColor3 = theme.Accent,
                    BackgroundTransparency = math.random(60,90)/100,
                    ZIndex = 3,
                })
                C(p, 999)
                table.insert(self.Items, {
                    obj = p,
                    vx = (math.random()-0.5)*0.003,
                    vy = (math.random()-0.5)*0.003,
                })
            end
            for _, d in ipairs(self.Items) do
                local pos = d.obj.Position
                local nx = math.clamp(pos.X.Scale + d.vx, 0, 1)
                local ny = math.clamp(pos.Y.Scale + d.vy, 0, 1)
                if nx<=0 or nx>=1 then d.vx = -d.vx end
                if ny<=0 or ny>=1 then d.vy = -d.vy end
                d.obj.Position = UDim2.new(nx,0,ny,0)
                d.obj.BackgroundColor3 = T().Accent
                d.obj.Visible = State.LiveBg
            end
            task.wait(0.06)
        end
    end)
end

