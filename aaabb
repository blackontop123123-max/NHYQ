        end
        
        local scriptText = [[
            local Players = game:GetService("Players")
            local UIS = game:GetService("UserInputService")
            local VIM = game:GetService("VirtualInputManager")
            local player = Players.LocalPlayer

            local state = {
                clicking = false,
                interval = 0.15,
                minInterval = 0.02,
                maxInterval = 1.0,
                step = 0.02,
            }

            local COLOR_ON = Color3.fromRGB(80, 220, 130)
            local COLOR_OFF = Color3.fromRGB(255, 90, 100)
            local COLOR_BG = Color3.fromRGB(18, 18, 24)

            local function makeDraggable(frame, handle)
                handle = handle or frame
                local dragging, dragStart, startPos

                handle.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        dragStart = input.Position
                        startPos = frame.Position
                    end
                end)

                handle.InputEnded:Connect(function()
                    dragging = false
                end)

                UIS.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local delta = input.Position - dragStart
                        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                    end
                end)
            end

            local gui = Instance.new("ScreenGui")
            gui.Name = "AutoClickerGUI"
            gui.ResetOnSpawn = false
            gui.IgnoreGuiInset = true
            gui.Parent = player:WaitForChild("PlayerGui")

            local target = Instance.new("ImageButton")
            target.Name = "ClickTarget"
            target.Size = UDim2.new(0, 30, 0, 30)
            target.Position = UDim2.new(0.5, -15, 0.5, -15)
            target.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            target.AutoButtonColor = false
            target.BorderSizePixel = 0
            target.ZIndex = 1000
            target.Parent = gui
            Instance.new("UICorner", target).CornerRadius = UDim.new(1, 0)

            local targetStroke = Instance.new("UIStroke", target)
            targetStroke.Color = Color3.fromRGB(255, 100, 100)
            targetStroke.Thickness = 2

