end

function Notif:Send(icon, title, msg, color)
    if not self.Container then return end
    local theme = T()
    local color = color or theme.Accent
    
    local notif = MakeFrame(self.Container, {
        Size = UDim2.new(1, 0, 0, 72),
        BackgroundColor3 = theme.Bg,
        BackgroundTransparency = 0.05,
        ZIndex = 201,
        Position = UDim2.new(1, 20, 0, 0),
    })
    C(notif, 14)
    local stroke = S(notif, color, 1.5, 0.2)
    
    local bar = MakeFrame(notif, {
        Size = UDim2.new(0, 4, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = color,
        ZIndex = 202,
    })
    C(bar, 4)
    
    MakeLabel(notif, {
        Text = icon or "",
        Size = UDim2.new(0, 32, 0, 32),
        Position = UDim2.new(0, 18, 0.5, -16),
        TextColor3 = color,
        Font = Enum.Font.GothamBold,
        TextSize = 20,
        ZIndex = 202,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    
    MakeLabel(notif, {
        Text = title or "إشعار",
        Size = UDim2.new(1, -70, 0, 24),
        Position = UDim2.new(0, 58, 0, 8),
        TextColor3 = theme.Title,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        ZIndex = 202,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    
    MakeLabel(notif, {
        Text = msg or "",
        Size = UDim2.new(1, -70, 0, 28),
        Position = UDim2.new(0, 58, 0, 32),
        TextColor3 = theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        ZIndex = 202,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    })
    
    Tween(notif, { Position = UDim2.new(0, 0, 0, 0) }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
    
    task.delay(NOTIFICATION_DURATION, function()
        if notif and notif.Parent then
            Tween(notif, { Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1 }, 0.3):Play()
            task.wait(0.35)
            if notif and notif.Parent then notif:Destroy() end
        end
    end)
end

