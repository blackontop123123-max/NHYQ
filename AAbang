-- ==================== SPAM LOOP ====================
local spamTask = nil

local function formatCommandForTarget(rawCmd, target)
    local formatted = rawCmd:gsub("%f[%a]sa%f[%A]", target)
    return formatted
end

local function startCopy()
    cleanSelectedPlayers()
    
    if not isGamedMode then
        local target = getActivePlayer()
        if not target then
            startCopyBtn.Text = "اختر لاعب!"
            task.wait(1)
            startCopyBtn.Text = "تفعيل النسخ"
            return
        end
        
        local targetName
        local modeText
        if copyType == "virtual" then
            targetName = target
            modeText = "وهمي"
        elseif copyType == "normal" then
            targetName = target:sub(1, math.min(3, #target))
            modeText = "عادي"
        else
            targetName = target:sub(1, math.min(2, #target)):lower()
            modeText = "غامض"
        end
        
        activePlayerLabel.Text = "اللاعب النشط: " .. targetName .. " [" .. modeText .. "]"
        
        local commandLines = {}
        for line in commandsTextBox.Text:gmatch("[^\r\n]+") do
            if line ~= "" then table.insert(commandLines, line) end
        end
        
        isCopyingActive = true
        startCopyBtn.Text = "ايقاف النسخ"
        startCopyBtn.BackgroundColor3 = colorPalette.danger
        
        spamTask = task.spawn(function()
            while isCopyingActive and ScreenGui.Parent do
                local found = false
                for _, player in ipairs(Players:GetPlayers()) do
                    if player.Name == target then found = true; break end
                end
                
                if not found then
                    local newTarget = getActivePlayer()
                    if newTarget then
                        target = newTarget
                        if copyType == "virtual" then targetName = target
                        elseif copyType == "normal" then targetName = target:sub(1, math.min(3, #target))
                        else targetName = target:sub(1, math.min(2, #target)):lower() end
                        activePlayerLabel.Text = "اللاعب النشط: " .. targetName
                    else
                        isCopyingActive = false
                        startCopyBtn.Text = "تفعيل النسخ"
                        startCopyBtn.BackgroundColor3 = colorPalette.accentDark
                        activePlayerLabel.Text = "اللاعب النشط: انتهى الجميع"
                        break
                    end
                end
                
                for _, cmd in ipairs(commandLines) do
                    if not isCopyingActive or not ScreenGui.Parent then break end
                    local finalCmd = formatCommandForTarget(cmd, targetName)
                    executeCommand(finalCmd)
                    task.wait(0.001)
                end
            end
        end)
    else
        local players = getGamedPlayers()
        if #players == 0 then
            startCopyBtn.Text = "اختر لاعبين!"
            task.wait(1)
            startCopyBtn.Text = "تفعيل النسخ"
            return
        end
        
        local gamedTargets = getGamedTargets(players)
        activePlayerLabel.Text = "غامض: " .. gamedTargets
        
        local commandLines = {}
        for line in commandsTextBox.Text:gmatch("[^\r\n]+") do
            if line ~= "" then table.insert(commandLines, line) end
        end
        
        isCopyingActive = true
        startCopyBtn.Text = "ايقاف النسخ"
        startCopyBtn.BackgroundColor3 = colorPalette.danger
        
        spamTask = task.spawn(function()
            while isCopyingActive and ScreenGui.Parent do
                local currentPlayers = getGamedPlayers()
                if #currentPlayers == 0 then
                    isCopyingActive = false
                    startCopyBtn.Text = "تفعيل النسخ"
                    startCopyBtn.BackgroundColor3 = colorPalette.accentDark
                    activePlayerLabel.Text = "انتهى الجميع"
                    break
                end
                
                local currentTargets = getGamedTargets(currentPlayers)
                for _, cmd in ipairs(commandLines) do
                    if not isCopyingActive or not ScreenGui.Parent then break end
                    local finalCmd = formatCommandForTarget(cmd, currentTargets)
                    executeCommand(finalCmd)
                    task.wait(0.001)
                end
            end
        end)
    end
end

local function stopAll()
    isCopyingActive = false
    if spamTask then
        task.cancel(spamTask)
        spamTask = nil
    end
    startCopyBtn.Text = "تفعيل النسخ"
    startCopyBtn.BackgroundColor3 = colorPalette.accentDark
    activePlayerLabel.Text = "اللاعب النشط: متوقف"
end

startCopyBtn.MouseButton1Click:Connect(function()
    if isCopyingActive then stopAll() else startCopy() end
end)

