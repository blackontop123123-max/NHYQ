-- ==================== LOGIC & DISPLAY FUNCTIONS ====================
local selectedTabIndex = nil
local tabButtons = {}

local function getGamedTargets(players)
    if #players == 0 then return "" end
    local names = {}
    for _, p in ipairs(players) do
        table.insert(names, p:sub(1, math.min(2, #p)):lower())
    end
    return table.concat(names, ",")
end

local function getActivePlayer()
    for name in pairs(selectedPlayers) do
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Name == name then
                return name
            end
        end
    end
    return nil
end

local function getGamedPlayers()
    local result = {}
    for name in pairs(selectedPlayers) do
        table.insert(result, name)
    end
    return result
end

local function updateSelectedLabel()
    local count = 0
    for _ in pairs(selectedPlayers) do count = count + 1 end
    if count == 0 then
        selectedPlayersLabel.Text = "لا يوجد مختارين"
    elseif count == 1 then
        local name = next(selectedPlayers)
        selectedPlayersLabel.Text = "مختار: " .. name
    else
        selectedPlayersLabel.Text = count .. " مختارين"
    end
end

local function refreshSavedPlayers()
    for _, child in pairs(savedPlayersScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local y = 0
    for name in pairs(savedPlayers) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -5, 0, 20)
        btn.Position = UDim2.new(0, 2, 0, y * 22 + 2)
        btn.BackgroundColor3 = colorPalette.accentDark
        btn.Text = name
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 10
        btn.Parent = savedPlayersScroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        
        btn.MouseButton1Click:Connect(function()
            selectedPlayers[name] = true
            refreshCurrentPlayers()
            updateSelectedLabel()
        end)
        
        btn.MouseButton2Click:Connect(function()
            savedPlayers[name] = nil
            savePlayers()
            refreshSavedPlayers()
        end)
        
        y = y + 1
    end
    savedPlayersScroll.CanvasSize = UDim2.new(0, 0, 0, y * 22 + 5)
end

-- دالة عرض قائمة اللاعبين الحالية (تم تعديلها وتصحيحها)
local function refreshCurrentPlayers()
    for _, child in pairs(currentPlayersScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local y = 0
    local allPlayers = Players:GetPlayers()
    
    for _, player in ipairs(allPlayers) do
        if player ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -5, 0, 20)
            btn.Position = UDim2.new(0, 2, 0, y * 22 + 2)
            
            if selectedPlayers[player.Name] then
                btn.BackgroundColor3 = colorPalette.accentDark
                btn.Text = "✓ " .. player.Name
            else
                btn.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
                btn.Text = player.Name
            end
            
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 10
            btn.Parent = currentPlayersScroll
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            
            btn.MouseButton1Click:Connect(function()
                if selectedPlayers[player.Name] then
                    selectedPlayers[player.Name] = nil
                else
                    selectedPlayers[player.Name] = true
                end
                refreshCurrentPlayers()
                updateSelectedLabel()
            end)
            y = y + 1
        end
    end
    currentPlayersScroll.CanvasSize = UDim2.new(0, 0, 0, y * 22 + 5)
end

local function cleanSelectedPlayers()
    local toRemove = {}
    for name in pairs(selectedPlayers) do
        local found = false
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Name == name then
                found = true
                break
            end
        end
        if not found then table.insert(toRemove, name) end
    end
    for _, name in ipairs(toRemove) do selectedPlayers[name] = nil end
    updateSelectedLabel()
end

local function refreshTabs()
    for _, btn in ipairs(tabButtons) do btn:Destroy() end
    tabButtons = {}
    selectedTabIndex = nil
    
    local colors = {
        Color3.fromRGB(150, 50, 50),
        Color3.fromRGB(150, 80, 50),
        Color3.fromRGB(150, 120, 50),
        Color3.fromRGB(120, 50, 150),
        Color3.fromRGB(150, 50, 120),
        Color3.fromRGB(80, 50, 150),
        Color3.fromRGB(150, 50, 80),
        Color3.fromRGB(50, 120, 150),
        Color3.fromRGB(100, 50, 150),
        Color3.fromRGB(150, 50, 50)
    }
    
    for i = 1, #copyPresets do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 95, 0, 28)
        btn.BackgroundColor3 = colors[i] or colorPalette.accentDark
        btn.Text = copyPresets[i].name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 8
        btn.Parent = tabsScrollFrame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
        
        local index = i
        btn.MouseButton1Click:Connect(function()
            commandsTextBox.Text = copyPresets[index].commands
            selectedTabIndex = index
        end)
        table.insert(tabButtons, btn)
    end
    
    for i, tab in ipairs(customTabs) do
        local combinedIndex = #copyPresets + i
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 95, 0, 28)
        btn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
        btn.Text = tab.name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 8
        btn.Parent = tabsScrollFrame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
        
        local deleteBtn = Instance.new("TextButton")
        deleteBtn.Size = UDim2.new(0, 16, 0, 16)
        deleteBtn.Position = UDim2.new(1, -18, 0, 6)
        deleteBtn.BackgroundColor3 = colorPalette.danger
        deleteBtn.Text = "×"
        deleteBtn.TextColor3 = Color3.new(1, 1, 1)
        deleteBtn.Font = Enum.Font.GothamBold
        deleteBtn.TextSize = 10
        deleteBtn.Parent = btn
        Instance.new("UICorner", deleteBtn).CornerRadius = UDim.new(0, 4)
        
        local idx = i
        deleteBtn.MouseButton1Click:Connect(function()
            table.remove(customTabs, idx)
            refreshTabs()
        end)
        
        btn.MouseButton1Click:Connect(function()
            commandsTextBox.Text = tab.commands
            selectedTabIndex = combinedIndex
        end)
        table.insert(tabButtons, btn)
    end
end

