local function updateCopySettingsUi()
    if copyType == "virtual" then
        virtualCopyBtn.BackgroundColor3 = colorPalette.accentDark
        virtualCopyBtn.TextColor3 = Color3.new(1, 1, 1)
        normalCopyBtn.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
        normalCopyBtn.TextColor3 = colorPalette.text
        gamedCopyBtn.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
        gamedCopyBtn.TextColor3 = colorPalette.text
        isGamedMode = false
    elseif copyType == "normal" then
        normalCopyBtn.BackgroundColor3 = colorPalette.accentDark
        normalCopyBtn.TextColor3 = Color3.new(1, 1, 1)
        virtualCopyBtn.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
        virtualCopyBtn.TextColor3 = colorPalette.text
        gamedCopyBtn.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
        gamedCopyBtn.TextColor3 = colorPalette.text
        isGamedMode = false
    elseif copyType == "gamed" then
        gamedCopyBtn.BackgroundColor3 = colorPalette.accentDark
        gamedCopyBtn.TextColor3 = Color3.new(1, 1, 1)
        virtualCopyBtn.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
        virtualCopyBtn.TextColor3 = colorPalette.text
        normalCopyBtn.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
        normalCopyBtn.TextColor3 = colorPalette.text
        isGamedMode = true
    end
    
    hiddenModeBtn.BackgroundColor3 = isHiddenMode and colorPalette.purple or Color3.fromRGB(60, 25, 25)
    hiddenModeBtn.Text = isHiddenMode and "مخفي: ON" or "مخفي: OFF"
    hiddenModeBtn.TextColor3 = isHiddenMode and Color3.new(1, 1, 1) or colorPalette.text
    
    secondExecBtn.BackgroundColor3 = isSecondExecutionMode and colorPalette.accentDark or Color3.fromRGB(60, 25, 25)
    secondExecBtn.Text = isSecondExecutionMode and "وضع التنفيذ الثاني: ON" or "وضع التنفيذ الثاني: OFF"
    secondExecBtn.TextColor3 = isSecondExecutionMode and Color3.new(1, 1, 1) or colorPalette.text
    
    infiniteCopyBtn.BackgroundColor3 = isInfiniteCopy and colorPalette.accentDark or Color3.fromRGB(60, 25, 25)
    infiniteCopyBtn.Text = isInfiniteCopy and "النسخ اللا نهائي: ON" or "النسخ اللا نهائي: OFF"
    infiniteCopyBtn.TextColor3 = isInfiniteCopy and Color3.new(1, 1, 1) or colorPalette.text
end

